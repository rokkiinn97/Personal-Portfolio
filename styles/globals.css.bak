@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{--ink:#101113;--paper:#F5F2EA;--paper2:#EAE6DD;--soft:#D8D3C9;--blue:#2457FF;--blue2:#7B95FF;--navy:#0D1530;--muted:#70726C;--line:#CDC8BE;--dark:#11141b;--darkline:#343945;--white:#f7f5ee}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,Arial,sans-serif}a{color:inherit;text-decoration:none}::selection{background:var(--blue);color:#fff}.nav{position:fixed;z-index:50;top:0;left:0;right:0;height:68px;padding:0 3.5vw;display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;background:rgba(243,240,232,.84);backdrop-filter:blur(18px);border-bottom:1px solid rgba(16,17,19,.1);font:9px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em}.brand{font:800 21px Manrope;letter-spacing:-.09em}.brand span{color:var(--blue);font-size:.75em;margin-left:3px}.nav-center{text-align:center;color:#6e7069}.nav-links{display:flex;justify-content:flex-end;gap:1.6rem}.nav-links a{position:relative}.nav-links a:after{content:'';position:absolute;left:0;bottom:-5px;width:100%;height:1px;background:var(--blue);transform:scaleX(0);transform-origin:right;transition:transform .3s}.nav-links a:hover:after{transform:scaleX(1);transform-origin:left}.eyebrow,.section-meta,.blue-label,.hero-index,.hero-footer-v6,.hero-actions,.hero-kicker,.hero-mini,.hero-system-note span,.hero-chip,.photo-note,.work-note-v6 span,.proof-head-v6>div>span,.terminal-bar,.chart-top,.chart-axis,.journey-head-v6>div>span,.evolution-meta,.toolkit-head-v6>div>span,.beyond-copy-v6>span,.image-index,.now-v6>span,footer{font:9px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}
/* HERO */
.hero-v6{min-height:100svh;padding:94px 3.5vw 18px;display:flex;flex-direction:column;border-bottom:1px solid var(--line);overflow:hidden}.hero-top{display:flex;justify-content:space-between}.hero-index{color:var(--blue)}.hero-grid-v6{flex:1;display:grid;grid-template-columns:1fr 1fr;gap:5vw;align-items:center;padding:5vh 4vw 3vh 6vw}.hero-copy-v6{max-width:780px}.hero-mini{display:flex;align-items:center;gap:.65rem;color:#666861;margin-bottom:1.8rem}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px rgba(36,87,255,.09)}.hero-title{font-size:clamp(6rem,10.7vw,12rem);line-height:.76;letter-spacing:-.12em;margin:0;overflow:hidden}.hero-title .hero-line{display:block}.hero-title em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.hero-lead{font-size:1rem;line-height:1.65;max-width:540px;margin:2.5rem 0 1.6rem;color:#5b5d56}.hero-lead strong{color:var(--ink)}.hero-actions{display:flex;gap:1.5rem;align-items:center;flex-wrap:wrap;color:#696b64}.hero-actions a{color:var(--blue);font-weight:600}.hero-actions a span{display:inline-block;margin-left:.4rem;transition:transform .25s}.hero-actions a:hover span{transform:translate(3px,-3px)}.hero-system{position:relative;max-width:650px;width:100%;justify-self:end}.search-console{height:min(58vh,570px);min-height:450px;background:#10131a;color:#eef1f6;position:relative;overflow:hidden;border:1px solid #242b3a;box-shadow:18px 18px 0 rgba(36,87,255,.1)}.console-top,.console-footer{position:absolute;left:1.2rem;right:1.2rem;display:flex;justify-content:space-between;font:8px 'DM Mono';letter-spacing:.08em;color:#737c8e}.console-top{top:1.2rem}.console-query{position:absolute;top:20%;left:8%;right:8%;display:flex;gap:.9rem;align-items:center;border-bottom:1px solid #333b4d;padding-bottom:1rem}.console-prompt{font:8px 'DM Mono';color:var(--blue2)}.console-query strong{font-size:1rem;letter-spacing:-.03em}.cursor-block{width:8px;height:14px;background:var(--blue);animation:blink 1s steps(1) infinite}.console-map{position:absolute;left:7%;right:7%;top:32%;bottom:16%;overflow:hidden;background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);background-size:80px 80px}.console-axis{position:absolute;background:#293246}.console-axis.x{left:5%;right:5%;top:65%;height:1px}.console-axis.y{top:8%;bottom:8%;left:50%;width:1px}.console-lines{position:absolute;inset:0;width:100%;height:100%}.console-lines path{fill:none;stroke:#53617a;stroke-width:1.2;stroke-dasharray:5 7}.console-node{position:absolute;display:flex;flex-direction:column;gap:.2rem;background:#151b27;border:1px solid #354055;padding:.55rem .65rem;min-width:88px}.console-node b{font:8px 'DM Mono';color:var(--blue2)}.console-node span{font:8px 'DM Mono';letter-spacing:.05em}.console-node.n1{left:4%;top:67%}.console-node.n2{left:39%;top:17%}.console-node.n3{right:4%;top:30%}.console-node.n4{right:12%;bottom:5%}.scanner-beam{position:absolute;left:-25%;top:0;width:10%;height:100%;background:linear-gradient(90deg,transparent,rgba(36,87,255,.55),transparent);filter:blur(3px);transform:skewX(-12deg)}.console-footer{bottom:1.1rem}.hero-console-grid{background-position:0 0}.hero-chip{position:absolute;background:var(--paper);border:1px solid var(--line);padding:.65rem .75rem;box-shadow:7px 7px 0 rgba(16,17,19,.08);z-index:2}.hero-chip b{color:var(--blue);margin-left:.6rem}.chip-a{left:-3%;top:12%}.chip-b{right:-4%;top:53%;background:var(--blue);border-color:var(--blue);color:#fff}.chip-b b{color:#fff}.chip-c{left:7%;bottom:10%}.hero-system-note{display:grid;grid-template-columns:28px 1fr;gap:.8rem;margin:1rem 0 0 auto;max-width:430px;color:#676a62}.hero-system-note p{font-size:.72rem;line-height:1.55;margin:0}.hero-system-note span{color:var(--blue)}.hero-footer-v6{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:12px;color:#74766f}
/* MANIFESTO */
.manifesto-v6{background:var(--ink);color:var(--white);min-height:88svh;padding:6.5vw 6vw 2.5vw;display:flex;flex-direction:column}.section-meta{display:flex;justify-content:space-between;color:#777b82}.manifesto-grid-v6{margin:auto 0;display:grid;grid-template-columns:.3fr 1.25fr .55fr;gap:5vw;align-items:end}.manifesto-stamp{align-self:start;border:1px solid #35383f;padding:1rem;width:125px;font:8px 'DM Mono';line-height:1.6;color:#777b82}.manifesto-stamp span{color:var(--blue2)}.manifesto-kicker{font-size:1rem;color:#92969d;margin:0 0 1rem}.manifesto-grid-v6 h2{font-size:clamp(5rem,9.2vw,10rem);line-height:.77;letter-spacing:-.12em;margin:0}.manifesto-grid-v6 h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.manifesto-note{border-left:1px solid #363941;padding-left:1.5rem}.manifesto-note>span{font:8px 'DM Mono';color:var(--blue2)}.manifesto-note p{max-width:320px;color:#9398a2;font-size:.78rem;line-height:1.7}.tiny-signal{display:flex;gap:4px;align-items:end;margin-top:2rem}.tiny-signal i{display:block;width:5px;background:var(--blue);height:var(--h)}.tiny-signal i:nth-child(1){--h:10px}.tiny-signal i:nth-child(2){--h:18px}.tiny-signal i:nth-child(3){--h:14px}.tiny-signal i:nth-child(4){--h:28px}.tiny-signal i:nth-child(5){--h:40px}.manifesto-bottom-v6{display:grid;grid-template-columns:repeat(5,1fr) 40px;border-top:1px solid #33363e;padding-top:1rem;color:#777b82;font:9px 'DM Mono';letter-spacing:.08em}.manifesto-bottom-v6 b{color:var(--blue2);text-align:right}
/* APPROACH */
.approach-v6{padding:6.5vw 6vw;background:var(--navy);color:#f4f5f8;position:relative;overflow:hidden}.approach-head-v6{display:grid;grid-template-columns:1fr .45fr;gap:8vw;align-items:end}.approach-head-v6 h2,.work-head-v6 h2,.journey-head-v6 h2,.evolution-head-v6 h2,.toolkit-head-v6 h2,.beyond-copy-v6 h2,.now-grid-v6 h2{font-size:clamp(4.7rem,8vw,9rem);line-height:.77;letter-spacing:-.12em;margin:2.4rem 0 0}.approach-head-v6 h2 em,.work-head-v6 h2 em,.journey-head-v6 h2 em,.evolution-head-v6 h2 em,.toolkit-head-v6 h2 em,.beyond-copy-v6 h2 em,.now-grid-v6 h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.blue-label{color:#7590ff}.approach-head-v6>p{color:#9aa2b1;line-height:1.7;font-size:.8rem;max-width:430px;margin:0}.signal-system-v6{margin-top:6rem;border:1px solid #323b50;display:grid;grid-template-columns:repeat(5,1fr);position:relative}.signal-path{position:absolute;left:8%;right:8%;top:44%;height:1px;background:#39455d;z-index:0}.path-beam{display:block;width:17%;height:2px;background:var(--blue);box-shadow:0 0 18px rgba(36,87,255,.9);animation:pathmove 3s infinite ease-in-out}.signal-node{min-height:330px;padding:1.2rem 1.2rem 1.5rem;display:flex;flex-direction:column;justify-content:flex-end;border-right:1px solid #323b50;position:relative;z-index:1;background:linear-gradient(180deg,transparent,rgba(13,21,48,.22))}.signal-node:last-child{border-right:0}.signal-node>span{font:8px 'DM Mono';color:#7188e9;position:absolute;top:1.2rem}.node-icon{width:38px;height:38px;border:1px solid #43506a;display:grid;place-items:center;color:#7590ff;margin-bottom:auto}.signal-node strong{font-size:1.2rem;letter-spacing:-.05em}.signal-node small{font:8px 'DM Mono';color:#8e96a5;margin-top:.45rem;text-transform:uppercase}
/* WORK */
.work-v6{padding:7.5vw 6vw;background:var(--paper)}.work-head-v6{display:grid;grid-template-columns:1fr .45fr;gap:8vw;align-items:end}.work-intro{display:flex;gap:2rem;align-items:end}.work-count{font-size:4rem;line-height:.8;letter-spacing:-.1em;white-space:nowrap}.work-count span{display:block;font:8px 'DM Mono';letter-spacing:.08em;margin-top:.7rem;color:var(--blue)}.work-intro p{max-width:390px;color:#5e6059;font-size:.8rem;line-height:1.7;margin:0}.projects-v6{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);margin-top:6rem}.project-card-v6{background:#ddd9cf;min-height:640px;display:grid;grid-template-rows:1.05fr .95fr;overflow:hidden;transition:transform .45s ease}.project-card-v6.is-hovered{transform:translateY(-6px);z-index:2}.project-visual-v6{position:relative;overflow:hidden}.project-image-v6{position:absolute;inset:0;background-image:linear-gradient(0deg,#0009,transparent 58%),var(--project-image);background-size:cover;background-position:center;filter:grayscale(.55) saturate(.6);transition:transform .8s ease,filter .8s ease}.project-card-v6.is-hovered .project-image-v6{transform:scale(1.07);filter:grayscale(.05) saturate(1)}.project-overlay-v6{position:absolute;top:1.1rem;left:1.2rem;right:1.2rem;display:flex;justify-content:space-between;color:#fff;font:8px 'DM Mono';letter-spacing:.08em}.project-icon{width:32px;height:32px;border:1px solid rgba(255,255,255,.55);display:grid;place-items:center;font-size:1rem}.project-scan-v6{position:absolute;left:1.2rem;right:1.2rem;bottom:1.1rem;display:flex;align-items:center;gap:.7rem;color:#fff;font:8px 'DM Mono';opacity:0;transform:translateY(10px);transition:.4s}.project-scan-v6 i{height:1px;flex:1;background:rgba(255,255,255,.55)}.project-scan-v6 b{font-size:1rem}.project-card-v6.is-hovered .project-scan-v6{opacity:1;transform:none}.project-copy-v6{padding:1.5rem;display:flex;flex-direction:column}.project-topline-v6,.project-open-v6{font:8px 'DM Mono';text-transform:uppercase;color:#686a62;display:flex;justify-content:space-between;gap:1rem}.project-copy-v6 h3{font-size:clamp(3rem,4.7vw,5rem);line-height:.8;letter-spacing:-.1em;margin:2rem 0 .9rem}.project-copy-v6 p{color:#565851;line-height:1.55;max-width:470px;font-size:.78rem}.tag-row-v6{display:flex;gap:.4rem;flex-wrap:wrap;margin-top:auto}.tag-row-v6 span{font:7px 'DM Mono';border:1px solid #aaa79e;border-radius:999px;padding:.4rem .55rem;text-transform:uppercase}.project-open-v6{border-top:1px solid #aaa79e;padding-top:1rem;margin-top:1rem}.project-open-v6 b{color:var(--blue)}.projects-v6 .project-card-v6:nth-child(3){grid-column:1/-1;grid-template-columns:1.15fr .85fr;grid-template-rows:none;min-height:520px}.projects-v6 .project-card-v6:nth-child(3) .project-copy-v6{order:-1}.work-note-v6{margin-top:4rem;background:var(--blue);color:#fff;padding:1.7rem;display:grid;grid-template-columns:42px 1.2fr .8fr;gap:1.5rem;align-items:center}.note-icon{width:40px;height:40px;border:1px solid rgba(255,255,255,.5);display:grid;place-items:center;font-size:1.1rem}.work-note-v6 span{display:block;opacity:.75;margin-bottom:.45rem}.work-note-v6 strong{display:block;font-size:1.55rem;letter-spacing:-.05em}.work-note-v6 p{margin:0;font-size:.74rem;line-height:1.6}
/* PROOF */
.proof-v6{background:#111827;color:#f3f5f8;padding:9vw 6vw}.proof-head-v6{display:grid;grid-template-columns:1fr auto;align-items:end}.proof-head-v6 h2{font-size:clamp(4.7rem,8vw,9rem);line-height:.77;letter-spacing:-.12em;margin:2.5rem 0 0}.proof-head-v6 h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.proof-stamp{width:125px;height:125px;border:1px solid #384154;border-radius:50%;display:grid;place-items:center;position:relative}.proof-stamp span{position:absolute;top:28px;left:0;right:0;text-align:center;font:8px 'DM Mono';color:#7188e9}.proof-stamp strong{font-size:2rem;font-weight:400}.proof-stamp small{position:absolute;bottom:27px;text-align:center;font:7px 'DM Mono';color:#798294}.proof-layout-v6{display:grid;grid-template-columns:1.08fr .92fr;gap:1px;background:#343d4e;margin-top:6rem}.proof-terminal-v6,.proof-chart{background:#151d2e;padding:1.4rem}.terminal-bar{display:flex;justify-content:space-between;color:#8e96a6;border-bottom:1px solid #353d4d;padding-bottom:1rem}.terminal-line{display:grid;grid-template-columns:34px 125px 1fr;gap:1rem;padding:1.15rem 0;border-bottom:1px solid #2d3441}.terminal-line i,.terminal-line b{font:8px 'DM Mono';font-style:normal}.terminal-line i{color:#7188e9}.terminal-line span{color:#9098a7;font-size:.72rem}.chart-top{display:flex;justify-content:space-between;color:#7188e9}.chart-grid{height:285px;margin:1.6rem 0 0;display:flex;align-items:end;gap:7%;position:relative;border-left:1px solid #343d4e;border-bottom:1px solid #343d4e;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px);background-size:100% 25%}.metric-bar{height:var(--bar);flex:1;background:rgba(36,87,255,.35);transform-origin:bottom}.metric-bar:nth-child(1){--bar:24%}.metric-bar:nth-child(2){--bar:38%}.metric-bar:nth-child(3){--bar:33%}.metric-bar:nth-child(4){--bar:58%}.metric-bar:nth-child(5){--bar:78%}.chart-line{position:absolute;left:0;right:0;bottom:19%;height:1px;background:var(--blue);transform:rotate(-7deg);box-shadow:0 0 14px rgba(36,87,255,.75)}.chart-axis{display:flex;justify-content:space-between;color:#687286}.proof-chart p{color:#8e96a6;line-height:1.7;font-size:.73rem;max-width:430px}
/* CAREER */
.journey-v6{padding:7.5vw 6vw;background:var(--paper)}.journey-head-v6{display:flex;justify-content:space-between;align-items:end;gap:2rem}.journey-head-v6 h2{margin:2rem 0 0}.career-mark{display:flex;align-items:center;gap:1rem;font:8px 'DM Mono';color:#6d7069}.career-mark i{font-style:normal;color:var(--blue);font-size:1rem}.timeline-v6{margin-top:6rem;border-top:1px solid var(--line)}.timeline-item-v6{display:grid;grid-template-columns:120px 55px 1fr 40px;gap:1.5rem;padding:2.5rem 0;border-bottom:1px solid var(--line);align-items:start;transition:padding .35s}.timeline-item-v6:hover{padding-left:1rem;padding-right:1rem}.timeline-date{font:9px 'DM Mono';color:#777970;padding-top:.45rem}.timeline-node{height:100%;position:relative;display:flex;justify-content:center}.timeline-node span{width:30px;height:30px;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center;font:8px 'DM Mono';background:var(--paper);z-index:2}.timeline-node i{position:absolute;top:30px;bottom:-2.5rem;width:1px;background:var(--line)}.timeline-item-v6:last-child .timeline-node i{display:none}.timeline-copy>span{font:8px 'DM Mono';color:var(--blue);text-transform:uppercase}.timeline-copy h3{font-size:clamp(2.7rem,4.8vw,5.2rem);line-height:.82;letter-spacing:-.1em;margin:.7rem 0 .55rem}.timeline-copy b{font:8px 'DM Mono';text-transform:uppercase;color:#6b6d66}.timeline-copy p{max-width:600px;color:#62645d;font-size:.78rem;line-height:1.65;margin:.9rem 0 0}.timeline-arrow{color:var(--blue);font-size:1.2rem}
/* TOOLKIT */
.toolkit-v6{padding:7.5vw 6vw;background:#f7f6f1}.toolkit-head-v6{display:grid;grid-template-columns:1fr auto;gap:5vw;align-items:end}.toolkit-head-v6 h2{margin:2rem 0 0}.toolkit-orbit{width:150px;height:150px;position:relative;border:1px solid var(--line);border-radius:50%;display:grid;place-items:center}.toolkit-orbit div{position:absolute;border:1px solid var(--line);border-radius:50%}.toolkit-orbit div:first-child{inset:20%}.toolkit-orbit div:nth-child(2){inset:38%}.toolkit-orbit span{font:9px 'DM Mono';color:var(--blue)}.toolkit-list-v6{margin-top:4.5rem;border-top:1px solid var(--line)}.toolkit-list-v6>div{display:grid;grid-template-columns:45px 44px 220px 1fr 30px;gap:1.5rem;padding:1.5rem 0;border-bottom:1px solid var(--line);align-items:center;transition:background .3s,padding .3s}.toolkit-list-v6>div:hover{background:#eeece5;padding-left:1rem;padding-right:1rem}.tool-number{font:8px 'DM Mono';color:var(--blue)}.tool-icon{width:38px;height:38px;border:1px solid var(--line);display:grid;place-items:center}.toolkit-list-v6 h3{margin:0;font-size:1.7rem;letter-spacing:-.06em}.toolkit-list-v6 p{font:9px 'DM Mono';color:#64665f;margin:0;line-height:1.8}.toolkit-list-v6 b{color:var(--blue);font-size:1rem}
/* BEYOND */
.beyond-v6{background:#dcd8ce;display:grid;grid-template-columns:1.05fr .95fr;min-height:84vh}.beyond-image-v6{min-height:650px;position:relative;overflow:hidden}.beyond-photo-v6{height:100%;min-height:650px;background:linear-gradient(135deg,rgba(36,87,255,.12),transparent),url('https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1800&q=85') center/cover;filter:grayscale(.38);transition:transform 1s}.beyond-image-v6:hover .beyond-photo-v6{transform:scale(1.04)}.image-index{position:absolute;top:1.3rem;left:1.3rem;color:#fff;text-shadow:0 1px 8px #0008}.image-crosshair{position:absolute;right:1.5rem;bottom:1.2rem;width:45px;height:45px;border:1px solid rgba(255,255,255,.7);color:#fff;display:grid;place-items:center;font-size:1.4rem}.beyond-copy-v6{padding:6.5vw 7vw;align-self:center}.beyond-copy-v6 h2{margin:2.5rem 0}.beyond-copy-v6 p{max-width:480px;line-height:1.7;color:#555750;font-size:.8rem}.tags{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:2rem}.tags span{font:8px 'DM Mono';border:1px solid #aaa79e;padding:.45rem .6rem}
/* NOW */
.now-v6{padding:7.5vw 6vw;background:var(--paper)}.now-grid-v6{display:grid;grid-template-columns:.85fr 1fr;gap:7vw;align-items:center;margin-top:4rem}.now-grid-v6 h2{margin:0}.now-grid-v6 p{max-width:430px;line-height:1.75;align-self:end;color:#555750;font-size:.8rem}.now-visual{height:360px;background:#111827;position:relative;overflow:hidden;border:1px solid #242b3a}.now-window{position:absolute;left:13%;right:13%;top:22%;bottom:22%;border:1px solid #394256;display:grid;grid-template-columns:1fr auto 1fr;grid-template-rows:1fr 1fr;align-items:center;padding:1rem 1.4rem;color:#e8ecf4}.now-window span{grid-column:1/-1;font:8px 'DM Mono';color:#7188e9;align-self:start}.now-window strong,.now-window b{font-size:1rem;letter-spacing:-.04em}.now-window i{font-style:normal;color:var(--blue);font-size:1.5rem;text-align:center}.now-pulse{position:absolute;left:15%;right:15%;top:50%;height:1px;background:var(--blue);box-shadow:0 0 22px rgba(36,87,255,.8);animation:pulsewidth 2.4s infinite ease-in-out}
/* CONTACT */
.contact-v6{min-height:94svh;background:#0d0e12;color:#fff;padding:7vw 6vw 1.5rem;position:relative;overflow:hidden;display:flex;flex-direction:column}.contact-grid-lines{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:90px 90px;pointer-events:none}.contact-kicker{position:relative;z-index:2;margin-top:4rem;font:8px 'DM Mono';color:#667084;letter-spacing:.08em}.contact-v6 h2{position:relative;z-index:2;font-size:clamp(5.5rem,11vw,13rem);line-height:.73;letter-spacing:-.12em;margin:auto 0 2rem}.contact-v6 h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.contact-v6>p{position:relative;z-index:2;max-width:430px;line-height:1.65;color:#9ca1ad;font-size:.8rem}.contact-link-v6{position:relative;z-index:2;display:flex;justify-content:space-between;max-width:850px;border-bottom:1px solid #353945;padding:1.2rem 0;margin-top:2.5rem;font-size:1.15rem}.contact-link-v6 span{color:#7188e9}.blue-orbit-v6{position:absolute;width:45vw;height:45vw;right:-15vw;top:16%;border:1px solid rgba(36,87,255,.48);border-radius:50%;z-index:1}.blue-orbit-v6:before,.blue-orbit-v6:after{content:'';position:absolute;border:1px solid rgba(36,87,255,.25);border-radius:50%;inset:13%}.blue-orbit-v6:after{inset:30%}.blue-orbit-v6 span{position:absolute;width:10px;height:10px;border-radius:50%;background:var(--blue);left:50%;top:-5px;box-shadow:0 0 28px rgba(36,87,255,.9);animation:orbitdot 7s linear infinite}footer{margin-top:auto;padding-top:1.1rem;border-top:1px solid #30333a;display:flex;justify-content:space-between;gap:1rem;color:#777d8c;position:relative;z-index:2}
@keyframes blink{50%{opacity:0}}@keyframes pathmove{0%,100%{transform:translateX(0)}50%{transform:translateX(500%)} }@keyframes pulsewidth{0%,100%{opacity:.35;transform:scaleX(.6)}50%{opacity:1;transform:scaleX(1)}}@keyframes orbitdot{to{transform:rotate(360deg) translateX(22vw) rotate(-360deg)}}
@media(max-width:1000px){.nav{grid-template-columns:1fr auto}.nav-center{display:none}.hero-grid-v6,.approach-head-v6,.work-head-v6,.proof-layout-v6,.evolution-head-v6,.toolkit-head-v6,.beyond-v6,.now-grid-v6{grid-template-columns:1fr}.hero-grid-v6{padding-left:0}.hero-system{justify-self:stretch;max-width:none}.hero-title{font-size:clamp(5.8rem,14vw,9rem)}.search-console{min-height:430px;height:55vh}.hero-chip{display:none}.signal-system-v6{grid-template-columns:repeat(5,190px);overflow:auto}.signal-node{min-height:270px}.projects-v6{grid-template-columns:1fr}.projects-v6 .project-card-v6:nth-child(3){grid-column:auto;grid-template-columns:1fr;grid-template-rows:1.05fr .95fr}.projects-v6 .project-card-v6:nth-child(3) .project-copy-v6{order:initial}.work-intro{justify-content:space-between}.proof-layout-v6{grid-template-columns:1fr}.beyond-image-v6,.beyond-photo-v6{min-height:60vh}.evolution-track-v6{grid-template-columns:1fr;gap:1rem}.evolution-track-v6>i{display:none} .toolkit-list-v6>div{grid-template-columns:40px 44px 180px 1fr 25px}.contact-v6 h2{font-size:clamp(5rem,13vw,9rem)}}
@media(max-width:620px){.nav{height:62px;padding:0 5vw}.nav-links{display:none}.hero-v6{padding:86px 6vw 14px}.hero-grid-v6{gap:3rem;padding:5vh 0 3vh}.hero-title{font-size:clamp(4.6rem,19vw,7rem)}.hero-lead{font-size:.9rem;margin-top:2rem}.hero-actions{font-size:8px}.search-console{height:52vh;min-height:370px}.console-query strong{font-size:.82rem}.console-node{min-width:70px;padding:.45rem}.console-node span{font-size:7px}.hero-system-note{margin-top:.8rem}.hero-footer-v6{flex-direction:column;gap:.8rem}.manifesto-v6,.approach-v6,.work-v6,.proof-v6,.journey-v6,.evolution-v6,.toolkit-v6,.now-v6,.contact-v6{padding:17vw 6vw}.manifesto-grid-v6{grid-template-columns:1fr;gap:2rem}.manifesto-stamp{display:none}.manifesto-grid-v6 h2{font-size:clamp(4.2rem,16.5vw,6.2rem)}.manifesto-note{border-left:0;border-top:1px solid #363941;padding:1.3rem 0 0}.manifesto-bottom-v6{grid-template-columns:1fr 1fr;gap:.7rem}.manifesto-bottom-v6 b{display:none}.approach-head-v6 h2,.work-head-v6 h2,.journey-head-v6 h2,.evolution-head-v6 h2,.toolkit-head-v6 h2,.beyond-copy-v6 h2,.now-grid-v6 h2{font-size:clamp(4rem,16vw,6.2rem)}.signal-system-v6{margin-top:4rem}.work-intro{align-items:start}.work-count{font-size:3rem}.projects-v6{margin-top:4rem}.project-card-v6{min-height:570px}.project-copy-v6 h3{font-size:3.2rem}.work-note-v6{grid-template-columns:40px 1fr}.work-note-v6 p{grid-column:2}.proof-head-v6{grid-template-columns:1fr}.proof-stamp{display:none}.proof-layout-v6{margin-top:4rem}.terminal-line{grid-template-columns:30px 1fr}.terminal-line span{grid-column:2}.timeline-v6{margin-top:4rem}.timeline-item-v6{grid-template-columns:48px 30px 1fr;gap:.7rem}.timeline-arrow{display:none}.timeline-copy h3{font-size:2.8rem}.career-mark{display:none}.evolution-track-v6{margin-top:4rem}.toolkit-orbit{width:100px;height:100px}.toolkit-list-v6{margin-top:4rem}.toolkit-list-v6>div{grid-template-columns:28px 38px 1fr 22px;gap:.7rem}.toolkit-list-v6 p{grid-column:3}.toolkit-list-v6 h3{font-size:1.4rem}.beyond-image-v6,.beyond-photo-v6{min-height:52vh}.beyond-copy-v6{padding:15vw 7vw}.now-grid-v6{gap:3rem;margin-top:3.5rem}.now-visual{height:290px}.contact-v6 h2{font-size:clamp(4.5rem,17vw,7rem)}.blue-orbit-v6{width:72vw;height:72vw;right:-25vw;top:10%}footer{flex-direction:column}}
/* Final Section 02 spacing + hierarchy pass */
@media(min-width:1101px){
  .manifesto-v8{min-height:68svh;padding-top:3vw;padding-bottom:2.3vw}
  .position-v8-grid{padding-top:2.35vw}
  .position-v8-kicker{font-size:13px;margin-bottom:.75rem}
  .position-v8-flow{margin-top:1.8vw}
}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.project-card-v6,.project-image-v6,.beyond-photo-v6,.timeline-item-v6{transition:none}.scanner-beam,.path-beam,.blue-orbit-v6 span,.now-pulse,.cursor-block{animation:none!important}}


/* HERO V7 — editorial identity + interactive search system */
.hero-v7{position:relative;min-height:100svh;background:var(--paper);isolation:isolate}
.hero-v7-grid-bg{position:absolute;inset:0;z-index:-1;opacity:.7;background-image:linear-gradient(rgba(16,17,19,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(16,17,19,.055) 1px,transparent 1px);background-size:105px 105px;mask-image:linear-gradient(to bottom,black 0%,black 72%,transparent 100%);pointer-events:none}
.hero-v7-status,.hero-v7-location{position:absolute;top:96px;font:8px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:#64675f}.hero-v7-status{left:46%;display:flex;gap:.65rem;align-items:center}.hero-v7-status i{width:5px;height:5px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 4px rgba(36,87,255,.09);animation:hero-status 1.8s ease-in-out infinite}.hero-v7-location{right:3.5vw}
.hero-grid-v7{flex:1;display:grid;grid-template-columns:1.02fr .98fr;gap:6vw;align-items:center;padding:9vh 4vw 4vh 8vw;position:relative;z-index:2}.hero-name-block{max-width:760px}.hero-v7-kicker{font:8px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:#666861;margin-bottom:2rem}.hero-name{font-size:clamp(6rem,10.2vw,11.8rem);line-height:.72;letter-spacing:-.12em;margin:0;overflow:hidden}.hero-name span{display:block}.hero-role{font-size:clamp(1rem,1.35vw,1.5rem);letter-spacing:-.055em;margin:2rem 0 .7rem}.hero-meta-line{font:8px 'DM Mono',monospace;letter-spacing:.1em;color:#777970;text-transform:uppercase}.hero-system-v7{max-width:640px;justify-self:end;will-change:transform}.search-console-v7{height:min(52vh,500px);min-height:390px;background:#10131a;border:1px solid #c2c0b8;color:#eef1f6;box-shadow:20px 20px 0 rgba(36,87,255,.09)}.search-console-v7 .console-top{color:#7d8492}.console-search-icon{font:15px Arial;color:#b9c1cf}.console-subquery{position:absolute;top:27%;left:8%;font:7px 'DM Mono';letter-spacing:.08em;color:#606a7e}.hero-signal-map{position:absolute;left:7%;right:7%;top:37%;height:38%;background-image:radial-gradient(circle at 1px 1px,rgba(255,255,255,.16) 1px,transparent 1px);background-size:26px 26px}.hero-signal-line{position:absolute;height:1px;background:#46536b;left:7%;right:7%;top:50%}.hero-signal-line.line-b{top:51%;opacity:.25}.hero-signal-node{position:absolute;width:68px;height:68px;border:1px solid #596276;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#11161f;transition:transform .3s,border-color .3s,background .3s}.hero-signal-node span{font:7px 'DM Mono';letter-spacing:.04em;color:#b9c1cf}.hero-signal-node b{font:6px 'DM Mono';color:#6279c9;margin-top:4px}.hero-signal-node:hover{transform:translateY(-5px);border-color:var(--blue);background:#17203a}.hero-signal-0{left:0;top:25%}.hero-signal-1{left:16%;top:25%}.hero-signal-2{left:32%;top:25%}.hero-signal-3{left:48%;top:25%}.hero-signal-4{left:64%;top:25%}.hero-signal-5{left:80%;top:25%}.hero-signal-6{right:-1%;top:25%;opacity:.62}.hero-signal-dot{position:absolute;left:5%;top:48%;width:8px;height:8px;border-radius:50%;background:var(--blue);box-shadow:0 0 18px rgba(36,87,255,.9)}.search-console-v7 .scanner-beam{left:-18%;width:7%;opacity:.8}.console-signal-label{position:absolute;left:8%;bottom:20%;font:7px 'DM Mono';letter-spacing:.08em;color:#76809a}.hero-v7-float{position:absolute;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase;padding:.7rem .85rem;background:var(--paper);border:1px solid #bbb8ae;box-shadow:6px 6px 0 rgba(16,17,19,.08);z-index:3}.hero-v7-float b{color:var(--blue);margin-left:.5rem}.float-one{left:-4%;top:13%}.float-two{right:-4%;bottom:17%;background:var(--blue);color:#fff;border-color:var(--blue)}.float-two b{color:#fff}.hero-v7-bottom{display:grid;grid-template-columns:1fr auto;gap:4vw;align-items:end;padding:1rem 4vw 1.1rem 12vw}.hero-v7-work-note{display:grid;grid-template-columns:90px minmax(280px,600px);gap:1.3rem;align-items:start;border-top:1px solid var(--line);padding-top:.8rem}.hero-v7-work-note span{font:7px 'DM Mono';letter-spacing:.08em;text-transform:uppercase;color:#6b6d66}.hero-v7-work-note p{font-size:.72rem;line-height:1.6;color:#666861;margin:0}.hero-v7-actions{display:flex;gap:.5rem}.hero-v7-actions a{font:8px 'DM Mono';letter-spacing:.03em;text-transform:uppercase;border:1px solid var(--line);padding:.85rem 1rem;background:rgba(247,246,241,.55);transition:background .25s,color .25s,transform .25s}.hero-v7-actions a:first-child{background:var(--ink);color:#fff;border-color:var(--ink)}.hero-v7-actions a:hover{background:var(--blue);border-color:var(--blue);color:#fff;transform:translateY(-2px)}.hero-v7-actions span{margin-left:.6rem}.hero-v7 .hero-footer-v6{margin-top:.2rem}
@keyframes hero-status{50%{opacity:.35;transform:scale(.8)}}
@media(max-width:1000px){.hero-v7-status{left:auto;right:3.5vw}.hero-v7-location{display:none}.hero-grid-v7{grid-template-columns:1fr;gap:4rem;padding:10vh 5vw 4vh}.hero-name{font-size:clamp(5.8rem,15vw,9rem)}.hero-system-v7{justify-self:stretch;max-width:none}.search-console-v7{height:460px}.hero-v7-bottom{padding-left:5vw}.float-one{left:1%}.float-two{right:1%}}
@media(max-width:620px){.hero-v7{padding-top:62px}.hero-v7-status{top:75px;left:6vw;right:auto}.hero-v7 .hero-top{padding-top:0}.hero-grid-v7{padding:8vh 6vw 4vh;gap:3rem}.hero-name{font-size:clamp(4.7rem,18.5vw,7rem);line-height:.74}.hero-role{font-size:1rem;margin-top:1.6rem}.search-console-v7{height:390px;min-height:360px}.hero-signal-node{width:48px;height:48px}.hero-signal-node span{font-size:5px}.hero-signal-node b{font-size:5px}.hero-signal-0{left:-2%}.hero-signal-1{left:14%}.hero-signal-2{left:30%}.hero-signal-3{left:46%}.hero-signal-4{left:62%}.hero-signal-5{left:78%}.hero-signal-6{display:none}.console-subquery{top:28%;font-size:6px}.console-signal-label{bottom:19%;font-size:6px}.hero-v7-float{font-size:6px;padding:.55rem .65rem}.float-one{top:9%;left:-1%}.float-two{right:-1%;bottom:10%}.hero-v7-bottom{grid-template-columns:1fr;padding:0 6vw 1rem;gap:1rem}.hero-v7-work-note{grid-template-columns:1fr;gap:.5rem}.hero-v7-actions{display:grid;grid-template-columns:1fr 1fr}.hero-v7-actions a{text-align:center;padding:.75rem .55rem;font-size:7px}.hero-v7 .hero-footer-v6{padding-left:0;padding-right:0}.hero-v7-grid-bg{background-size:72px 72px}}


/* HERO V7.1 — tighter scale, live query rail, richer interaction */
.hero-v7{min-height:100svh}
.hero-grid-v7{grid-template-columns:minmax(0,.95fr) minmax(520px,1.05fr);gap:5vw;padding-top:10vh}
.hero-name{font-size:clamp(5.5rem,8.8vw,10.2rem);line-height:.75;letter-spacing:-.115em}
.hero-name-block{max-width:700px}
.hero-query-rail{position:absolute;left:8vw;right:4vw;top:19%;display:grid;grid-template-columns:82px minmax(240px,1fr) minmax(220px,.7fr) auto;gap:18px;align-items:center;z-index:2;color:#777970}
.hero-query-rail>span,.hero-query-rail strong{font:7px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase}
.hero-query-rail strong{color:var(--ink);font-size:8px;letter-spacing:.06em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.query-line{height:1px;background:#cbc7bd;position:relative;display:block;overflow:hidden}
.query-line-fill{position:absolute;left:0;top:0;height:100%;width:100%;background:var(--blue);transform:scaleX(0)}
.hero-query-dot{position:absolute;left:0;top:50%;width:5px;height:5px;border-radius:50%;background:var(--blue);transform:translateY(-50%);box-shadow:0 0 0 4px rgba(36,87,255,.08)}
.hero-system-v7{transform:translateY(1.5vh)}
.hero-v7-float{transition:transform .35s ease,box-shadow .35s ease}
.hero-v7-float:hover{transform:translateY(-4px) rotate(-1deg);box-shadow:9px 9px 0 rgba(16,17,19,.08)}
.float-one{left:-4%;top:10%}
.float-two{right:-4%;bottom:17%}
.float-three{left:10%;bottom:-5%}
.hero-signal-node{animation:signal-node-breathe 3.2s ease-in-out infinite}
.hero-signal-0{animation-delay:0s}.hero-signal-1{animation-delay:.25s}.hero-signal-2{animation-delay:.5s}.hero-signal-3{animation-delay:.75s}.hero-signal-4{animation-delay:1s}.hero-signal-5{animation-delay:1.25s}.hero-signal-6{animation-delay:1.5s}
@keyframes signal-node-breathe{0%,100%{box-shadow:0 0 0 rgba(36,87,255,0);transform:translateY(0)}50%{box-shadow:0 0 0 4px rgba(36,87,255,.07);transform:translateY(-3px)}}
@media(max-width:1000px){.hero-query-rail{left:5vw;right:5vw;top:18%;grid-template-columns:70px minmax(180px,1fr) minmax(130px,.6fr) auto}.hero-grid-v7{grid-template-columns:1fr;gap:4rem;padding-top:12vh}.hero-name{font-size:clamp(5.4rem,13.5vw,8.5rem)}.hero-system-v7{transform:none}.float-three{left:auto;right:10%;bottom:-5%}}
@media(max-width:620px){.hero-query-rail{top:16%;left:6vw;right:6vw;grid-template-columns:1fr auto;gap:.45rem 1rem}.hero-query-rail strong{grid-column:1 / -1;font-size:7px}.query-line{grid-column:1 / -1}.hero-query-rail>span:last-child{grid-column:1 / -1}.hero-grid-v7{padding-top:12vh}.hero-name{font-size:clamp(4.5rem,17.2vw,6.8rem)}.float-three{right:-1%;bottom:8%}}
/* Final Section 02 spacing + hierarchy pass */
@media(min-width:1101px){
  .manifesto-v8{min-height:68svh;padding-top:3vw;padding-bottom:2.3vw}
  .position-v8-grid{padding-top:2.35vw}
  .position-v8-kicker{font-size:13px;margin-bottom:.75rem}
  .position-v8-flow{margin-top:1.8vw}
}

@media(prefers-reduced-motion:reduce){.hero-signal-node{animation:none}.hero-query-dot,.query-line-fill{animation:none!important}}


/* HERO V7.2 — open search network, no dashboard container */
.hero-v7{overflow:hidden}
.hero-v7-grid-bg{opacity:.58;background-size:112px 112px}
.hero-grid-v7{grid-template-columns:minmax(0,.92fr) minmax(560px,1.08fr);gap:4.2vw;padding-top:7vh;align-items:center}
.hero-name-block{max-width:680px}
.hero-name{font-size:clamp(5.15rem,8.05vw,9.45rem);line-height:.76;letter-spacing:-.112em}
.hero-query-rail{top:15.5%;left:8vw;right:4vw;grid-template-columns:82px minmax(240px,1fr) minmax(260px,.8fr) auto;gap:18px}
.hero-system-v7{max-width:700px;justify-self:end;transform:translateY(2vh)}
.search-console-v7{height:min(48vh,470px);min-height:370px;background:transparent;border:0;box-shadow:none;position:relative;color:var(--ink);overflow:visible}
.search-console-v7 .console-top{position:absolute;left:4%;right:4%;top:3%;color:#666861;border-bottom:1px solid var(--line);padding-bottom:.65rem;font:7px 'DM Mono',monospace;letter-spacing:.1em}
.search-console-v7 .console-top span:last-child{color:#8b8d86}
.search-console-v7 .console-query{position:absolute;left:9%;right:7%;top:19%;color:var(--ink);display:flex;align-items:center;gap:.65rem}
.search-console-v7 .console-query strong{font-size:clamp(1.25rem,1.8vw,2rem);letter-spacing:-.05em}
.console-search-icon{color:var(--blue)!important}
.search-console-v7 .cursor-block{width:8px;height:14px;background:var(--blue);animation:cursor-blink 1s steps(1) infinite}
.search-console-v7 .console-subquery{top:29%;left:9%;color:#898b84}
.hero-signal-map{left:7%;right:4%;top:39%;height:34%;background-image:radial-gradient(circle at 1px 1px,rgba(16,17,19,.16) 1px,transparent 1px);background-size:25px 25px;mask-image:linear-gradient(to right,transparent 0,black 6%,black 92%,transparent 100%)}
.hero-signal-line{background:#aaa9a2;left:5%;right:3%}
.hero-signal-line.line-b{opacity:.18}
.hero-signal-node{background:rgba(247,246,241,.88);border-color:#8d8f91;color:var(--ink);width:70px;height:70px;box-shadow:0 0 0 rgba(36,87,255,0)}
.hero-signal-node span{color:#3f4348}
.hero-signal-node b{color:var(--blue)}
.hero-signal-node:hover{background:var(--ink);border-color:var(--blue)}
.hero-signal-node:hover span{color:#fff}
.hero-signal-node:hover b{color:#8ea6ff}
.hero-signal-dot{left:4%;top:48%;width:7px;height:7px}
.search-console-v7 .scanner-beam{left:3%;width:1px;background:var(--blue);box-shadow:0 0 16px rgba(36,87,255,.55);opacity:.85}
.console-signal-label{left:9%;bottom:17%;color:#646861}
.search-console-v7 .console-footer{position:absolute;left:4%;right:4%;bottom:3%;border-top:1px solid var(--line);padding-top:.65rem;color:#73766f;font:7px 'DM Mono',monospace;letter-spacing:.08em}
.hero-v7-float{padding:.52rem .7rem;background:var(--paper);border:0;border-bottom:1px solid #9d9e98;box-shadow:none;color:#555850}
.hero-v7-float:before{content:'';position:absolute;width:4px;height:4px;border-radius:50%;background:var(--blue);right:-7px;top:50%;transform:translateY(-50%)}
.hero-v7-float b{display:none}
.float-one{left:-1%;top:13%}
.float-two{right:0;bottom:19%;background:transparent;color:#555850;border-bottom-color:var(--blue)}
.float-two:before{right:auto;left:-7px}
.float-three{left:14%;bottom:-1%;}
.hero-v7-bottom{padding-top:.6rem}
.hero-v7-work-note{max-width:780px}
.hero-v7-actions{padding-bottom:.1rem}
.hero-v7-actions a{backdrop-filter:blur(4px)}
@keyframes cursor-blink{0%,45%{opacity:1}46%,100%{opacity:0}}
@media(max-width:1000px){
  .hero-grid-v7{grid-template-columns:1fr;gap:3.2rem;padding-top:11vh}
  .hero-name{font-size:clamp(5.2rem,13vw,8.4rem)}
  .hero-system-v7{justify-self:stretch;max-width:760px;transform:none}
  .hero-query-rail{top:17%;grid-template-columns:70px minmax(180px,1fr) minmax(150px,.65fr) auto}
}
@media(max-width:620px){
  .hero-grid-v7{padding-top:11vh}
  .hero-name{font-size:clamp(4.35rem,16.8vw,6.5rem)}
  .search-console-v7{height:350px;min-height:330px}
  .hero-signal-node{width:48px;height:48px}
  .hero-signal-0{left:-1%}.hero-signal-1{left:14%}.hero-signal-2{left:29%}.hero-signal-3{left:44%}.hero-signal-4{left:59%}.hero-signal-5{left:74%}.hero-signal-6{display:none}
  .hero-v7-float{font-size:6px}
  .float-one{left:0;top:9%}.float-two{right:0;bottom:12%}.float-three{left:8%;bottom:-2%}
}


/* V8 — visual QA, typography, background depth, alignment and responsive cleanup */
:root{
  --paper:#eeebe3;
  --paper2:#e4e0d6;
  --soft:#d4cfc4;
  --line:#c4c0b6;
  --ink:#101113;
  --blue:#2457ff;
  --blue2:#718bff;
  --navy:#0d1530;
  --white:#f7f5ee;
}
body{background:var(--paper)}

/* Shared editorial surface: richer paper, restrained grain, less flatness. */
.hero-v6,.work-v6,.journey-v6,.toolkit-v6,.now-v6{position:relative;background-color:var(--paper)}
.hero-v6:before,.work-v6:before,.journey-v6:before,.toolkit-v6:before,.now-v6:before{
  content:'';position:absolute;inset:0;pointer-events:none;opacity:.34;mix-blend-mode:multiply;
  background-image:radial-gradient(rgba(16,17,19,.075) .55px,transparent .55px),radial-gradient(rgba(255,255,255,.42) .55px,transparent .55px);
  background-size:17px 17px,23px 23px;background-position:0 0,7px 11px;
}
.hero-v6>*:not(.hero-v7-grid-bg):not(.hero-meta-band),.work-v6>* , .journey-v6>* , .toolkit-v6>* , .now-v6>*{position:relative;z-index:1}

/* Navigation */
.nav{background:rgba(238,235,227,.82);border-bottom-color:rgba(16,17,19,.13)}
.nav-center{color:#5f625c;font-size:8px}
.nav-links{gap:1.45rem}
.nav-links a{transition:color .25s}
.nav-links a:hover{color:var(--blue)}

/* HERO: tighten composition and make the system an open graphic, not a card. */
.hero-v7{min-height:100svh;padding-bottom:16px;background:
  radial-gradient(circle at 72% 42%,rgba(36,87,255,.055),transparent 24%),
  linear-gradient(rgba(16,17,19,.025) 1px,transparent 1px),
  linear-gradient(90deg,rgba(16,17,19,.025) 1px,transparent 1px),var(--paper)}
.hero-v7-grid-bg{opacity:.42;background-size:112px 112px}
.hero-top{padding-top:0}
.hero-v7-status{top:76px}
.hero-v7-location{top:76px}
.hero-query-rail{top:14.2%;left:8vw;right:8vw;grid-template-columns:72px minmax(220px,330px) minmax(120px,1fr) auto;gap:16px}
.hero-query-rail>span,.hero-query-rail strong{font-size:7px}
.hero-query-rail strong{font-size:8px}
.query-line{background:#c1bdb3}
.hero-grid-v7{grid-template-columns:minmax(0,.9fr) minmax(500px,1.1fr);gap:3.4vw;padding:7.2vh 4vw 2.2vh 6vw;align-items:center}
.hero-name-block{max-width:650px}
.hero-name{font-size:clamp(4.95rem,7.45vw,8.9rem);line-height:.78;letter-spacing:-.108em}
.hero-v7-kicker{font-size:7px;margin-bottom:.7rem}
.hero-role{font-size:clamp(1.05rem,1.45vw,1.55rem);letter-spacing:-.055em;margin-top:1.45rem;white-space:nowrap}
.hero-meta-line{font-size:7px;letter-spacing:.1em;color:#6b6e67;margin-top:.7rem}
.hero-system-v7{max-width:680px;justify-self:end;transform:translateY(1vh)}
.search-console-v7{height:min(43vh,420px);min-height:350px}
.search-console-v7 .console-top{left:3%;right:3%;top:1%;padding-bottom:.55rem;font-size:7px}
.search-console-v7 .console-query{left:7%;right:6%;top:17%;gap:.55rem}
.search-console-v7 .console-query strong{font-size:clamp(1.15rem,1.65vw,1.75rem)}
.search-console-v7 .console-subquery{top:27%;left:7%;font-size:6px}
.hero-signal-map{left:5%;right:2%;top:38%;height:36%;background-size:22px 22px}
.hero-signal-line{left:4%;right:2%}
.hero-signal-node{width:62px;height:62px}
.hero-signal-node span{font-size:6px;letter-spacing:.02em}
.hero-signal-node b{font-size:6px}
.hero-signal-dot{left:3%;width:6px;height:6px}
.search-console-v7 .scanner-beam{opacity:.6}
.console-signal-label{left:7%;bottom:16%;font-size:6px}
.search-console-v7 .console-footer{left:3%;right:3%;bottom:1%;font-size:6px}
.hero-v7-float{font-size:7px;padding:.35rem .5rem;background:transparent;border-bottom:1px solid #9c9d97;color:#535750;box-shadow:none}
.hero-v7-float:before{width:3px;height:3px;right:-6px}
.float-one{left:-1%;top:12%}
.float-two{right:-1%;bottom:18%;border-bottom-color:var(--blue)}
.float-two:before{left:-6px;right:auto}
.float-three{left:12%;bottom:-1%}
.hero-v7-bottom{grid-template-columns:minmax(0,1fr) auto;gap:3vw;padding:0 4vw 1rem 15.5vw;align-items:end}
.hero-v7-work-note{grid-template-columns:70px minmax(260px,600px);gap:1.1rem;max-width:720px;padding-top:.7rem}
.hero-v7-work-note p{font-size:.7rem;line-height:1.55}
.hero-v7-actions a{font-size:7px;padding:.75rem .9rem}
.hero-footer-v6{font-size:7px;padding-top:9px}

/* More differentiated section hierarchy: fewer giant headlines, more visual room for objects. */
.manifesto-v6{min-height:86svh;padding:7vw 6vw 3vw}
.manifesto-grid-v6{grid-template-columns:.24fr 1.05fr .55fr;gap:4vw}
.manifesto-grid-v6 h2{font-size:clamp(4.35rem,7.2vw,8rem);line-height:.8}
.manifesto-kicker{font-size:.92rem}
.manifesto-note p{font-size:.76rem}

.approach-v6{padding:7.5vw 6vw;background:
  radial-gradient(circle at 75% 30%,rgba(36,87,255,.12),transparent 26%),
  linear-gradient(135deg,#0d1530 0%,#101a39 100%)}
.approach-head-v6{grid-template-columns:1fr .42fr;gap:7vw}
.approach-head-v6 h2,.work-head-v6 h2,.journey-head-v6 h2,.evolution-head-v6 h2,.toolkit-head-v6 h2,.beyond-copy-v6 h2,.now-grid-v6 h2{font-size:clamp(4.1rem,6.8vw,7.5rem);line-height:.8}
.signal-system-v6{margin-top:5rem;background:rgba(5,10,26,.16)}
.signal-node{min-height:300px}
.node-icon{transition:transform .35s,border-color .35s,background .35s}
.signal-node:hover .node-icon{transform:translateY(-5px) rotate(-3deg);border-color:var(--blue);background:rgba(36,87,255,.08)}

.work-v6{padding:8vw 6vw;background:
  radial-gradient(circle at 20% 15%,rgba(36,87,255,.035),transparent 25%),var(--paper)}
.work-head-v6{grid-template-columns:1fr .42fr;gap:7vw}
.work-head-v6 h2{max-width:780px}
.work-intro{gap:1.5rem}
.work-count{font-size:3.4rem}
.work-intro p{font-size:.76rem}
.projects-v6{margin-top:5rem}
.project-copy-v6 h3{font-size:clamp(2.6rem,4vw,4.3rem)}
.work-note-v6{background:rgba(255,255,255,.2)}

.proof-v6{padding:8vw 6vw;background:
  radial-gradient(circle at 82% 18%,rgba(36,87,255,.13),transparent 25%),
  linear-gradient(135deg,#111827,#0d1423);}
.proof-head-v6 h2{font-size:clamp(4.1rem,6.8vw,7.5rem);line-height:.8}
.proof-layout-v6{margin-top:5rem}

.journey-v6{padding:8vw 6vw;background:
  radial-gradient(circle at 70% 15%,rgba(36,87,255,.045),transparent 24%),var(--paper)}
.journey-head-v6 h2{max-width:800px}
.timeline-v6{margin-top:5rem}
.timeline-copy h3{font-size:clamp(2.35rem,4vw,4.5rem)}

.toolkit-v6{padding:8vw 6vw;background:
  radial-gradient(circle at 18% 20%,rgba(36,87,255,.04),transparent 22%),#f2efe7}
.toolkit-head-v6 h2{font-size:clamp(4.1rem,6.8vw,7.5rem)}
.toolkit-list-v6{margin-top:5rem}
.toolkit-list-v6>div{transition:background .3s,padding .3s,transform .3s}
.toolkit-list-v6>div:hover{transform:translateX(5px)}
.tool-icon{transition:transform .3s,border-color .3s}
.toolkit-list-v6>div:hover .tool-icon{transform:rotate(-5deg);border-color:var(--blue)}

.beyond-v6{background:#d9d5ca;position:relative}
.beyond-v6:after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 65% 45%,rgba(36,87,255,.08),transparent 28%)}
.beyond-copy-v6 h2{font-size:clamp(4.1rem,6.8vw,7.5rem)}

.now-v6{padding:8vw 6vw;background:
  radial-gradient(circle at 78% 40%,rgba(36,87,255,.05),transparent 25%),var(--paper)}
.now-grid-v6{margin-top:4.5rem}
.now-grid-v6 h2{font-size:clamp(4.1rem,6.8vw,7.5rem)}
.now-visual{background:linear-gradient(145deg,#111827,#0c1425);border-color:#2a3449;box-shadow:12px 12px 0 rgba(36,87,255,.07)}

.contact-v6{background:
  radial-gradient(circle at 78% 30%,rgba(36,87,255,.15),transparent 26%),
  linear-gradient(145deg,#0d1119,#10182c)}
.contact-v6 h2{font-size:clamp(4.6rem,7.8vw,8.6rem)}

/* Labels should be readable without becoming oversized. */
.section-meta,.blue-label,.hero-index,.hero-footer-v6,.hero-kicker,.hero-v7-status,.hero-v7-location,.hero-v7-work-note span,.hero-v7-float,.hero-query-rail,.timeline-date,.career-mark,.evolution-meta,.toolkit-head-v6>div>span,.beyond-copy-v6>span,.image-index,.now-v6>span,footer{font-size:8px}

/* Responsive collision prevention */
@media(max-width:1200px){
  .hero-grid-v7{grid-template-columns:minmax(0,.88fr) minmax(450px,1.12fr);gap:2vw}
  .hero-name{font-size:clamp(4.7rem,7.2vw,7.8rem)}
  .hero-v7-bottom{padding-left:10vw}
  .hero-query-rail{grid-template-columns:65px minmax(180px,260px) minmax(80px,1fr) auto;right:6vw}
  .hero-signal-node{width:58px;height:58px}
}
@media(max-width:1000px){
  .hero-v7{min-height:auto;padding-bottom:14px}
  .hero-query-rail{top:14%;left:5vw;right:5vw;grid-template-columns:70px minmax(160px,1fr) minmax(100px,.6fr) auto}
  .hero-grid-v7{grid-template-columns:1fr;gap:2rem;padding:11vh 5vw 2rem}
  .hero-name{font-size:clamp(5rem,12vw,8rem)}
  .hero-system-v7{justify-self:stretch;max-width:820px;transform:none;margin-inline:auto}
  .search-console-v7{height:410px}
  .hero-v7-bottom{padding:0 5vw 1rem;grid-template-columns:1fr;gap:1rem}
  .hero-v7-actions{justify-content:flex-start}
  .hero-v7-work-note{max-width:760px}
  .approach-head-v6,.work-head-v6,.journey-head-v6,.evolution-head-v6,.toolkit-head-v6{grid-template-columns:1fr;gap:2rem}
  .beyond-v6,.now-grid-v6{grid-template-columns:1fr}
  .toolkit-orbit{justify-self:start}
}
@media(max-width:620px){
  .nav-center{display:none}
  .nav{grid-template-columns:1fr auto}
  .hero-v7{padding-top:78px}
  .hero-top{padding-top:0}
  .hero-v7-status{top:73px;left:auto;right:6vw}
  .hero-query-rail{top:17%;left:6vw;right:6vw;grid-template-columns:1fr auto;gap:.5rem .8rem}
  .hero-query-rail strong{grid-column:1/-1}
  .query-line{grid-column:1/-1}
  .hero-query-rail>span:last-child{grid-column:1/-1}
  .hero-grid-v7{padding:12vh 6vw 2rem;gap:2.8rem}
  .hero-name{font-size:clamp(4.25rem,16.3vw,6.4rem);line-height:.78}
  .hero-role{font-size:1rem;white-space:normal;max-width:340px;line-height:1.15}
  .hero-meta-line{font-size:6px}
  .search-console-v7{height:350px;min-height:330px}
  .search-console-v7 .console-query{top:17%}
  .search-console-v7 .console-query strong{font-size:1rem}
  .hero-signal-map{left:4%;right:0;top:39%;height:35%}
  .hero-signal-node{width:46px;height:46px}
  .hero-signal-0{left:0}.hero-signal-1{left:15%}.hero-signal-2{left:30%}.hero-signal-3{left:45%}.hero-signal-4{left:60%}.hero-signal-5{left:75%}.hero-signal-6{display:none}
  .hero-signal-node span{font-size:5px}.hero-signal-node b{font-size:5px}
  .float-one{left:0;top:10%}.float-two{right:0;bottom:12%}.float-three{left:9%;bottom:-2%}
  .hero-v7-work-note{grid-template-columns:1fr;gap:.5rem}
  .hero-v7-actions{display:grid;grid-template-columns:1fr 1fr}
  .hero-v7-actions a{font-size:6px;padding:.7rem .45rem}
  .hero-footer-v6{font-size:6px;gap:.6rem}
  .manifesto-v6,.approach-v6,.work-v6,.proof-v6,.journey-v6,.evolution-v6,.toolkit-v6,.now-v6,.contact-v6{padding:16vw 6vw}
  .manifesto-grid-v6 h2,.approach-head-v6 h2,.work-head-v6 h2,.proof-head-v6 h2,.journey-head-v6 h2,.evolution-head-v6 h2,.toolkit-head-v6 h2,.beyond-copy-v6 h2,.now-grid-v6 h2{font-size:clamp(3.55rem,14.4vw,5.5rem)}
  .manifesto-grid-v6{grid-template-columns:1fr}
  .manifesto-stamp{display:none}
  .signal-system-v6{margin-top:3.5rem;grid-template-columns:repeat(5,180px);overflow:auto}
  .work-intro{align-items:start}
  .projects-v6{margin-top:3.5rem}
  .project-copy-v6 h3{font-size:2.8rem}
  .proof-layout-v6{margin-top:3.5rem}
  .timeline-v6{margin-top:3.5rem}
  .timeline-copy h3{font-size:2.5rem}
  .toolkit-list-v6{margin-top:3.5rem}
  .beyond-copy-v6{padding:14vw 7vw}
  .now-grid-v6{gap:2.5rem;margin-top:3rem}
  .contact-v6 h2{font-size:clamp(4rem,15.5vw,6.3rem)}
}


/* V9 — precision pass: hierarchy, readability, alignment and section-specific visual weight */
:root{
  --paper:#ece9e1;
  --paper2:#e1ddd3;
  --soft:#d1ccc1;
  --line:#c0bcb2;
  --muted:#666861;
}
body{font-size:16px;overflow-x:hidden}

/* Keep the paper surfaces alive without making the grain obvious. */
.hero-v6,.work-v6,.journey-v6,.toolkit-v6,.now-v6{background-color:var(--paper)}
.hero-v6:before,.work-v6:before,.journey-v6:before,.toolkit-v6:before,.now-v6:before{opacity:.27}

/* Navigation: slightly clearer reading hierarchy. */
.nav-center{font-size:8px;letter-spacing:.1em}
.nav-links a{font-size:8px}

/* Hero: one clean information hierarchy. */
.hero-query-rail{z-index:4}
.hero-query-rail>span{color:#777970}
.hero-query-rail strong{color:#30322f}
.hero-name{font-size:clamp(5rem,7.2vw,8.55rem);letter-spacing:-.105em}
.hero-role{font-size:clamp(1rem,1.25vw,1.35rem);letter-spacing:-.045em;font-weight:600}
.hero-meta-line{font-size:8px;color:#5e615a}
.hero-system-v7{max-width:650px}
.search-console-v7{height:min(45vh,435px);min-height:355px}
.search-console-v7 .console-query strong{font-size:clamp(1.2rem,1.6vw,1.7rem)}
.hero-signal-map{left:8%;right:6%;top:40%;height:34%}
.hero-signal-node{width:60px;height:60px}
.hero-signal-0{left:0}.hero-signal-1{left:16%}.hero-signal-2{left:32%}.hero-signal-3{left:48%}.hero-signal-4{left:64%}.hero-signal-5{left:80%}.hero-signal-6{right:-1%;top:25%;opacity:.48}
.hero-v7-float{font-size:7px}
.hero-v7-bottom{grid-template-columns:minmax(0,1fr) auto;padding-left:15vw}
.hero-v7-work-note p{font-size:.74rem;max-width:660px}
.hero-v7-actions a{font-size:7px}

/* Manifesto: make the explanation readable enough to actually support the statement. */
.manifesto-grid-v6{grid-template-columns:.22fr 1.1fr .62fr;gap:4.5vw}
.manifesto-grid-v6 h2{font-size:clamp(4.25rem,6.9vw,7.6rem)}
.manifesto-note p{font-size:.9rem;line-height:1.75;max-width:360px}
.manifesto-note>span{font-size:8px}
.manifesto-stamp{font-size:8px}

/* Thinking: the system, not the heading, gets the visual weight. */
.approach-head-v6 h2{font-size:clamp(4rem,6.1vw,6.9rem)}
.approach-head-v6>p{font-size:.88rem;max-width:470px}
.signal-system-v6{margin-top:4.25rem}
.signal-node{min-height:325px;padding:1.35rem}
.node-icon{width:44px;height:44px}
.signal-node strong{font-size:1.25rem}
.signal-node small{font-size:8px}

/* Work: clearer project scanning and stronger evidence strip. */
.work-head-v6 h2{font-size:clamp(4rem,6.2vw,7rem)}
.work-count{font-size:3.6rem}
.work-intro p{font-size:.86rem;line-height:1.72;max-width:420px}
.projects-v6{margin-top:4.5rem}
.project-copy-v6{padding:1.65rem}
.project-copy-v6 h3{font-size:clamp(2.7rem,3.7vw,4rem);margin:1.35rem 0 .75rem}
.project-detail-label{font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase;color:var(--blue);margin-top:.35rem}
.project-copy-v6 p{font-size:.82rem;line-height:1.65;margin-top:.45rem}
.project-open-v6{font-size:8px}
.work-note-v6{margin-top:3.5rem;padding:1.5rem 1.65rem;grid-template-columns:44px 1.2fr .8fr;gap:1.35rem}
.work-note-v6 strong{font-size:1.4rem}
.work-note-v6 p{font-size:.78rem;line-height:1.65}

/* Proof: the sample state should read as a designed placeholder, not a disclaimer. */
.proof-head-v6 h2{font-size:clamp(4rem,6.2vw,7rem)}
.proof-layout-v6{margin-top:4.5rem}
.proof-chart p{font-size:.76rem;line-height:1.65;color:#8992a3;max-width:420px}

/* Career: company is important, but role/context should scan first. */
.journey-head-v6 h2{font-size:clamp(4rem,6.2vw,7rem)}
.timeline-v6{margin-top:4.5rem}
.timeline-copy h3{font-size:clamp(2.25rem,3.35vw,3.7rem)}
.timeline-copy>b{font-size:.95rem}
.timeline-copy>p{font-size:.82rem;line-height:1.7;max-width:510px}
.timeline-date{font-size:8px}

/* Evolution: make the final question feel intentional. */
.evolution-head-v6 h2{font-size:clamp(4rem,6.2vw,7rem)}

/* Toolkit: capability first, tools second. */
.toolkit-head-v6 h2{font-size:clamp(4rem,6.2vw,7rem)}
.toolkit-list-v6{margin-top:4.5rem}
.toolkit-list-v6>div{min-height:112px;padding:1.2rem 0}
.toolkit-list-v6 h3{font-size:1.35rem}
.toolkit-list-v6 p{font-size:.82rem;line-height:1.6}
.tool-icon{width:44px;height:44px}

/* Photography stays quieter so the image carries the section. */
.beyond-copy-v6 h2{font-size:clamp(4rem,6.2vw,7rem)}
.beyond-copy-v6 p{font-size:.9rem;line-height:1.75;max-width:520px}

/* Now: turn the simple dark box into a compact discovery flow. */
.now-grid-v6{margin-top:4rem}
.now-grid-v6 h2{font-size:clamp(4rem,6.2vw,7rem)}
.now-grid-v6>div:last-child>p{font-size:.9rem;line-height:1.75;max-width:500px}
.now-visual{position:relative;overflow:hidden}
.now-window{position:relative;z-index:2}
.now-window small{display:block;margin-top:1.2rem;font:7px 'DM Mono';letter-spacing:.08em;color:#8d96a7}
.now-route{position:absolute;left:12%;right:12%;bottom:16%;display:grid;grid-template-columns:auto 1fr auto 1fr auto;gap:.65rem;align-items:center;color:#77839a;font:7px 'DM Mono';letter-spacing:.08em}
.now-route i{height:1px;background:#38465d;position:relative}
.now-route i:after{content:'';position:absolute;right:0;top:-1px;width:3px;height:3px;border-radius:50%;background:var(--blue)}

/* Contact: preserve the strong close without another giant type jump. */
.contact-v6 h2{font-size:clamp(4.5rem,7.2vw,8rem)}
.contact-v6>p{font-size:.9rem;line-height:1.7;max-width:500px}
.contact-link-v6{font-size:1rem}

/* Responsive cleanup for the same hierarchy. */
@media(max-width:1200px){
  .hero-grid-v7{grid-template-columns:minmax(0,.9fr) minmax(470px,1.1fr);gap:2.5vw}
  .hero-name{font-size:clamp(4.8rem,7vw,7.9rem)}
  .hero-system-v7{max-width:620px}
  .hero-signal-node{width:56px;height:56px}
  .hero-signal-0{left:0}.hero-signal-1{left:15.5%}.hero-signal-2{left:31%}.hero-signal-3{left:46.5%}.hero-signal-4{left:62%}.hero-signal-5{left:77.5%}.hero-signal-6{right:-2%}
  .hero-v7-bottom{padding-left:10vw}
}
@media(max-width:1000px){
  .hero-grid-v7{grid-template-columns:1fr;gap:2.8rem;padding-top:10vh}
  .hero-name{font-size:clamp(5rem,12vw,8rem)}
  .hero-system-v7{max-width:760px}
  .hero-v7-bottom{padding-left:5vw}
  .manifesto-grid-v6{grid-template-columns:1fr .7fr}
  .manifesto-stamp{display:none}
  .signal-system-v6{overflow:hidden}
  .work-head-v6{grid-template-columns:1fr;gap:2rem}
  .work-intro{justify-content:flex-start}
  .proof-head-v6{grid-template-columns:1fr}
  .proof-stamp{display:none}
}
@media(max-width:620px){
  .hero-name{font-size:clamp(4.25rem,16.4vw,6.3rem)}
  .hero-role{font-size:1rem}
  .hero-meta-line{font-size:6px}
  .search-console-v7{height:365px;min-height:340px}
  .hero-signal-node{width:46px;height:46px}
  .hero-signal-0{left:0}.hero-signal-1{left:15%}.hero-signal-2{left:30%}.hero-signal-3{left:45%}.hero-signal-4{left:60%}.hero-signal-5{left:75%}.hero-signal-6{display:none}
  .hero-v7-bottom{padding-left:6vw}
  .manifesto-note p{font-size:.82rem}
  .signal-system-v6{grid-template-columns:repeat(5,180px);overflow:auto}
  .work-note-v6{grid-template-columns:40px 1fr}
  .work-note-v6 p{grid-column:2}
  .now-route{bottom:12%}
}

/* V10 — section completion pass: stronger Position/Thinking, landscape Career, richer Toolkit/Evolution, contact form */

/* POSITION / make the statement feel like a complete section rather than a single headline. */
.position-system-v6{margin-top:auto;padding-top:4rem;display:grid;grid-template-columns:1.15fr .8fr .55fr;gap:4vw;align-items:center;border-top:1px solid #33363e}
.position-axis{display:flex;align-items:center;gap:.8rem;color:#777b82;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase}
.position-axis i{height:1px;width:42px;background:#3a3d45;position:relative}.position-axis i:after{content:'';position:absolute;right:0;top:-2px;width:4px;height:4px;border-radius:50%;background:var(--blue2)}
.position-orbit{width:230px;height:230px;border:1px solid #353a44;border-radius:50%;position:relative;display:grid;place-items:center;margin:auto;animation:positionfloat 7s ease-in-out infinite}
.position-orbit:before,.position-orbit:after{content:'';position:absolute;border:1px solid #2e333c;border-radius:50%}.position-orbit:before{inset:18%}.position-orbit:after{inset:38%}
.position-core{width:72px;height:72px;border:1px solid var(--blue2);border-radius:50%;display:grid;place-items:center;font:9px 'DM Mono';color:#fff;background:rgba(36,87,255,.08);box-shadow:0 0 30px rgba(36,87,255,.12)}
.position-orbit>span{position:absolute;font:7px 'DM Mono';letter-spacing:.08em;color:#9096a3;text-transform:uppercase}.position-orbit>span:nth-of-type(1){top:9%;left:44%}.position-orbit>span:nth-of-type(2){right:3%;top:47%}.position-orbit>span:nth-of-type(3){bottom:9%;left:40%}.position-orbit>span:nth-of-type(4){left:1%;top:47%}.position-orbit>span:nth-of-type(5){top:28%;left:10%;color:#7188e9}
.position-caption{border-left:1px solid #363941;padding-left:1.4rem}.position-caption>span{font:8px 'DM Mono';color:var(--blue2)}.position-caption p{font-size:.82rem;line-height:1.75;color:#9398a2;max-width:300px}
@keyframes positionfloat{50%{transform:translateY(-7px) rotate(2deg)}}

/* THINKING / make each stage explain itself and give the system more visual weight. */
.approach-principle{margin-top:2.5rem;display:grid;grid-template-columns:auto 1fr auto .9fr;gap:1.2rem;align-items:center;padding:1rem 0;border-top:1px solid #30394d;border-bottom:1px solid #30394d;color:#aeb5c4}.approach-principle>span{font:8px 'DM Mono';color:#7188e9}.approach-principle>strong{font-size:1rem;letter-spacing:-.03em;color:#f1f3f7}.approach-principle>i{font-style:normal;color:var(--blue);font-size:1.4rem}.approach-principle>p{font-size:.72rem;line-height:1.55;margin:0;color:#8992a3}
.signal-system-v6{margin-top:2.2rem}
.signal-node{transition:background .35s,transform .35s,border-color .35s}.signal-node:hover{transform:translateY(-7px);background:linear-gradient(180deg,rgba(36,87,255,.07),rgba(13,21,48,.3));border-color:#43506a}.signal-node p{font-size:.7rem;line-height:1.55;color:#8790a1;margin:.7rem 0 0;max-width:180px;opacity:0;transform:translateY(8px);transition:opacity .3s,transform .3s}.signal-node>b{font:7px 'DM Mono';color:#7188e9;margin-top:.8rem;opacity:0;transition:opacity .3s}.signal-node:hover p,.signal-node:hover>b{opacity:1;transform:none}

/* CAREER / horizontal landscape on desktop to remove the long vertical scroll. */
.career-landscape-v6{margin-top:5rem;position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.career-line-v6{position:absolute;left:6%;right:6%;top:48px;height:1px;background:#aaa69c;z-index:0}.career-line-v6 span{display:block;width:22%;height:2px;background:var(--blue);box-shadow:0 0 16px rgba(36,87,255,.35);animation:careerprogress 4s ease-in-out infinite}
@keyframes careerprogress{0%{transform:translateX(0)}100%{transform:translateX(340%)}}
.career-card-v6{min-height:430px;background:var(--paper);padding:1.3rem 1.35rem 1.5rem;position:relative;z-index:1;transition:transform .35s,background .35s}.career-card-v6:hover{transform:translateY(-6px);background:#e7e3da;z-index:2}
.career-card-top{display:flex;justify-content:space-between;align-items:center;font:8px 'DM Mono';color:#73766e;position:relative;z-index:2}.career-card-top b{color:var(--blue);font-weight:400}.career-card-node{width:13px;height:13px;border-radius:50%;border:1px solid var(--blue);background:var(--paper);margin:1.2rem 0 2.2rem;position:relative;z-index:2;box-shadow:0 0 0 5px rgba(36,87,255,.06)}
.career-stage{font:8px 'DM Mono';text-transform:uppercase;letter-spacing:.08em;color:var(--blue)}.career-card-v6 h3{font-size:clamp(1.8rem,2.5vw,3rem);line-height:.92;letter-spacing:-.08em;margin:.75rem 0 .55rem}.career-card-v6 strong{font:9px 'DM Mono';text-transform:uppercase;color:#666960}.career-card-v6 p{font-size:.76rem;line-height:1.7;color:#676961;max-width:280px}.career-card-v6>em{display:block;margin-top:auto;padding-top:1.2rem;font:7px 'DM Mono';font-style:normal;color:#9a9a91;letter-spacing:.08em}

/* TOOLKIT / creative capability cards rather than a conventional list. */
.toolkit-list-v6{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border-top:1px solid var(--line)}
.toolkit-card-v6{min-height:330px;background:#f1eee6;padding:1.25rem 1.4rem;position:relative;overflow:hidden;transition:transform .35s,background .35s}.toolkit-card-v6:hover{transform:translateY(-6px);background:#e9e5dc;z-index:2}.tool-card-head{display:flex;justify-content:space-between;align-items:center}.tool-card-head .tool-icon{width:52px;height:52px}.tool-card-head>b{font-size:1.1rem;color:var(--blue);font-weight:400}.toolkit-card-v6 h3{font-size:clamp(2.4rem,4vw,4.4rem);line-height:.8;letter-spacing:-.1em;margin:2.5rem 0 1.1rem}.tool-chip-row{display:flex;flex-wrap:wrap;gap:.4rem}.tool-chip-row span{border:1px solid #c6c1b6;padding:.45rem .55rem;font:7px 'DM Mono';letter-spacing:.05em;text-transform:uppercase;color:#555850;transition:border-color .25s,color .25s,transform .25s}.toolkit-card-v6:hover .tool-chip-row span{border-color:#aeb8d8}.toolkit-card-v6>p{font:7px 'DM Mono';color:#8a8b84;letter-spacing:.08em;margin:1.4rem 0 0}.tool-card-signal{position:absolute;right:-1px;bottom:-1px;display:flex;align-items:end;gap:3px;padding:0 1.3rem 1.2rem}.tool-card-signal i{width:3px;height:var(--bar);background:var(--blue);opacity:.65}.tool-card-signal i:nth-child(1){--bar:12px}.tool-card-signal i:nth-child(2){--bar:25px}.tool-card-signal i:nth-child(3){--bar:18px}.tool-card-signal i:nth-child(4){--bar:34px}.tool-card-signal i:nth-child(5){--bar:44px}

/* NOW / more explicit AI discovery flow. */
.now-mini-results{position:absolute;left:13%;right:13%;bottom:13%;display:flex;gap:.45rem}.now-mini-results em{font:7px 'DM Mono';font-style:normal;color:#77849a;border:1px solid #344156;padding:.35rem .5rem;flex:1;text-align:center}.now-mini-results em:first-child{border-color:var(--blue);color:#8ca0ff}

/* CONTACT / actual enquiry form, while keeping the strong closing statement. */
.contact-layout-v6{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(360px,.65fr);gap:7vw;align-items:center;flex:1}.contact-copy-v6{min-width:0}.contact-form-v6{border:1px solid #303541;background:rgba(16,22,34,.72);padding:1.35rem;backdrop-filter:blur(10px)}.form-heading{display:flex;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid #303541;color:#7c8596;font:8px 'DM Mono';letter-spacing:.08em}.form-heading b{font-weight:400;color:#7188e9}.contact-form-v6 label{display:grid;gap:.45rem;margin-top:1rem;color:#8d95a4;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase}.contact-form-v6 input,.contact-form-v6 select,.contact-form-v6 textarea{width:100%;border:0;border-bottom:1px solid #39404e;background:transparent;color:#edf0f5;padding:.65rem 0;font:14px Manrope;outline:none;border-radius:0}.contact-form-v6 input::placeholder,.contact-form-v6 textarea::placeholder{color:#606878}.contact-form-v6 select{color:#b6bdc9}.contact-form-v6 option{color:#111827}.contact-form-v6 input:focus,.contact-form-v6 select:focus,.contact-form-v6 textarea:focus{border-bottom-color:var(--blue)}.contact-form-v6 textarea{resize:vertical;min-height:90px}.contact-form-v6 button{margin-top:1.25rem;width:100%;border:1px solid var(--blue);background:var(--blue);color:#fff;padding:.85rem 1rem;display:flex;justify-content:space-between;align-items:center;font:8px 'DM Mono';letter-spacing:.08em;cursor:pointer;transition:transform .25s,background .25s}.contact-form-v6 button:hover{transform:translateY(-3px);background:#1747ee}.contact-form-v6 button span{font-size:1rem}.form-note{display:block;margin-top:.8rem;color:#596273;font:7px 'DM Mono';line-height:1.5}

@media(max-width:1000px){
  .position-system-v6{grid-template-columns:1fr .8fr}.position-caption{grid-column:1/-1}.position-orbit{margin:0 auto}
  .approach-principle{grid-template-columns:auto 1fr auto}.approach-principle>p{grid-column:2/-1}
  .career-landscape-v6{grid-template-columns:repeat(2,1fr)}.career-line-v6{display:none}.career-card-v6{min-height:360px}
  .evolution-track-v6{grid-template-columns:1fr 1fr}
  .toolkit-list-v6{grid-template-columns:1fr 1fr}
  .contact-layout-v6{grid-template-columns:1fr;gap:3rem;align-items:start;padding-top:4rem}.contact-form-v6{max-width:620px}.contact-v6 h2{margin-top:2rem}
}
@media(max-width:620px){
  .position-system-v6{grid-template-columns:1fr;gap:2rem;padding-top:2.5rem}.position-axis{flex-wrap:wrap}.position-orbit{width:190px;height:190px}.position-caption{grid-column:auto}
  .approach-principle{grid-template-columns:1fr auto;gap:.7rem}.approach-principle>strong{grid-column:1/-1}.approach-principle>p{grid-column:1/-1}
  .signal-node p,.signal-node>b{opacity:1;transform:none}.signal-node{min-height:350px}
  .career-landscape-v6{grid-template-columns:1fr}.career-card-v6{min-height:330px}.career-card-v6 h3{font-size:2.5rem}
  .evolution-track-v6{grid-template-columns:1fr}
  .toolkit-list-v6{grid-template-columns:1fr}.toolkit-card-v6{min-height:280px}.toolkit-card-v6 h3{font-size:3.2rem}
  .contact-layout-v6{padding-top:3rem}.contact-form-v6{padding:1rem}.contact-form-v6 input,.contact-form-v6 select,.contact-form-v6 textarea{font-size:13px}
}


/* V12 — HERO COLLISION FIX / FINAL DESKTOP QA */
.hero-v7{overflow:hidden}
.hero-query-rail{
  left:7vw;
  right:7vw;
  grid-template-columns:78px minmax(180px,300px) minmax(0,1fr) minmax(160px,220px);
  gap:16px;
  width:auto;
  max-width:none;
}
.hero-query-rail strong,
.hero-query-rail .hero-query-intent{
  min-width:0;
  max-width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.hero-query-rail .hero-query-intent{
  justify-self:end;
  text-align:right;
}
.query-line{min-width:0;width:100%}
.hero-system-v7{
  max-width:630px;
  width:min(630px,100%);
  margin-right:1.5vw;
  transform:translateY(.5vh);
}
.search-console-v7{
  width:100%;
  max-width:630px;
  height:min(42vh,410px);
  min-height:340px;
}
.search-console-v7 .console-query{
  left:7%;
  right:7%;
  min-width:0;
  white-space:nowrap;
}
.search-console-v7 .console-query strong{
  min-width:0;
  flex:1 1 auto;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:clamp(1.05rem,1.45vw,1.55rem);
}
.search-console-v7 .cursor-block{flex:0 0 auto}
.hero-signal-map{
  left:6%;
  right:5%;
  top:40%;
  height:32%;
  overflow:visible;
  mask-image:linear-gradient(to right,transparent 0,black 4%,black 94%,transparent 100%);
}
.hero-signal-node{
  width:58px;
  height:58px;
}
.hero-signal-0{left:0}
.hero-signal-1{left:16%}
.hero-signal-2{left:32%}
.hero-signal-3{left:48%}
.hero-signal-4{left:64%}
.hero-signal-5{left:80%}
.hero-signal-6{display:none}
.hero-signal-line{left:3%;right:3%}
.hero-signal-dot{left:2%;}
.float-one{left:-2%;top:11%}
.float-two{right:-2%;bottom:18%}
.float-three{left:12%;bottom:-2%}
.hero-v7-bottom{padding-left:15vw;padding-right:3.5vw}
.hero-v7-work-note{min-width:0}
.hero-v7-work-note p{max-width:620px}

@media(max-width:1200px){
  .hero-query-rail{left:6vw;right:6vw;grid-template-columns:70px minmax(150px,240px) minmax(0,1fr) minmax(130px,190px)}
  .hero-system-v7{max-width:600px;margin-right:0}
  .search-console-v7{max-width:600px}
  .hero-signal-node{width:54px;height:54px}
}
@media(max-width:1000px){
  .hero-query-rail{left:5vw;right:5vw;grid-template-columns:70px minmax(160px,1fr) minmax(100px,.65fr) auto}
  .hero-query-rail .hero-query-intent{justify-self:end}
  .hero-system-v7{width:100%;max-width:760px;margin-inline:auto}
  .search-console-v7{max-width:none;height:410px}
  .hero-signal-node{width:56px;height:56px}
}
@media(max-width:620px){
  .hero-query-rail{left:6vw;right:6vw;grid-template-columns:1fr auto;}
  .hero-query-rail .hero-query-intent{grid-column:1/-1;justify-self:start;text-align:left}
  .hero-system-v7{width:100%}
  .search-console-v7{height:350px;min-height:330px}
  .hero-signal-node{width:46px;height:46px}
  .hero-signal-0{left:0}.hero-signal-1{left:15%}.hero-signal-2{left:30%}.hero-signal-3{left:45%}.hero-signal-4{left:60%}.hero-signal-5{left:75%}.hero-signal-6{display:none}
}

/* V13 — hero system width and spacing refinement */
@media (min-width: 1001px){
  .hero-grid-v7{
    grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);
    gap:4vw;
    padding-left:8vw;
    padding-right:3.5vw;
  }
  .hero-name-block{max-width:780px;}
  .hero-system-v7{
    width:100%;
    max-width:820px;
    justify-self:end;
    transform:translateY(1vh);
  }
  .search-console-v7{
    width:100%;
    min-height:390px;
  }
  .hero-signal-map{
    left:6%;
    right:2.5%;
    top:38%;
    height:36%;
    overflow:visible;
    mask-image:linear-gradient(to right,transparent 0,black 3%,black 97%,transparent 100%);
  }
  .hero-signal-node{
    width:64px;
    height:64px;
    top:25%;
    transform:translateX(-50%);
  }
  .hero-signal-node:hover{transform:translateX(-50%) translateY(-5px)}
  .hero-signal-0{left:7%;}
  .hero-signal-1{left:21.333%;}
  .hero-signal-2{left:35.666%;}
  .hero-signal-3{left:50%;}
  .hero-signal-4{left:64.333%;}
  .hero-signal-5{left:78.666%;}
  .hero-signal-6{left:93%;right:auto;opacity:.9;}
  .hero-signal-line{left:7%;right:7%;}
  .hero-signal-dot{left:6.3%;}
  .float-one{left:-2%;}
  .float-two{right:-1.5%;}
  .float-three{right:11%;}
  .hero-query-rail{
    left:8vw;
    right:3.5vw;
    grid-template-columns:72px minmax(220px,.72fr) minmax(180px,.8fr) max-content;
    gap:14px;
  }
  .hero-query-rail strong{min-width:0;}
  .hero-query-intent{white-space:nowrap;justify-self:end;}
}

@media (min-width: 1200px){
  .hero-grid-v7{grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);}
  .hero-system-v7{max-width:840px;}
  .hero-query-rail{grid-template-columns:72px minmax(260px,.7fr) minmax(220px,.8fr) max-content;}
}

@media (max-width:1000px){
  .hero-system-v7{width:100%;max-width:820px;margin-inline:auto;}
  .hero-signal-map{overflow:visible;}
  .hero-signal-node{transform:translateX(-50%);}
  .hero-signal-node:hover{transform:translateX(-50%) translateY(-4px)}
  .hero-signal-0{left:3%;}.hero-signal-1{left:18.5%;}.hero-signal-2{left:34%;}.hero-signal-3{left:50%;}.hero-signal-4{left:66%;}.hero-signal-5{left:81.5%;}.hero-signal-6{left:97%;right:auto;}
}

@media(max-width:620px){
  .hero-signal-map{left:5%;right:1%;}
  .hero-signal-node{transform:translateX(-50%);}
  .hero-signal-0{left:3%;}.hero-signal-1{left:18.5%;}.hero-signal-2{left:34%;}.hero-signal-3{left:50%;}.hero-signal-4{left:66%;}.hero-signal-5{left:81.5%;}.hero-signal-6{display:none;}
}


/* HERO V7.3 — full-width signal system, seven nodes always contained */
.hero-grid-v7{grid-template-columns:minmax(520px,.86fr) minmax(700px,1.14fr);gap:3.4vw;padding-left:8vw;padding-right:3.5vw}
.hero-name-block{max-width:680px}
.hero-system-v7{width:min(100%,900px);max-width:900px;justify-self:end;transform:translateY(1vh)}
.search-console-v7{width:100%;height:min(48vh,470px);min-height:370px}
.hero-query-rail{left:8vw;right:3.5vw;grid-template-columns:82px minmax(0,1fr) minmax(0,1.1fr);gap:18px}
.hero-query-rail .query-line{min-width:0;width:100%}
.hero-query-intent{justify-self:end;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:clip}
.search-console-v7 .console-query{left:7%;right:5%;}
.search-console-v7 .console-query strong{font-size:clamp(1.35rem,1.7vw,2.05rem);white-space:nowrap}
.hero-signal-map{left:5%;right:5%;top:39%;height:34%;mask-image:linear-gradient(to right,transparent 0,black 3%,black 97%,transparent 100%)}
.hero-signal-nodes{position:absolute;inset:0 3.5%;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));align-items:center;z-index:2}
.hero-signal-node{position:relative!important;left:auto!important;right:auto!important;top:auto!important;width:clamp(64px,4.2vw,78px);height:clamp(64px,4.2vw,78px);justify-self:center;animation:signal-node-breathe 3.2s ease-in-out infinite}
.hero-signal-0{animation-delay:0s}.hero-signal-1{animation-delay:.25s}.hero-signal-2{animation-delay:.5s}.hero-signal-3{animation-delay:.75s}.hero-signal-4{animation-delay:1s}.hero-signal-5{animation-delay:1.25s}.hero-signal-6{animation-delay:1.5s;opacity:1}
.hero-signal-line{left:1%;right:1%;z-index:1}
.hero-signal-dot{left:0;z-index:3}
.float-one{left:-2%;top:12%}.float-two{right:-2%;bottom:16%}.float-three{left:20%;bottom:-4%}
.hero-v7-bottom{padding-left:12vw;padding-right:3.5vw}

@media(min-width:1600px){
  .hero-grid-v7{grid-template-columns:minmax(560px,.84fr) minmax(760px,1.16fr);gap:3vw}
  .hero-system-v7{width:min(100%,960px);max-width:960px}
  .hero-signal-node{width:78px;height:78px}
}
@media(max-width:1200px){
  .hero-grid-v7{grid-template-columns:minmax(440px,.82fr) minmax(620px,1.18fr);gap:2.5vw}
  .hero-system-v7{max-width:820px}
}
@media(max-width:1000px){
  .hero-grid-v7{grid-template-columns:1fr;gap:4rem;padding-left:5vw;padding-right:5vw}
  .hero-system-v7{width:100%;max-width:none}
  .hero-query-rail{left:5vw;right:5vw;grid-template-columns:70px minmax(0,1fr) auto}
  .hero-query-intent{display:none}
  .hero-signal-nodes{inset:0 2%}
  .hero-v7-bottom{padding-left:5vw;padding-right:5vw}
}
@media(max-width:620px){
  .hero-query-rail{left:6vw;right:6vw;grid-template-columns:1fr auto}
  .hero-query-rail strong{grid-column:1 / -1}
  .hero-query-rail .query-line{grid-column:1 / -1}
  .hero-grid-v7{padding-left:6vw;padding-right:6vw}
  .hero-signal-map{left:2%;right:2%;}
  .hero-signal-nodes{inset:0 1%}
  .hero-signal-node{width:48px;height:48px}
  .hero-signal-node span{font-size:5px}
  .hero-signal-node b{font-size:5px}
  .hero-signal-6{display:flex}
}

/* V15 — viewport containment / hero final alignment pass */
@media (min-width: 1201px){
  .hero-v7{overflow:hidden}
  .hero-v7-location{right:6vw;left:auto;max-width:240px;text-align:right;white-space:nowrap}
  .hero-v7-status{left:46%;max-width:220px;white-space:nowrap}

  .hero-query-rail{
    left:9.5vw;
    right:6vw;
    width:auto;
    max-width:none;
    grid-template-columns:82px minmax(190px,300px) minmax(120px,1fr) minmax(190px,230px);
    gap:14px;
    align-items:center;
  }
  .hero-query-rail > span,
  .hero-query-rail strong,
  .hero-query-intent{min-width:0}
  .hero-query-rail strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .hero-query-intent{justify-self:end;text-align:right;white-space:nowrap;overflow:visible;text-overflow:clip}

  .hero-grid-v7{
    grid-template-columns:minmax(500px,.42fr) minmax(680px,.58fr);
    gap:2.5vw;
    padding-left:9.5vw;
    padding-right:6vw;
    padding-top:6.5vh;
  }
  .hero-name-block{max-width:620px;min-width:0}
  .hero-name{font-size:clamp(5rem,7.05vw,8.4rem);letter-spacing:-.095em}
  .hero-system-v7{width:100%;max-width:820px;justify-self:end;min-width:0;transform:none}
  .search-console-v7{width:100%;max-width:none;height:min(45vh,430px);min-height:355px}
  .search-console-v7 .console-query{left:7%;right:5%;min-width:0}
  .search-console-v7 .console-query strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:clamp(1.15rem,1.5vw,1.65rem)}

  .hero-signal-map{left:5%;right:4%;top:39%;height:35%;overflow:hidden}
  .hero-signal-nodes{inset:0 2.5%;grid-template-columns:repeat(7,minmax(0,1fr))}
  .hero-signal-node{width:clamp(60px,4vw,72px);height:clamp(60px,4vw,72px);min-width:0}
  .hero-signal-line{left:2%;right:2%}
  .hero-signal-dot{left:1%;}

  .float-one{left:-1%;top:12%}
  .float-two{right:-1%;bottom:16%}
  .float-three{left:20%;bottom:-3%}

  .hero-v7-bottom{padding-left:15.5vw;padding-right:6vw}
  .hero-v7-work-note{max-width:760px;min-width:0}
  .hero-v7-work-note p{max-width:620px}
}

@media (min-width: 1500px){
  .hero-grid-v7{grid-template-columns:minmax(520px,.41fr) minmax(760px,.59fr);gap:2vw}
  .hero-system-v7{max-width:900px}
  .search-console-v7{height:min(46vh,440px)}
  .hero-signal-node{width:72px;height:72px}
}

@media (max-width:1200px) and (min-width:1001px){
  .hero-v7-location{right:5vw;left:auto;white-space:nowrap}
  .hero-query-rail{left:7vw;right:5vw;grid-template-columns:72px minmax(180px,260px) minmax(0,1fr) minmax(170px,210px);gap:12px}
  .hero-query-intent{justify-self:end;text-align:right;white-space:nowrap}
  .hero-grid-v7{grid-template-columns:minmax(420px,.44fr) minmax(580px,.56fr);gap:2vw;padding-left:7vw;padding-right:5vw}
  .hero-system-v7{max-width:700px}
  .search-console-v7{max-width:none}
}

/* Slightly tighter vertical rhythm across the page. */
.manifesto-v6,.approach-v6,.work-v6,.proof-v6,.journey-v6,.evolution-v6,.toolkit-v6,.now-v6{padding-top:6.25vw;padding-bottom:6.25vw}
.signal-system-v6,.projects-v6,.proof-layout-v6,.timeline-v6{margin-top:3.75rem}
.career-landscape-v6{margin-top:4rem}

@media(max-width:620px){
  .manifesto-v6,.approach-v6,.work-v6,.proof-v6,.journey-v6,.evolution-v6,.toolkit-v6,.now-v6,.contact-v6{padding-top:13vw;padding-bottom:13vw}
  .signal-system-v6,.projects-v6,.proof-layout-v6,.timeline-v6{margin-top:3rem}
}

/* Contact readability: reserve clear columns and prevent orbit/form collisions. */
.contact-v6{overflow:hidden}
.contact-layout-v6{grid-template-columns:minmax(0,1.05fr) minmax(390px,.7fr);gap:6vw;align-items:center}
.contact-copy-v6{max-width:760px}
.contact-copy-v6 h2,.contact-copy-v6 p,.contact-copy-v6 .contact-link-v6{position:relative;z-index:3}
.contact-form-v6{position:relative;z-index:4;min-width:0}
.blue-orbit-v6{pointer-events:none;z-index:0}
@media(max-width:1000px){.contact-layout-v6{grid-template-columns:1fr;gap:2.5rem}.contact-form-v6{width:100%;max-width:680px}.blue-orbit-v6{opacity:.55}}

/* V16 — final hero containment + page rhythm pass */

/* Keep the hero on one bounded content grid. Nothing decorative is allowed to
   establish its own viewport-relative width. */
@media (min-width: 1001px){
  .hero-v7{
    overflow:hidden;
    --hero-gutter: clamp(48px, 6vw, 112px);
  }

  .hero-v7 .hero-top{
    left:var(--hero-gutter);
    right:var(--hero-gutter);
    width:auto;
  }

  .hero-v7-status{
    left:auto;
    right:calc(var(--hero-gutter) + 42%);
  }

  .hero-v7-location{
    left:auto;
    right:var(--hero-gutter);
    max-width:240px;
    white-space:nowrap;
    text-align:right;
  }

  .hero-query-rail{
    left:var(--hero-gutter);
    right:var(--hero-gutter);
    width:auto;
    max-width:none;
    grid-template-columns:72px minmax(180px, .85fr) minmax(120px, 1fr) max-content;
    gap:14px;
  }

  .hero-query-rail .hero-query-intent{
    min-width:0;
    max-width:100%;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    justify-self:end;
    text-align:right;
  }

  .hero-grid-v7{
    /* The previous min-width values were the root cause of the horizontal
       overflow: 520px + 760px + gap was wider than the usable viewport. */
    grid-template-columns:minmax(0, .43fr) minmax(0, .57fr);
    gap:clamp(28px, 3vw, 54px);
    padding-left:var(--hero-gutter);
    padding-right:var(--hero-gutter);
    padding-top:6.5vh;
    padding-bottom:2vh;
  }

  .hero-name-block{
    max-width:680px;
    min-width:0;
  }

  .hero-name{
    font-size:clamp(5rem, 7vw, 8.45rem);
    max-width:100%;
  }

  .hero-system-v7{
    width:100%;
    max-width:none;
    min-width:0;
    margin:0;
    justify-self:stretch;
    transform:none;
  }

  .search-console-v7{
    width:100%;
    max-width:none;
    min-width:0;
    height:min(45vh, 430px);
    min-height:355px;
  }

  .search-console-v7 .console-query{
    left:7%;
    right:5%;
    min-width:0;
  }

  .search-console-v7 .console-query strong{
    min-width:0;
    max-width:100%;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }

  .hero-signal-map{
    left:5%;
    right:5%;
    top:39%;
    height:35%;
    overflow:hidden;
    mask-image:linear-gradient(to right, transparent 0, black 2%, black 98%, transparent 100%);
  }

  .hero-signal-nodes{
    inset:0 1.5%;
    grid-template-columns:repeat(7, minmax(0, 1fr));
  }

  .hero-signal-node{
    width:clamp(58px, 4vw, 72px);
    height:clamp(58px, 4vw, 72px);
    min-width:0;
  }

  .hero-signal-line{left:2%;right:2%}
  .hero-signal-dot{left:1%;}

  /* Keep the floating labels inside the same safe area as the system. */
  .float-one{left:0;top:12%;}
  .float-two{right:0;bottom:16%;}
  .float-three{left:18%;bottom:0;}

  .hero-v7-bottom{
    padding-left:var(--hero-gutter);
    padding-right:var(--hero-gutter);
  }

  .hero-footer-v6{
    padding-left:var(--hero-gutter);
    padding-right:var(--hero-gutter);
  }
}

@media (min-width:1500px){
  .hero-grid-v7{grid-template-columns:minmax(0,.41fr) minmax(0,.59fr);}
  .hero-system-v7{max-width:920px;justify-self:end;}
}

@media (max-width:1200px) and (min-width:1001px){
  .hero-v7 .hero-top{left:5vw;right:5vw;}
  .hero-v7-location{right:5vw;}
  .hero-v7-status{right:44%;}
  .hero-query-rail{left:5vw;right:5vw;grid-template-columns:68px minmax(160px,.8fr) minmax(100px,1fr) max-content;}
  .hero-grid-v7{grid-template-columns:minmax(0,.44fr) minmax(0,.56fr);padding-left:5vw;padding-right:5vw;gap:2.5vw;}
  .hero-name{font-size:clamp(4.8rem,6.9vw,7.6rem);}
}

@media (max-width:1000px){
  .hero-v7{overflow:hidden;}
  .hero-v7-location{right:5vw;}
  .hero-query-rail{left:5vw;right:5vw;}
  .hero-grid-v7{grid-template-columns:1fr;padding-left:5vw;padding-right:5vw;}
  .hero-system-v7{width:100%;max-width:820px;margin-inline:auto;}
  .hero-v7-bottom{padding-left:5vw;padding-right:5vw;}
  .hero-footer-v6{padding-left:5vw;padding-right:5vw;}
  .float-one{left:0;}
  .float-two{right:0;}
  .float-three{left:10%;bottom:0;}
}

@media (max-width:620px){
  .hero-v7-location{right:6vw;max-width:180px;}
  .hero-query-rail{left:6vw;right:6vw;}
  .hero-grid-v7{padding-left:6vw;padding-right:6vw;}
  .hero-v7-bottom{padding-left:6vw;padding-right:6vw;}
  .hero-footer-v6{padding-left:6vw;padding-right:6vw;}
  .float-one{left:0;}
  .float-two{right:0;}
  .float-three{left:8%;}
}

/* Slightly tighter overall vertical rhythm without collapsing section identities. */
@media (min-width:621px){
  .manifesto-v6,.approach-v6,.work-v6,.proof-v6,.journey-v6,.evolution-v6,.toolkit-v6,.now-v6{
    padding-top:5.5vw;
    padding-bottom:5.5vw;
  }
  .career-landscape-v6{margin-top:3.25rem;}
  .signal-system-v6,.projects-v6,.proof-layout-v6,.timeline-v6{margin-top:3.25rem;}
}

/* Contact: keep the form and orbital graphic in separate visual planes. */
.contact-v6 .contact-layout-v6{position:relative;z-index:3;}
.contact-v6 .contact-copy-v6{position:relative;z-index:4;}
.contact-v6 .contact-form-v6{position:relative;z-index:5;color:#edf0f5;}
.contact-v6 .blue-orbit-v6{z-index:1;opacity:.75;pointer-events:none;}
.contact-form-v6 label{color:#a7afbd;}
.contact-form-v6 input,.contact-form-v6 select,.contact-form-v6 textarea{color:#f1f4f8;}
.contact-form-v6 input::placeholder,.contact-form-v6 textarea::placeholder{color:#727b8c;}
.contact-form-v6 select{color:#d4dae4;}
.contact-form-v6 select option{background:#111827;color:#f1f4f8;}
.contact-form-v6 .form-note{color:#687386;}
@media(min-width:1001px){
  .contact-v6 .blue-orbit-v6{right:-24vw;}
}

/* V17 — hard containment for hero query rail + seven-node signal path */
@media (min-width:1001px){
  .hero-query-rail{
    display:grid;
    grid-template-columns:72px minmax(0,330px) minmax(0,1fr);
    gap:14px;
    align-items:center;
    overflow:visible;
  }
  .hero-query-rail .hero-query-intent{
    position:absolute;
    right:0;
    top:50%;
    transform:translateY(-50%);
    width:auto;
    max-width:calc(100% - 16px);
    margin:0;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:clip;
    justify-self:auto;
  }
  .hero-query-rail .query-line{min-width:0;width:100%;}

  .hero-signal-map{overflow:visible;}
  .hero-signal-nodes{
    left:0;
    right:0;
    width:100%;
    inset-block:0;
    display:grid;
    grid-template-columns:repeat(7,minmax(0,1fr));
    align-items:center;
  }
  .hero-signal-node{
    position:relative !important;
    left:auto !important;
    right:auto !important;
    top:auto !important;
    justify-self:center;
    width:clamp(58px,4vw,72px);
    height:clamp(58px,4vw,72px);
    min-width:0;
  }
  .hero-signal-6{display:flex !important;opacity:1 !important;}
}

@media (max-width:1000px){
  .hero-query-rail .hero-query-intent{position:static;transform:none;}
}

/* V16.1 — HERO: hard viewport containment + all seven signal nodes visible */
@media (min-width: 1201px){
  .hero-query-rail{
    left:9.5vw;
    right:6vw;
    width:auto;
    box-sizing:border-box;
    grid-template-columns:72px minmax(0,1fr) minmax(0,1.1fr) minmax(0,220px);
    gap:14px;
    overflow:hidden;
  }
  .hero-query-rail > *{min-width:0;max-width:100%;}
  .hero-query-rail .hero-query-intent{
    display:block;
    width:100%;
    min-width:0;
    max-width:100%;
    justify-self:stretch;
    text-align:right;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }

  .hero-signal-map{
    left:4%;
    right:4%;
    overflow:hidden;
  }
  .hero-signal-nodes{
    left:1.5%;
    right:1.5%;
    inset-block:0;
    display:grid;
    grid-template-columns:repeat(7,minmax(0,1fr));
    align-items:center;
  }
  .hero-signal-node{
    display:flex !important;
    position:relative !important;
    inset:auto !important;
    left:auto !important;
    right:auto !important;
    top:auto !important;
    width:clamp(54px,3.65vw,72px);
    height:clamp(54px,3.65vw,72px);
    min-width:0;
    min-height:0;
    justify-self:center;
    transform:none;
  }
  .hero-signal-node:hover{transform:translateY(-5px);}
  .hero-signal-6{display:flex !important;opacity:1 !important;}
}

@media (min-width: 1500px){
  .hero-signal-node{width:68px;height:68px;}
}

/* V17 — query rail containment: four children, four bounded columns. */
@media (min-width:1001px){
  .hero-query-rail{
    left:8vw;
    right:3.5vw;
    width:auto;
    max-width:none;
    grid-template-columns:82px minmax(0,1.05fr) minmax(120px,.9fr) minmax(150px,220px);
    gap:14px;
    box-sizing:border-box;
    overflow:hidden;
  }
  .hero-query-rail > *{min-width:0;max-width:100%;}
  .hero-query-rail .query-line{width:100%;min-width:0;}
  .hero-query-rail .hero-query-intent{
    min-width:0;
    width:100%;
    max-width:100%;
    justify-self:stretch;
    text-align:right;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
}

@media (min-width:1200px){
  .hero-query-rail{
    grid-template-columns:82px minmax(220px,1.05fr) minmax(160px,.9fr) minmax(170px,220px);
  }
}

/* FINAL DESKTOP FIX — keep the live-query rail inside its own four-column grid.
   Do not position the intent label absolutely; that was causing it to escape the rail.
   Preserve all navigation and hero floating labels. */
@media (min-width:1001px){
  .hero-query-rail{
    left:8vw !important;
    right:3.5vw !important;
    width:auto !important;
    display:grid !important;
    grid-template-columns:72px minmax(0,330px) minmax(0,1fr) minmax(0,220px) !important;
    gap:14px !important;
    align-items:center !important;
    overflow:hidden !important;
  }
  .hero-query-rail > *{min-width:0 !important;max-width:100% !important;}
  .hero-query-rail > span:first-child{grid-column:1;}
  .hero-query-rail > .hero-query-cycle{grid-column:2;}
  .hero-query-rail > .query-line{grid-column:3;position:relative !important;width:100% !important;}
  .hero-query-rail > .hero-query-intent{
    grid-column:4 !important;
    position:static !important;
    inset:auto !important;
    transform:none !important;
    display:block !important;
    width:100% !important;
    max-width:100% !important;
    min-width:0 !important;
    margin:0 !important;
    justify-self:stretch !important;
    text-align:right !important;
    white-space:nowrap !important;
    overflow:hidden !important;
    text-overflow:ellipsis !important;
  }
}

/* Keep the three floating hero labels present and within the search-system area. */
@media (min-width:1001px){
  .hero-system-v7{overflow:visible !important;}
  .hero-v7-float.float-one{display:block !important;left:-4% !important;}
  .hero-v7-float.float-two{display:block !important;right:-4% !important;}
  .hero-v7-float.float-three{display:block !important;left:10% !important;}
}

/* HERO — definitive query rail containment.
   Use flex rather than nested grid sizing so every rail item remains inside
   the hero bounds at desktop widths. */
@media (min-width:1001px){
  .hero-query-rail{
    left:8vw !important;
    right:3.5vw !important;
    width:auto !important;
    max-width:none !important;
    display:flex !important;
    align-items:center !important;
    gap:14px !important;
    overflow:hidden !important;
    box-sizing:border-box !important;
  }
  .hero-query-rail > span:first-child{
    flex:0 0 72px !important;
    width:72px !important;
    min-width:0 !important;
  }
  .hero-query-rail > .hero-query-cycle{
    flex:0 1 330px !important;
    width:auto !important;
    min-width:0 !important;
    max-width:330px !important;
    overflow:hidden !important;
    text-overflow:ellipsis !important;
    white-space:nowrap !important;
  }
  .hero-query-rail > .query-line{
    position:relative !important;
    flex:1 1 auto !important;
    width:auto !important;
    min-width:40px !important;
    max-width:none !important;
  }
  .hero-query-rail > .hero-query-intent{
    position:static !important;
    flex:0 1 220px !important;
    width:auto !important;
    min-width:0 !important;
    max-width:220px !important;
    margin:0 !important;
    display:block !important;
    justify-self:auto !important;
    text-align:right !important;
    white-space:nowrap !important;
    overflow:hidden !important;
    text-overflow:ellipsis !important;
    transform:none !important;
    inset:auto !important;
  }
}

@media (min-width:1500px){
  .hero-query-rail > .hero-query-intent{
    flex-basis:230px !important;
    max-width:230px !important;
  }
}

/* HERO QUERY RAIL — viewport-anchored containment
   The intent label is intentionally removed from flex/grid sizing. The rail itself
   has an explicit viewport-relative width, so the right label cannot escape it. */
@media (min-width:1001px){
  .hero-query-rail{
    position:absolute !important;
    left:8vw !important;
    right:auto !important;
    width:calc(92vw - 8vw) !important;
    max-width:calc(100vw - 16vw) !important;
    box-sizing:border-box !important;
    display:grid !important;
    grid-template-columns:72px minmax(0,330px) minmax(0,1fr) 190px !important;
    gap:14px !important;
    overflow:hidden !important;
    contain:layout paint !important;
  }
  .hero-query-rail > span:first-child{
    grid-column:1 !important;
    min-width:0 !important;
  }
  .hero-query-rail > .hero-query-cycle{
    grid-column:2 !important;
    min-width:0 !important;
    max-width:330px !important;
    overflow:hidden !important;
    white-space:nowrap !important;
    text-overflow:ellipsis !important;
  }
  .hero-query-rail > .query-line{
    grid-column:3 !important;
    min-width:0 !important;
    width:100% !important;
    position:relative !important;
  }
  .hero-query-rail > .hero-query-intent{
    grid-column:4 !important;
    position:static !important;
    inset:auto !important;
    transform:none !important;
    display:block !important;
    width:190px !important;
    max-width:190px !important;
    min-width:0 !important;
    margin:0 !important;
    justify-self:end !important;
    text-align:right !important;
    white-space:nowrap !important;
    overflow:hidden !important;
    text-overflow:clip !important;
  }
}

/* =========================================================
   ABOUT + CONTACT PAGES
   Separate editorial pages; home composition remains intact.
   ========================================================= */
.about-page,.contact-page{min-height:100svh;background:var(--paper);color:var(--ink)}
.nav-active{color:var(--blue)!important}
.about-page .nav,.contact-page .nav{grid-template-columns:1fr auto 1fr}
.about-hero{min-height:100svh;padding:105px 6vw 28px;position:relative;overflow:hidden;display:flex;flex-direction:column;background:var(--paper)}
.about-grid-bg{position:absolute;inset:0;opacity:.48;pointer-events:none;background-image:linear-gradient(rgba(16,17,19,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(16,17,19,.035) 1px,transparent 1px);background-size:112px 112px}
.about-grid-bg:after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 74% 38%,rgba(36,87,255,.08),transparent 28%)}
.about-meta,.about-hero-line,.about-section-label,.about-now-label,.about-footer{position:relative;z-index:2;font:8px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}
.about-meta{display:flex;justify-content:space-between;color:#696c66}
.about-hero-grid{position:relative;z-index:2;flex:1;display:grid;grid-template-columns:.22fr 1.18fr .42fr;gap:5vw;align-items:center}
.about-kicker{font:8px 'DM Mono';letter-spacing:.1em;color:#696c66;align-self:start;margin-top:15vh}
.about-hero h1{font-size:clamp(5.8rem,10vw,11rem);line-height:.73;letter-spacing:-.12em;margin:0;max-width:1000px}
.about-hero h1 em,.about-statement h2 em,.about-career-head h2 em,.about-cap-head h2 em,.about-personal-copy h2 em,.about-now h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}
.about-lead{font-size:1rem;line-height:1.7;color:#5d6059;max-width:590px;margin:2.5rem 0 0}
.about-stats{align-self:end;border-left:1px solid var(--line);padding-left:1.5rem;display:grid;gap:1.5rem;margin-bottom:6vh}
.about-stats div{display:flex;gap:.8rem;align-items:baseline}
.about-stats strong{font-size:2.8rem;line-height:.8;letter-spacing:-.08em}
.about-stats span{font:7px 'DM Mono';letter-spacing:.08em;color:#74776f}
.about-hero-line{border-top:1px solid var(--line);padding-top:10px;display:flex;justify-content:space-between;color:#73766f}
.about-statement{background:var(--ink);color:var(--white);padding:8vw 6vw;min-height:82svh;display:flex;flex-direction:column}
.about-section-label{display:flex;justify-content:space-between;color:#858990}
.about-statement-grid{margin:auto 0;display:grid;grid-template-columns:.18fr 1.25fr .5fr;gap:5vw;align-items:end}
.about-index{font:9px 'DM Mono';color:var(--blue2);letter-spacing:.08em}
.about-statement h2{font-size:clamp(4.7rem,8vw,9rem);line-height:.76;letter-spacing:-.12em;margin:0}
.about-statement p{font-size:.82rem;line-height:1.75;color:#9ba0a9;max-width:390px;margin:0}
.about-career{padding:8vw 6vw;background:var(--paper2)}
.about-career-head{display:grid;grid-template-columns:1.2fr .42fr;gap:7vw;align-items:end;margin-top:4rem}
.about-career-head h2,.about-cap-head h2{font-size:clamp(4.7rem,7.7vw,8.6rem);line-height:.77;letter-spacing:-.12em;margin:0}
.about-career-head p,.about-cap-head p{font-size:.82rem;line-height:1.75;color:#646760;max-width:390px;margin:0 0 .4rem}
.about-career-list{margin-top:5rem;border-top:1px solid #bbb7ae}
.about-career-list article{display:grid;grid-template-columns:55px 130px 1fr 35px;gap:1.2rem;padding:1.7rem 0;border-bottom:1px solid #bbb7ae;align-items:start;transition:padding .3s,background .3s}
.about-career-list article:hover{padding-left:.8rem;background:rgba(255,255,255,.22)}
.about-career-no,.about-career-year,.about-career-main>span{font:8px 'DM Mono';letter-spacing:.08em;color:#73766f}
.about-career-main h3{font-size:clamp(2rem,3.4vw,3.8rem);line-height:.9;letter-spacing:-.08em;margin:.35rem 0 .4rem}
.about-career-main strong{font-size:.86rem;font-weight:600}
.about-career-main p{font-size:.75rem;line-height:1.65;color:#696c65;max-width:650px;margin:.65rem 0 0}
.about-career-arrow{font-size:1.1rem;color:var(--blue);text-align:right}
.about-capabilities{padding:8vw 6vw;background:var(--navy);color:#f5f5f1;position:relative;overflow:hidden}
.about-capabilities:after{content:'';position:absolute;width:42vw;height:42vw;border:1px solid rgba(36,87,255,.18);border-radius:50%;right:-18vw;top:16%;box-shadow:0 0 0 8vw rgba(36,87,255,.025),0 0 0 16vw rgba(36,87,255,.018)}
.about-cap-head{display:grid;grid-template-columns:1.2fr .42fr;gap:7vw;align-items:end;margin-top:4rem;position:relative;z-index:1}
.about-cap-head p{color:#9aa1ae}
.about-cap-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:5rem;border-top:1px solid #303a50;border-left:1px solid #303a50;position:relative;z-index:1}
.about-cap-grid article{min-height:245px;padding:1.2rem 1.3rem 1.5rem;border-right:1px solid #303a50;border-bottom:1px solid #303a50;display:flex;flex-direction:column;transition:background .3s,transform .3s}
.about-cap-grid article:hover{background:rgba(36,87,255,.06);transform:translateY(-3px)}
.about-cap-grid article>span{font:8px 'DM Mono';color:#7088e8}
.about-cap-grid h3{font-size:1.25rem;letter-spacing:-.04em;margin:auto 0 .5rem}
.about-cap-grid p{font-size:.75rem;line-height:1.65;color:#9aa1ae;max-width:290px;margin:0}
.about-cap-grid i{font-style:normal;color:#7188e9;align-self:flex-end;margin-top:1rem}
.about-personal{display:grid;grid-template-columns:1.1fr .9fr;min-height:88svh;background:#d9d5ca}
.about-personal-visual{min-height:70vh;padding:6vw;position:relative;overflow:hidden}
.about-photo-placeholder{height:100%;min-height:600px;position:relative;border:1px solid rgba(16,17,19,.22);background:linear-gradient(145deg,#c9c5bb,#e4e0d5);overflow:hidden}
.about-photo-placeholder:before{content:'';position:absolute;width:70%;height:130%;left:-12%;top:-12%;background:linear-gradient(110deg,transparent 42%,rgba(255,255,255,.5) 43%,transparent 44%);transform:rotate(7deg)}
.about-photo-placeholder:after{content:'';position:absolute;inset:10%;border:1px solid rgba(16,17,19,.16);background:radial-gradient(circle at 68% 34%,rgba(36,87,255,.18),transparent 18%),linear-gradient(155deg,transparent 48%,rgba(16,17,19,.07) 49%,transparent 50%)}
.about-photo-placeholder span,.about-photo-placeholder b{position:absolute;z-index:2;top:1rem;font:8px 'DM Mono';letter-spacing:.08em}
.about-photo-placeholder span{left:1rem}.about-photo-placeholder b{right:1rem;font-weight:400}
.about-photo-placeholder i{position:absolute;z-index:2;left:50%;top:50%;font-style:normal;font-size:3rem;color:var(--blue);transform:translate(-50%,-50%)}
.about-personal-copy{padding:8vw 7vw;display:flex;flex-direction:column;justify-content:center}
.about-personal-copy>span{font:8px 'DM Mono';letter-spacing:.08em;color:#62655f}
.about-personal-copy h2{font-size:clamp(4.4rem,6.5vw,7.5rem);line-height:.77;letter-spacing:-.12em;margin:2rem 0}
.about-personal-copy p{max-width:480px;font-size:.84rem;line-height:1.8;color:#60635c}
.about-tags{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:2rem}.about-tags span{border:1px solid #b7b3aa;padding:.55rem .65rem;font:7px 'DM Mono';letter-spacing:.08em}
.about-now{padding:8vw 6vw;background:#f2efe7;min-height:70svh;display:flex;flex-direction:column}
.about-now-grid{margin:auto 0;display:grid;grid-template-columns:1fr .42fr;gap:8vw;align-items:end}
.about-now-label{color:var(--blue)}
.about-now h2{font-size:clamp(5rem,8vw,9rem);line-height:.75;letter-spacing:-.12em;margin:1.5rem 0 0}
.about-now-grid>p{font-size:.86rem;line-height:1.8;color:#676a63;max-width:420px;margin:0}
.about-now-footer{border-top:1px solid var(--line);padding-top:1rem;margin-top:4rem;display:flex;justify-content:space-between;font:8px 'DM Mono';letter-spacing:.08em}
.about-now-footer a{color:var(--blue)}
.about-footer{padding:1rem 6vw;border-top:1px solid #c2beb5;display:flex;justify-content:space-between;color:#73766f}
.about-footer a:hover{color:var(--blue)}

.contact-page{background:#0d0e12;color:#f5f5f1}
.contact-nav{background:rgba(13,14,18,.82)!important;border-bottom-color:rgba(255,255,255,.09)!important;color:#f5f5f1}.contact-nav .nav-center{color:#747b88}.contact-nav .nav-links a{color:#b8bec9}.contact-nav .nav-links a:hover,.contact-nav .nav-links .nav-active{color:#fff!important}
.contact-page-hero{min-height:100svh;padding:105px 6vw 24px;position:relative;overflow:hidden;display:flex;flex-direction:column;background:radial-gradient(circle at 76% 44%,rgba(36,87,255,.11),transparent 27%),#0d0e12}
.contact-page-grid{position:absolute;inset:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);background-size:90px 90px}
.contact-page-orbit{position:absolute;width:58vw;height:58vw;right:-22vw;top:17%;border:1px solid rgba(36,87,255,.42);border-radius:50%;pointer-events:none}.contact-page-orbit:before,.contact-page-orbit:after{content:'';position:absolute;border:1px solid rgba(36,87,255,.2);border-radius:50%;inset:13%}.contact-page-orbit:after{inset:30%}.contact-page-orbit span{position:absolute;width:10px;height:10px;left:50%;top:-5px;border-radius:50%;background:var(--blue);box-shadow:0 0 28px rgba(36,87,255,.95);animation:orbitdot 7s linear infinite}
.contact-page-meta,.contact-page-bottom{position:relative;z-index:2;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase;color:#707784;display:flex;justify-content:space-between}
.contact-page-layout{position:relative;z-index:2;flex:1;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(390px,.65fr);gap:8vw;align-items:center}
.contact-page-copy{max-width:760px}.contact-page-kicker{font:8px 'DM Mono';letter-spacing:.1em;color:#6d7687}.contact-page-copy h1{font-size:clamp(5.5rem,9.8vw,11rem);line-height:.72;letter-spacing:-.12em;margin:2rem 0 2.2rem}.contact-page-copy h1 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.contact-page-copy>p{font-size:.86rem;line-height:1.75;color:#9ca2ae;max-width:500px}.contact-page-email{display:flex;justify-content:space-between;max-width:650px;padding:1rem 0;border-bottom:1px solid #343842;margin-top:2rem;font-size:1rem}.contact-page-email span{color:#7188e9}.contact-page-notes{display:flex;gap:1.4rem;flex-wrap:wrap;margin-top:2rem}.contact-page-notes span{font:7px 'DM Mono';color:#697281;letter-spacing:.08em}
.contact-page-form{border:1px solid #303541;background:rgba(16,22,34,.72);padding:1.45rem;backdrop-filter:blur(12px);box-shadow:16px 16px 0 rgba(36,87,255,.06)}
.contact-form-top{display:flex;justify-content:space-between;padding-bottom:1rem;border-bottom:1px solid #303541;color:#7c8596;font:8px 'DM Mono';letter-spacing:.08em}.contact-form-top b{font-weight:400;color:#7188e9}.contact-page-form label{display:grid;gap:.45rem;margin-top:1.1rem;color:#a7afbd;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase}.contact-page-form input,.contact-page-form select,.contact-page-form textarea{width:100%;border:0;border-bottom:1px solid #39404e;background:transparent;color:#f1f4f8;padding:.7rem 0;font:14px Manrope;outline:none;border-radius:0}.contact-page-form input::placeholder,.contact-page-form textarea::placeholder{color:#687181}.contact-page-form select{color:#d4dae4}.contact-page-form option{background:#111827;color:#f1f4f8}.contact-page-form input:focus,.contact-page-form select:focus,.contact-page-form textarea:focus{border-bottom-color:var(--blue)}.contact-page-form textarea{resize:vertical;min-height:105px}.contact-page-form button{margin-top:1.35rem;width:100%;border:1px solid var(--blue);background:var(--blue);color:#fff;padding:.9rem 1rem;display:flex;justify-content:space-between;align-items:center;font:8px 'DM Mono';letter-spacing:.08em;cursor:pointer;transition:transform .25s,background .25s}.contact-page-form button:hover{transform:translateY(-3px);background:#1747ee}.contact-page-form button span{font-size:1rem}.contact-page-form small{display:block;margin-top:.8rem;color:#687386;font:7px 'DM Mono';line-height:1.5}.contact-page-bottom{border-top:1px solid #30333a;padding-top:10px}

@media(max-width:1000px){
 .about-page .nav-links,.contact-page .nav-links{gap:.8rem}
 .about-hero-grid,.about-statement-grid,.about-career-head,.about-cap-head,.about-now-grid{grid-template-columns:1fr}.about-kicker{margin-top:6rem}.about-stats{border-left:0;border-top:1px solid var(--line);padding:1rem 0 0;display:flex;gap:2rem;margin:0}.about-statement-grid{gap:2rem}.about-statement p{max-width:520px}.about-career-head,.about-cap-head{gap:2rem}.about-cap-grid{grid-template-columns:repeat(2,1fr)}.about-personal{grid-template-columns:1fr}.about-personal-visual{min-height:55vh}.about-photo-placeholder{min-height:500px}.about-personal-copy{padding:12vw 7vw}.about-now-grid{gap:3rem}.contact-page-layout{grid-template-columns:1fr;gap:3rem;padding:5rem 0}.contact-page-copy h1{font-size:clamp(5rem,13vw,9rem)}.contact-page-form{max-width:680px}.contact-page-orbit{width:72vw;height:72vw;right:-28vw;top:18%}
}
@media(max-width:620px){
 .about-page .nav,.contact-page .nav{height:62px;padding:0 5vw;grid-template-columns:1fr auto}.about-page .nav-center,.contact-page .nav-center{display:none}.about-page .nav-links,.contact-page .nav-links{display:none}.about-hero{padding:86px 6vw 18px}.about-hero-grid{gap:3rem}.about-hero h1{font-size:clamp(4.4rem,17vw,6.8rem)}.about-lead{font-size:.88rem;margin-top:2rem}.about-stats{gap:1rem;flex-wrap:wrap}.about-stats strong{font-size:2.3rem}.about-statement,.about-career,.about-capabilities,.about-now{padding:17vw 6vw}.about-statement h2,.about-career-head h2,.about-cap-head h2{font-size:clamp(4rem,16vw,6.2rem)}.about-career-list{margin-top:3rem}.about-career-list article{grid-template-columns:35px 1fr 25px;gap:.7rem}.about-career-year{grid-column:2}.about-career-main{grid-column:2}.about-career-arrow{grid-column:3;grid-row:1 / span 3}.about-cap-grid{grid-template-columns:1fr;margin-top:3rem}.about-cap-grid article{min-height:205px}.about-personal-visual{padding:6vw;min-height:auto}.about-photo-placeholder{min-height:380px}.about-personal-copy h2{font-size:clamp(4rem,15.5vw,6.2rem)}.about-now h2{font-size:clamp(4.5rem,16vw,6.5rem)}.about-now-footer,.about-footer{flex-direction:column;gap:.8rem}.about-footer{padding:1rem 6vw}.contact-page-hero{padding:86px 6vw 18px}.contact-page-layout{padding:3rem 0;gap:3rem}.contact-page-copy h1{font-size:clamp(4.4rem,16.5vw,7rem);margin:1.5rem 0 1.8rem}.contact-page-copy>p{font-size:.82rem}.contact-page-email{font-size:.9rem}.contact-page-notes{gap:.7rem;flex-direction:column}.contact-page-form{padding:1rem}.contact-page-form input,.contact-page-form select,.contact-page-form textarea{font-size:13px}.contact-page-orbit{width:88vw;height:88vw;right:-42vw;top:25%;opacity:.75}.contact-page-bottom{gap:.8rem;flex-direction:column}.contact-page-bottom span:last-child{display:none}
}

/* =========================================================
   WORK PAGE — dedicated project archive
   Isolated from the homepage's legacy work section styles.
   ========================================================= */
.work-page{min-height:100svh;background:var(--paper);color:var(--ink)}
.work-page .nav{grid-template-columns:1fr auto 1fr}
.work-page-hero{min-height:92svh;padding:105px 6vw 24px;position:relative;overflow:hidden;display:flex;flex-direction:column;background:radial-gradient(circle at 76% 42%,rgba(36,87,255,.08),transparent 27%),linear-gradient(rgba(16,17,19,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(16,17,19,.025) 1px,transparent 1px),var(--paper);background-size:auto,112px 112px,112px 112px,auto}
.work-page-hero:after{content:'';position:absolute;width:44vw;height:44vw;right:-18vw;top:23%;border:1px solid rgba(36,87,255,.16);border-radius:50%;box-shadow:0 0 0 7vw rgba(36,87,255,.018),0 0 0 14vw rgba(36,87,255,.012);pointer-events:none}
.work-page-grid{position:absolute;inset:0;pointer-events:none;opacity:.4}
.work-page-meta,.work-page-hero-foot,.work-page-evidence-label,.work-page-footer{position:relative;z-index:2;font:8px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:#6d7069;display:flex;justify-content:space-between}
.work-page-hero-grid{position:relative;z-index:2;flex:1;display:grid;grid-template-columns:.18fr 1.22fr .45fr;gap:5vw;align-items:center;padding:4vh 0}
.work-page-index{font:8px 'DM Mono';line-height:1.7;letter-spacing:.1em;color:#70736d;align-self:start;margin-top:12vh}.work-page-index b{display:block;font:clamp(4rem,6vw,6rem) 'Manrope';font-weight:600;letter-spacing:-.1em;line-height:.8;color:var(--ink);margin-top:1rem}
.work-page-title-wrap{max-width:920px}.work-page-kicker{font:8px 'DM Mono';letter-spacing:.1em;color:#696c66}.work-page-title-wrap h1{font-size:clamp(5.5rem,9.3vw,10.5rem);line-height:.73;letter-spacing:-.12em;margin:1.6rem 0 2.3rem}.work-page-title-wrap h1 em,.work-page-section-head h2 em,.work-page-evidence h2 em,.work-page-close h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.work-page-title-wrap p{max-width:590px;font-size:.9rem;line-height:1.8;color:#62655f;margin:0}.work-page-side{border-left:1px solid var(--line);padding-left:1.3rem;display:grid;gap:2rem;align-self:end;margin-bottom:7vh}.work-page-side div{display:grid;gap:.45rem}.work-page-side span{font:7px 'DM Mono';letter-spacing:.08em;color:#80827c}.work-page-side strong{font-size:.72rem;line-height:1.45;font-weight:600;max-width:230px}.work-page-hero-foot{border-top:1px solid var(--line);padding-top:10px}
.work-page-index-section{padding:7vw 6vw 8vw;background:var(--paper2);position:relative}.work-page-index-section:before{content:'';position:absolute;inset:0;pointer-events:none;opacity:.24;background-image:radial-gradient(rgba(16,17,19,.08) .55px,transparent .55px);background-size:17px 17px}.work-page-section-head{position:relative;z-index:1;display:grid;grid-template-columns:1.2fr .45fr;gap:8vw;align-items:end}.work-page-section-head h2{font-size:clamp(4.4rem,7.3vw,8rem);line-height:.76;letter-spacing:-.12em;margin:1.2rem 0 0}.work-page-section-head>p{font-size:.82rem;line-height:1.8;color:#646760;max-width:400px;margin:0 0 .4rem}.work-page-filters{position:relative;z-index:1;margin-top:3.7rem;border-top:1px solid #bdb9b0;border-bottom:1px solid #bdb9b0;display:flex;overflow-x:auto}.work-page-filters button{border:0;background:transparent;color:#686b64;padding:.85rem 1rem .8rem 0;margin-right:1.5rem;font:8px 'DM Mono';letter-spacing:.08em;white-space:nowrap;cursor:pointer}.work-page-filters button span{color:#9a9c96;margin-left:.4rem}.work-page-filters button.is-active{color:var(--blue)}
.work-page-projects{position:relative;z-index:1;margin-top:3.2rem;display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#bdb9b0}.work-project{background:#e7e3da;display:grid;grid-template-rows:390px auto;min-width:0;transition:transform .35s ease,box-shadow .35s ease}.work-project:hover{transform:translateY(-5px);box-shadow:0 18px 35px rgba(16,17,19,.08);z-index:2}.work-project.is-featured{grid-column:1/-1;grid-template-columns:1.15fr .85fr;grid-template-rows:none;min-height:560px}.work-project.is-featured .work-project-visual{min-height:560px}.work-project.is-featured .work-project-copy{padding:2rem}.work-project-visual{position:relative;overflow:hidden;background:#cbc7bd}.work-project-image{position:absolute;inset:0;background-size:cover;background-position:center;filter:grayscale(.55) saturate(.65);transition:transform .8s ease,filter .8s ease}.work-project:hover .work-project-image{transform:scale(1.06);filter:grayscale(.08) saturate(.95)}.work-project-top,.work-project-bottom{position:absolute;z-index:2;left:1.25rem;right:1.25rem;display:flex;justify-content:space-between;align-items:center;color:#fff;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase}.work-project-top{top:1.15rem}.work-project-bottom{bottom:1.15rem;align-items:end}.work-project-bottom{flex-direction:column;align-items:flex-start;gap:.3rem}.work-project-bottom b{font-size:1rem;font-family:Manrope;letter-spacing:-.04em}.work-page-glyph{width:34px;height:34px;border:1px solid rgba(255,255,255,.58);display:grid;place-items:center;font-size:1rem}.work-project-copy{padding:1.45rem;display:flex;flex-direction:column;min-width:0}.work-project-meta{display:flex;justify-content:space-between;gap:1rem;font:8px 'DM Mono';color:#6b6e67;letter-spacing:.07em;text-transform:uppercase}.work-project-copy h3{font-size:clamp(2.7rem,4vw,4.6rem);line-height:.8;letter-spacing:-.1em;margin:1.7rem 0 .85rem}.work-project-copy>p{font-size:.8rem;line-height:1.7;color:#5d6059;max-width:500px;margin:0}.work-project-signals{display:grid;gap:.45rem;margin-top:1.7rem}.work-project-signals span{display:flex;gap:.65rem;align-items:center;font-size:.73rem;color:#444741}.work-project-signals i{font:7px 'DM Mono';color:var(--blue);font-style:normal;width:22px}.work-project-footer{margin-top:auto;padding-top:1rem;border-top:1px solid #aaa79f;display:flex;justify-content:space-between;gap:1rem;font:7px 'DM Mono';color:#777a73;letter-spacing:.07em}.work-project-footer b{font-size:1rem;color:var(--blue)}.work-page-empty{position:relative;z-index:1;padding:4rem 0;font:9px 'DM Mono';color:#73766f}
.work-page-evidence{padding:7.5vw 6vw;background:#0d1530;color:#f5f5f1;position:relative;overflow:hidden}.work-page-evidence:after{content:'';position:absolute;width:52vw;height:52vw;right:-24vw;top:-14vw;border:1px solid rgba(36,87,255,.25);border-radius:50%;box-shadow:0 0 0 9vw rgba(36,87,255,.025),0 0 0 18vw rgba(36,87,255,.018)}.work-page-evidence-label{color:#81899b}.work-page-evidence-grid{position:relative;z-index:1;margin-top:5rem;display:grid;grid-template-columns:1.05fr .65fr;gap:8vw;align-items:end}.work-page-evidence h2{font-size:clamp(4.8rem,7.8vw,8.7rem);line-height:.74;letter-spacing:-.12em;margin:1.2rem 0 0}.work-evidence-copy{max-width:500px}.work-evidence-copy p{font-size:.86rem;line-height:1.8;color:#a3aab8;margin:0}.work-evidence-flow{display:grid;grid-template-columns:auto 1fr auto 1fr auto 1fr auto;gap:.6rem;align-items:center;margin:2.4rem 0}.work-evidence-flow span{font:7px 'DM Mono';color:#dce1ea;white-space:nowrap}.work-evidence-flow i{height:1px;background:#43506a}.work-evidence-copy small{font:7px 'DM Mono';line-height:1.6;color:#758096;letter-spacing:.08em}
.work-page-close{padding:9vw 6vw;background:#f2efe7;min-height:72svh;display:flex;flex-direction:column;justify-content:center}.work-page-close>span{font:8px 'DM Mono';letter-spacing:.08em;color:var(--blue)}.work-page-close h2{font-size:clamp(4.5rem,7.8vw,8.7rem);line-height:.74;letter-spacing:-.12em;margin:2rem 0 1.8rem;max-width:1000px}.work-page-close p{font-size:.9rem;line-height:1.7;color:#666961;max-width:470px}.work-page-close a{display:flex;justify-content:space-between;align-items:center;width:min(420px,100%);margin-top:2.3rem;border-bottom:1px solid #a9a69e;padding:1rem 0;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase;color:var(--ink)}.work-page-close a b{color:var(--blue);font-size:1rem}.work-page-footer{padding:1rem 6vw;border-top:1px solid #c1bdb4}
@media(max-width:1000px){.work-page-hero-grid{grid-template-columns:1fr;gap:3rem}.work-page-index{display:none}.work-page-side{border-left:0;border-top:1px solid var(--line);padding:1rem 0 0;margin:0;display:flex;gap:2rem;flex-wrap:wrap}.work-page-side div{max-width:230px}.work-page-section-head,.work-page-evidence-grid{grid-template-columns:1fr;gap:3rem}.work-project.is-featured{grid-template-columns:1fr;grid-template-rows:1fr auto}.work-project.is-featured .work-project-visual{min-height:440px}.work-page-evidence-flow{max-width:600px}}
@media(max-width:620px){.work-page .nav{height:62px;padding:0 5vw;grid-template-columns:1fr auto}.work-page .nav-center{display:none}.work-page .nav-links{display:none}.work-page-hero{padding:86px 6vw 18px;min-height:88svh}.work-page-title-wrap h1{font-size:clamp(4.5rem,16.5vw,7rem);margin:1.3rem 0 1.7rem}.work-page-title-wrap p{font-size:.82rem}.work-page-side{display:grid;gap:1.1rem}.work-page-section-head h2,.work-page-evidence h2{font-size:clamp(4.1rem,16vw,6.3rem)}.work-page-index-section,.work-page-evidence{padding:15vw 6vw}.work-page-filters{margin-top:2.7rem}.work-page-projects{grid-template-columns:1fr;margin-top:2.5rem}.work-project,.work-project.is-featured{grid-template-columns:1fr;grid-template-rows:330px auto;min-height:0}.work-project.is-featured .work-project-visual{min-height:330px}.work-project.is-featured .work-project-copy{padding:1.25rem}.work-project-copy h3{font-size:3rem;margin:1.4rem 0 .75rem}.work-project-copy>p{font-size:.77rem}.work-project-signals{margin-top:1.4rem}.work-page-evidence-grid{margin-top:3.2rem}.work-evidence-flow{display:flex;flex-wrap:wrap;gap:.65rem}.work-evidence-flow i{display:none}.work-page-close{padding:17vw 6vw;min-height:70svh}.work-page-close h2{font-size:clamp(4.2rem,16vw,6.3rem);margin:1.5rem 0}.work-page-footer{padding:1rem 6vw;flex-direction:column;gap:.7rem}}

/* Contact / profile links */
.linkedin-link{color:inherit;transition:color .25s ease}.linkedin-link:hover{color:var(--blue)}
.contact-page-linkedin{display:inline-flex;align-items:center;justify-content:space-between;max-width:650px;padding:.8rem 0;border-bottom:1px solid #343842;margin-top:.35rem;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase;color:#aeb4c0}.contact-page-linkedin span{color:#7188e9;font-size:1rem}


/* HOMEPAGE REFINEMENT — visual polish without changing the core system */
html{scroll-behavior:smooth}
::selection{background:var(--blue);color:var(--white)}
.nav{backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.nav-links a{position:relative}
.nav-links a:after{content:'';position:absolute;left:0;right:0;bottom:-5px;height:1px;background:var(--blue);transform:scaleX(0);transform-origin:right;transition:transform .3s ease}
.nav-links a:hover:after,.nav-links a:focus-visible:after{transform:scaleX(1);transform-origin:left}
.hero-name span{display:block;text-shadow:0 1px 0 rgba(255,255,255,.18)}
.hero-role{max-width:34rem}
.hero-v7-work-note p{max-width:58ch}
.manifesto-v6,.work-v6,.proof-v6,.journey-v6,.toolkit-v6,.now-v6{overflow:hidden}
.manifesto-grid-v6,.approach-head-v6,.work-head-v6,.proof-head-v6,.journey-head-v6,.toolkit-head-v6,.now-grid-v6{position:relative}
.manifesto-grid-v6:after,.work-head-v6:after,.proof-head-v6:after,.journey-head-v6:after{content:'';position:absolute;right:0;top:-1rem;width:1px;height:5rem;background:linear-gradient(to bottom,transparent,var(--line),transparent);opacity:.7}
.section-meta{letter-spacing:.12em}
.manifesto-kicker,.blue-label{letter-spacing:.08em}
.manifesto-note p,.work-intro p,.proof-layout-v6 p,.now-grid-v6 p{max-width:62ch}
.position-system-v6{border-top:1px solid rgba(16,17,19,.12);border-bottom:1px solid rgba(16,17,19,.12);padding-top:1.25rem;padding-bottom:1.25rem}
.position-axis i{transition:transform .3s ease}
.position-system-v6:hover .position-axis i{transform:scaleX(1.35)}
.signal-node{transition:transform .35s ease,border-color .35s ease,background .35s ease}
.signal-node:hover{transform:translateY(-6px)}
.project-card-v6{transition:transform .4s ease,box-shadow .4s ease,border-color .4s ease}
.project-card-v6:hover{transform:translateY(-5px);box-shadow:0 18px 45px rgba(16,17,19,.07)}
.project-card-v6:focus-within{border-color:var(--blue)}
.work-note-v6{transition:transform .35s ease,border-color .35s ease}
.work-note-v6:hover{transform:translateX(5px);border-color:rgba(36,87,255,.4)}
.proof-v6{box-shadow:inset 0 1px rgba(255,255,255,.08),inset 0 -1px rgba(0,0,0,.12)}
.proof-chart{border:1px solid rgba(255,255,255,.11);background:rgba(255,255,255,.025);box-shadow:0 20px 60px rgba(0,0,0,.12)}
.toolkit-card-v6{transition:transform .35s ease,box-shadow .35s ease,border-color .35s ease}
.toolkit-card-v6:hover{transform:translateY(-5px);box-shadow:0 18px 45px rgba(16,17,19,.07)}
.beyond-photo-v6{filter:saturate(.78) contrast(1.03)}
.contact-link-v6{transition:color .25s ease,transform .25s ease}
.contact-link-v6:hover{color:var(--blue);transform:translateX(4px)}
.contact-form-v6 input,.contact-form-v6 select,.contact-form-v6 textarea{transition:border-color .25s ease,box-shadow .25s ease,background .25s ease}
.contact-form-v6 input:focus,.contact-form-v6 select:focus,.contact-form-v6 textarea:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(36,87,255,.08);background:rgba(255,255,255,.18)}
@media(max-width:1000px){
  .manifesto-grid-v6:after,.work-head-v6:after,.proof-head-v6:after,.journey-head-v6:after{display:none}
}
@media(max-width:620px){
  .nav-center{display:none}
  .nav{padding-inline:1rem}
  .hero-role{white-space:normal}
  .manifesto-v6,.work-v6,.proof-v6,.journey-v6,.toolkit-v6,.now-v6{padding-left:5vw;padding-right:5vw}
  .work-count{font-size:2.8rem}
}
/* Final Section 02 spacing + hierarchy pass */
@media(min-width:1101px){
  .manifesto-v8{min-height:68svh;padding-top:3vw;padding-bottom:2.3vw}
  .position-v8-grid{padding-top:2.35vw}
  .position-v8-kicker{font-size:13px;margin-bottom:.75rem}
  .position-v8-flow{margin-top:1.8vw}
}

@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.project-card-v6,.signal-node,.toolkit-card-v6,.work-note-v6,.contact-link-v6{transition:none!important;transform:none!important}}

/* HERO READABILITY PASS — final overrides */
.hero-v7-status,
.hero-v7-location,
.hero-v7-kicker,
.hero-meta-line,
.hero-v7-work-note span,
.hero-v7-float,
.hero-query-rail,
.hero-query-rail > span,
.hero-query-rail strong {
  font-size: 10px;
}

.hero-query-rail strong {
  font-size: 11px;
}

.search-console-v7 .console-top,
.search-console-v7 .console-footer,
.search-console-v7 .console-subquery,
.search-console-v7 .console-signal-label {
  font-size: 9px;
}

.search-console-v7 .console-query strong {
  font-size: clamp(1.35rem, 1.75vw, 2.1rem);
}

.hero-v7-work-note p {
  font-size: .82rem;
  line-height: 1.65;
}

.hero-v7-actions a {
  font-size: 9px;
}

@media (max-width: 1000px) {
  .hero-v7-status,
  .hero-v7-location,
  .hero-v7-kicker,
  .hero-meta-line,
  .hero-v7-work-note span,
  .hero-v7-float,
  .hero-query-rail,
  .hero-query-rail > span,
  .hero-query-rail strong {
    font-size: 10px;
  }

  .hero-query-rail strong {
    font-size: 11px;
  }

  .search-console-v7 .console-top,
  .search-console-v7 .console-footer,
  .search-console-v7 .console-subquery,
  .search-console-v7 .console-signal-label {
    font-size: 8px;
  }

  .hero-v7-work-note p {
    font-size: .8rem;
  }

  .hero-v7-actions a {
    font-size: 8px;
  }
}

@media (max-width: 620px) {
  .hero-v7-status,
  .hero-v7-location,
  .hero-v7-kicker,
  .hero-meta-line,
  .hero-v7-work-note span,
  .hero-v7-float,
  .hero-query-rail,
  .hero-query-rail > span,
  .hero-query-rail strong {
    font-size: 9px;
  }

  .hero-query-rail strong {
    font-size: 10px;
  }

  .search-console-v7 .console-top,
  .search-console-v7 .console-footer,
  .search-console-v7 .console-subquery,
  .search-console-v7 .console-signal-label {
    font-size: 7px;
  }

  .hero-v7-work-note p {
    font-size: .78rem;
    line-height: 1.6;
  }

  .hero-v7-actions a {
    font-size: 8px;
  }
}

/* HERO READABILITY PASS — signal nodes + navigation */
.nav-links a{font-size:11px}
.nav-center{font-size:9px}
.hero-signal-node{width:76px;height:76px}
.hero-signal-node span{font-size:8px;letter-spacing:.03em}
.hero-signal-node b{font-size:8px}

@media(max-width:1000px){
  .nav-links a{font-size:10px}
  .nav-center{font-size:8px}
  .hero-signal-node{width:68px;height:68px}
  .hero-signal-node span{font-size:7px}
  .hero-signal-node b{font-size:7px}
}

@media(max-width:620px){
  .nav-links{gap:1rem}
  .nav-links a{font-size:9px}
  .nav-center{display:none}
  .hero-signal-node{width:54px;height:54px}
  .hero-signal-node span{font-size:6px}
  .hero-signal-node b{font-size:6px}
}

/* HERO FINAL POLISH — hierarchy, contrast and legibility */
@media (min-width: 1001px) {
  .nav-links a { font-size: 11px; }
  .nav-center { font-size: 9.5px; }

  .hero-v7-status,
  .hero-v7-location,
  .hero-v7-kicker,
  .hero-meta-line,
  .hero-v7-work-note span,
  .hero-v7-float,
  .hero-query-rail,
  .hero-query-rail > span,
  .hero-query-rail strong { font-size: 9px; }

  .hero-query-rail strong { font-size: 10px; }
  .hero-role { font-size: clamp(1.08rem, 1.42vw, 1.55rem); font-weight: 600; }
  .hero-meta-line { font-size: 9px; }

  .search-console-v7 .console-top,
  .search-console-v7 .console-footer { font-size: 9px; }
  .search-console-v7 .console-subquery,
  .search-console-v7 .console-signal-label { font-size: 8px; }
  .console-search-icon { font-size: 16px; }

  .hero-signal-node { width: 78px; height: 78px; border-color: #85878a; }
  .hero-signal-node span { font-size: 8.5px; font-weight: 600; }
  .hero-signal-node b { font-size: 8px; margin-top: 5px; }
  .hero-signal-line { background: #969792; }
  .hero-signal-line.line-b { opacity: .24; }
  .console-signal-label { color: #68728a; }

  .hero-v7-work-note p { font-size: .78rem; line-height: 1.62; }
  .hero-v7-actions a { font-size: 9px; }
  .hero-footer-v6 { font-size: 9px; }
}

@media (max-width: 1000px) and (min-width: 621px) {
  .hero-role { font-size: 1.12rem; font-weight: 600; }
  .hero-signal-node span { font-size: 7.5px; font-weight: 600; }
  .hero-signal-node b { font-size: 7px; }
  .hero-v7-work-note p { font-size: .82rem; }
}

@media (max-width: 620px) {
  .hero-role { font-size: 1.02rem; font-weight: 600; }
  .hero-signal-node span { font-size: 6px; font-weight: 600; }
  .hero-signal-node b { font-size: 6px; }
}

/* POSITION SECTION — editorial composition pass */
.manifesto-v7{min-height:88svh;padding:6.5vw 6vw 5vw;background:var(--ink);color:var(--white);overflow:hidden}
.manifesto-layout-v7{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(360px,.62fr);gap:7vw;align-items:center;min-height:calc(88svh - 8rem);padding:3.5vw 2.5vw 2vw 0}
.manifesto-main-v7{position:relative;min-width:0}
.manifesto-main-v7 .manifesto-stamp{position:absolute;left:0;top:-.2rem;margin:0;width:108px;padding:.8rem;font-size:7px}
.manifesto-main-v7 .manifesto-kicker{margin:5.2rem 0 1rem;font-size:1rem;color:#9a9ea6}
.manifesto-main-v7 h2{font-size:clamp(4.7rem,7.3vw,8.6rem);line-height:.79;letter-spacing:-.12em;margin:0;max-width:920px}
.manifesto-main-v7 h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.095em}
.manifesto-side-v7{display:flex;flex-direction:column;gap:4.5rem;min-width:0}
.manifesto-side-v7 .manifesto-note{border-left:1px solid #363941;padding-left:1.35rem;max-width:390px}
.manifesto-side-v7 .manifesto-note>span,.position-caption>span{font:8px 'DM Mono',monospace;letter-spacing:.08em;color:var(--blue2)}
.manifesto-side-v7 .manifesto-note p{max-width:350px;color:#a0a5ae;font-size:.88rem;line-height:1.72;margin:.8rem 0 0}
.manifesto-side-v7 .tiny-signal{margin-top:1.4rem}
.position-orbit-v7{display:grid;grid-template-columns:230px minmax(0,1fr);gap:2.3rem;align-items:center}
.position-orbit-v7 .position-orbit{width:210px;height:210px;margin:0;flex:none}
.position-orbit-v7 .position-orbit>span{font-size:7px}
.position-orbit-v7 .position-caption{border-left:1px solid #363941;padding-left:1.2rem}
.position-orbit-v7 .position-caption p{font-size:.84rem;line-height:1.7;color:#a0a5ae;max-width:270px;margin:.8rem 0 0}
.position-axis-v7{margin-top:4.2rem;max-width:610px;padding-top:1.15rem;border-top:1px solid #33363e;gap:1rem;color:#858a93;font:8px 'DM Mono',monospace;letter-spacing:.08em}
.position-axis-v7 i{height:1px;width:55px;background:#3a3d45;position:relative;display:block}
.position-axis-v7 i:after{content:'';position:absolute;right:0;top:-2px;width:4px;height:4px;border-radius:50%;background:var(--blue2)}
.manifesto-v7 .section-meta{font-size:8px;color:#858a93;letter-spacing:.08em}
@media(max-width:1000px){
  .manifesto-layout-v7{grid-template-columns:1fr .72fr;gap:5vw;padding-top:5vw}
  .manifesto-main-v7 h2{font-size:clamp(4.2rem,8vw,7rem)}
  .position-orbit-v7{grid-template-columns:1fr;gap:2rem}
  .position-orbit-v7 .position-orbit{margin:0 auto}
  .position-orbit-v7 .position-caption{border-left:0;border-top:1px solid #363941;padding:1.2rem 0 0}
}
@media(max-width:620px){
  .manifesto-v7{min-height:auto;padding:17vw 6vw 16vw}
  .manifesto-layout-v7{display:block;min-height:0;padding:3rem 0 0}
  .manifesto-main-v7 .manifesto-stamp{display:none}
  .manifesto-main-v7 .manifesto-kicker{margin:0 0 1rem;font-size:.92rem}
  .manifesto-main-v7 h2{font-size:clamp(4rem,15.8vw,6.2rem)}
  .position-axis-v7{margin-top:3rem;flex-wrap:wrap;gap:.7rem .8rem}
  .position-axis-v7 i{width:34px}
  .manifesto-side-v7{margin-top:4rem;gap:3rem}
  .manifesto-side-v7 .manifesto-note{max-width:none;padding-left:0;border-left:0;border-top:1px solid #363941;padding-top:1.2rem}
  .manifesto-side-v7 .manifesto-note p{font-size:.88rem}
  .position-orbit-v7{grid-template-columns:1fr;gap:2.5rem}
  .position-orbit-v7 .position-orbit{width:190px;height:190px;margin:0 auto}
}

/* POSITION SECTION — tighter composition / final spacing pass */
.manifesto-v7{
  min-height:78svh;
  padding:5.2vw 6vw 4.8vw;
}
.manifesto-layout-v7{
  grid-template-columns:minmax(0,1.28fr) minmax(420px,.72fr);
  gap:6vw;
  align-items:start;
  min-height:0;
  padding:5vw 0 0;
}
.manifesto-main-v7{
  padding-top:.2rem;
}
.manifesto-main-v7 .manifesto-stamp{
  display:none;
}
.manifesto-main-v7 .manifesto-kicker{
  margin:0 0 1.25rem;
  font-size:.95rem;
  letter-spacing:.01em;
  color:#a2a6ae;
}
.manifesto-main-v7 h2{
  font-size:clamp(5rem,7.15vw,8.4rem);
  line-height:.78;
  max-width:940px;
}
.position-axis-v7{
  margin-top:3.2rem;
  max-width:650px;
  padding-top:1rem;
  gap:.85rem;
}
.position-axis-v7 i{width:48px}
.manifesto-side-v7{
  display:grid;
  grid-template-columns:1fr;
  gap:2.8rem;
  padding-top:.15rem;
}
.manifesto-side-v7 .manifesto-note{
  max-width:430px;
  padding-left:1.25rem;
}
.manifesto-side-v7 .manifesto-note p{
  max-width:390px;
  font-size:.9rem;
  line-height:1.68;
  margin-top:.7rem;
}
.manifesto-side-v7 .tiny-signal{margin-top:1.1rem}
.position-orbit-v7{
  grid-template-columns:180px minmax(0,1fr);
  gap:1.6rem;
  align-items:center;
  padding-top:1.1rem;
  border-top:1px solid #292d35;
}
.position-orbit-v7 .position-orbit{
  width:180px;
  height:180px;
}
.position-orbit-v7 .position-orbit>span{font-size:6.5px}
.position-orbit-v7 .position-caption{
  padding-left:1.15rem;
}
.position-orbit-v7 .position-caption p{
  max-width:290px;
  font-size:.88rem;
  line-height:1.7;
  margin-top:.65rem;
}
@media(max-width:1000px){
  .manifesto-v7{min-height:auto;padding:8vw 6vw 7vw}
  .manifesto-layout-v7{grid-template-columns:1fr;gap:4rem;padding-top:5rem}
  .manifesto-main-v7 h2{font-size:clamp(4.5rem,8vw,7rem)}
  .manifesto-side-v7{grid-template-columns:1fr 1fr;gap:3rem}
  .position-orbit-v7{grid-template-columns:1fr;gap:1.5rem;border-top:0;padding-top:0}
  .position-orbit-v7 .position-orbit{margin:0}
  .position-orbit-v7 .position-caption{border-left:1px solid #363941;border-top:0;padding:0 0 0 1.15rem}
}
@media(max-width:620px){
  .manifesto-v7{padding:16vw 6vw 15vw}
  .manifesto-layout-v7{display:block;padding-top:3rem}
  .manifesto-main-v7 .manifesto-kicker{font-size:.88rem;margin-bottom:1rem}
  .manifesto-main-v7 h2{font-size:clamp(4rem,15.8vw,6.2rem)}
  .position-axis-v7{margin-top:2.5rem}
  .manifesto-side-v7{display:flex;margin-top:4rem;gap:3rem}
  .position-orbit-v7{grid-template-columns:1fr;gap:2rem}
  .position-orbit-v7 .position-orbit{width:190px;height:190px;margin:0 auto}
  .position-orbit-v7 .position-caption{border-left:0;border-top:1px solid #363941;padding:1.1rem 0 0}
}

/* POSITION V8 — light editorial redesign */
.manifesto-v8{
  position:relative;
  min-height:68svh;
  padding:3.2vw 6vw 2.6vw;
  background:var(--paper);
  color:var(--ink);
  overflow:hidden;
  background-image:
    linear-gradient(rgba(16,17,19,.045) 1px,transparent 1px),
    linear-gradient(90deg,rgba(16,17,19,.045) 1px,transparent 1px);
  background-size:84px 84px;
}
.manifesto-v8:after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 62% 44%,rgba(36,87,255,.055),transparent 25%),linear-gradient(90deg,transparent 0 46%,rgba(16,17,19,.025) 46% 46.1%,transparent 46.1% 100%)}
.manifesto-v8:before{content:'';position:absolute;left:6vw;right:6vw;bottom:0;height:2px;background:linear-gradient(90deg,transparent 0 18%,rgba(36,87,255,.55) 18% 32%,transparent 32% 68%,rgba(36,87,255,.22) 68% 82%,transparent 82%)}
.manifesto-v8>*{position:relative;z-index:1}
.manifesto-meta-v8{color:#686b64;font-size:9px;letter-spacing:.1em}
.position-v8-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.7fr) minmax(250px,.55fr);gap:3.5vw;align-items:center;padding-top:2.7vw}
.position-v8-copy{min-width:0}
.position-v8-kicker{display:block;font:700 13px 'DM Mono',monospace;letter-spacing:.105em;margin-bottom:.9rem;color:#17191b}
.position-v8-copy h2{font-size:clamp(5rem,7.1vw,9rem);line-height:.78;letter-spacing:-.12em;margin:0;max-width:900px}
.position-v8-copy h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}
.position-v8-lead{font-size:clamp(1rem,1.15vw,1.3rem);line-height:1.55;color:#696c67;max-width:700px;margin:1.5rem 0 0}
.position-v8-visual{display:flex;justify-content:center;align-items:center;min-width:0}
.position-v8-orbit{width:min(30vw,360px);height:min(30vw,360px);min-width:280px;min-height:280px;position:relative;display:grid;place-items:center}
.position-v8-ring{position:absolute;border:1px solid rgba(36,87,255,.32);border-radius:50%;inset:0}.ring-two{inset:17%}.ring-three{inset:34%;border-color:rgba(36,87,255,.5)}
.position-v8-ring:after{content:'';position:absolute;left:50%;top:0;width:1px;height:100%;background:rgba(36,87,255,.13);transform:translateX(-50%)}
.position-v8-ring:before{content:'';position:absolute;top:50%;left:0;width:100%;height:1px;background:rgba(36,87,255,.13);transform:translateY(-50%)}
.position-v8-core{width:82px;height:82px;border:1px solid var(--blue);border-radius:50%;display:grid;place-items:center;background:rgba(247,246,241,.82);font:700 10px 'DM Mono',monospace;letter-spacing:.06em;box-shadow:0 0 0 10px rgba(36,87,255,.035),0 12px 30px rgba(16,17,19,.08)}
.orbit-label{position:absolute;font:700 11px 'DM Mono',monospace;letter-spacing:.09em;color:#16181b;white-space:nowrap}.orbit-top{top:-2%;left:50%;transform:translateX(-50%)}.orbit-right{right:-4%;top:50%;transform:translateY(-50%)}.orbit-bottom{bottom:-2%;left:50%;transform:translateX(-50%)}.orbit-left{left:-2%;top:50%;transform:translateY(-50%)}.orbit-diagonal{top:23%;left:9%;color:#4f72e6}
.orbit-dot{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 5px rgba(36,87,255,.08)}.dot-top{top:8%;left:50%;transform:translateX(-50%)}.dot-right{right:8%;top:50%;transform:translateY(-50%)}.dot-bottom{bottom:8%;left:50%;transform:translateX(-50%)}.dot-left{left:8%;top:50%;transform:translateY(-50%)}.dot-diagonal{left:25%;top:27%;width:5px;height:5px}
.position-v8-notes{display:flex;flex-direction:column;gap:1.6rem;min-width:0}.position-v8-notes article{border-left:1px solid #bdbab1;padding-left:1.25rem}.position-v8-notes span{font:700 10px 'DM Mono',monospace;letter-spacing:.09em;color:var(--blue)}.position-v8-notes p{font-size:.94rem;line-height:1.7;color:#555953;margin:.8rem 0 0;max-width:340px}
.position-v8-flow{display:grid;grid-template-columns:1fr 52px 1fr 52px 1fr 52px 1fr auto;align-items:start;gap:0;margin-top:2.2vw;padding-top:1.25rem;border-top:1px solid #bcb9b0}
.position-v8-flow article{min-width:0}.position-v8-flow article>span{display:block;font:10px 'DM Mono',monospace;color:var(--blue);margin-bottom:.45rem}.position-v8-flow strong{font:700 14px 'DM Mono',monospace;letter-spacing:.08em}.position-v8-flow p{font-size:.8rem;line-height:1.4;color:#777a74;margin:.5rem 0 0;max-width:150px}.position-v8-flow>i{height:1px;background:#aaa79e;position:relative;margin:13px 16px 0 0}.position-v8-flow>i:after{content:'';position:absolute;right:0;top:-2px;width:5px;height:5px;border-radius:50%;background:var(--blue)}.position-v8-end{display:flex;align-items:center;gap:.75rem;padding-left:.75rem}.position-v8-end b{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:#fff;font-size:1.1rem;font-weight:400;transition:background .3s,color .3s,transform .3s}.position-v8-end span{font:700 11px 'DM Mono',monospace;letter-spacing:.08em;line-height:1.5}.position-v8-end:hover b{background:var(--blue);transform:translateX(3px)}
.position-v8-end:hover span{color:var(--blue)}
.position-v8-flow article{transition:transform .3s}.position-v8-flow article:hover{transform:translateY(-4px)}
.position-v8-flow article:hover strong{color:var(--blue)}
.position-v8-orbit{transition:transform .5s ease,filter .5s ease}.position-v8-orbit:hover{transform:scale(1.025);filter:saturate(1.08)}
.orbit-dot{animation:positionPulse 2.6s ease-in-out infinite}.dot-right{animation-delay:.25s}.dot-bottom{animation-delay:.5s}.dot-left{animation-delay:.75s}.dot-diagonal{animation-delay:1s}
@keyframes positionPulse{0%,100%{opacity:.72;box-shadow:0 0 0 5px rgba(36,87,255,.08)}50%{opacity:1;box-shadow:0 0 0 8px rgba(36,87,255,.14)}}
/* Final Section 02 spacing + hierarchy pass */
@media(min-width:1101px){
  .manifesto-v8{min-height:68svh;padding-top:3vw;padding-bottom:2.3vw}
  .position-v8-grid{padding-top:2.35vw}
  .position-v8-kicker{font-size:13px;margin-bottom:.75rem}
  .position-v8-flow{margin-top:1.8vw}
}

@media(prefers-reduced-motion:reduce){.position-v8-orbit,.orbit-dot,.position-v8-flow article,.position-v8-end b{animation:none!important;transition:none!important}.position-v8-orbit:hover,.position-v8-flow article:hover,.position-v8-end:hover b{transform:none}}
@media(max-width:1100px){.manifesto-v8{min-height:auto;padding:7vw 6vw 6vw}.position-v8-grid{grid-template-columns:1.2fr .8fr;gap:5vw}.position-v8-notes{grid-column:1 / -1;display:grid;grid-template-columns:1fr 1fr;gap:3rem}.position-v8-flow{grid-template-columns:1fr 40px 1fr 40px 1fr 40px 1fr;gap:0}.position-v8-end{grid-column:1 / -1;margin-top:2rem;padding-left:0}.position-v8-orbit{width:320px;height:320px}}
@media(max-width:700px){.manifesto-v8{padding:14vw 6vw 12vw}.manifesto-meta-v8{font-size:8px}.position-v8-grid{display:block;padding-top:4rem}.position-v8-kicker{font-size:10px}.position-v8-copy h2{font-size:clamp(4.1rem,16vw,6.2rem)}.position-v8-lead{font-size:1rem;margin-top:1.5rem}.position-v8-visual{margin:4rem 0 3.5rem}.position-v8-orbit{width:250px;height:250px;min-width:250px;min-height:250px}.position-v8-core{width:68px;height:68px;font-size:9px}.orbit-label{font-size:8px}.position-v8-notes{display:flex;gap:2rem}.position-v8-notes p{font-size:.9rem}.position-v8-flow{display:flex;flex-direction:column;gap:1.1rem;margin-top:4rem}.position-v8-flow>i{width:1px;height:28px;margin:0 0 0 4px}.position-v8-flow>i:after{top:auto;bottom:0;right:-2px}.position-v8-flow article p{max-width:none}.position-v8-end{margin-top:.5rem}}

/* V9 — Section 03 visual-strength pass: tighter composition, clearer system hierarchy, richer interaction. */
.approach-v6{
  min-height:82svh;
  padding:4.8vw 6vw 3.4vw;
  background:
    radial-gradient(circle at 70% 32%,rgba(36,87,255,.14),transparent 22%),
    radial-gradient(circle at 18% 80%,rgba(255,255,255,.025),transparent 25%),
    linear-gradient(135deg,#0c1430 0%,#0f1938 58%,#0c142c 100%);
  color:#f4f5f8;
  position:relative;
  overflow:hidden;
}
.approach-v6:before{
  content:'';position:absolute;inset:0;pointer-events:none;opacity:.18;
  background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);
  background-size:112px 112px;
}
.approach-v6:after{
  content:'';position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent 0%,rgba(36,87,255,.8) 22%,rgba(36,87,255,.15) 70%,transparent 100%);opacity:.75;
}
.approach-v6>*{position:relative;z-index:1}
.approach-v6 .section-meta{color:#7d87a0;margin-bottom:1.8rem}
.approach-v6 .section-meta span:last-child{color:#68738d}
.approach-head-v6{grid-template-columns:minmax(0,1fr) minmax(330px,.48fr);gap:6vw;align-items:end}
.approach-head-v6 h2{font-size:clamp(4.2rem,6.3vw,7.1rem);line-height:.77;margin:1.1rem 0 0;letter-spacing:-.11em}
.approach-head-v6 h2 em{color:#f7f7f4}
.approach-head-v6>p{font-size:.9rem;line-height:1.7;color:#a7afc0;max-width:470px;margin:0 0 .35rem}
.approach-principle{margin-top:2.1rem;padding:1rem 0;border-top:1px solid #303b57;border-bottom:1px solid #303b57;display:grid;grid-template-columns:110px minmax(300px,1fr) 22px minmax(300px,.85fr);gap:1.3rem;align-items:center}
.approach-principle>span{font:8px 'DM Mono';letter-spacing:.1em;color:#6f83d9;text-transform:uppercase}
.approach-principle strong{font-size:1.02rem;letter-spacing:-.03em;color:#eef1f8}
.approach-principle i{font-style:normal;color:var(--blue);font-size:1.1rem}
.approach-principle p{margin:0;color:#7f899e;font-size:.74rem;line-height:1.55}
.signal-system-v6{margin-top:2.2rem;border:1px solid #34405b;display:grid;grid-template-columns:repeat(5,1fr);position:relative;background:rgba(5,10,25,.24);box-shadow:0 18px 60px rgba(0,0,0,.18);overflow:hidden}
.signal-system-v6:before{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(36,87,255,.05),transparent 22%,transparent 78%,rgba(36,87,255,.06))}
.signal-path{position:absolute;left:7%;right:7%;top:43%;height:1px;background:#3d4964;z-index:0}
.signal-path:after{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,#59657d 50%,transparent)}
.path-beam{display:block;width:16%;height:2px;background:var(--blue);box-shadow:0 0 18px rgba(36,87,255,.95);animation:pathmove 3s infinite ease-in-out}
.signal-node{min-height:260px;padding:1.05rem 1.1rem 1.05rem;display:flex;flex-direction:column;justify-content:space-between;border-right:1px solid #34405b;position:relative;z-index:1;background:linear-gradient(180deg,rgba(13,21,48,.03),rgba(13,21,48,.22));transition:background .35s,border-color .35s,transform .35s,box-shadow .35s}
.signal-node:last-child{border-right:0}
.signal-node:after{content:'';position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 42%,rgba(36,87,255,.13),transparent 38%);opacity:0;transition:opacity .35s}
.signal-node:hover,.signal-node:focus-visible,.signal-node.is-active{background:linear-gradient(180deg,rgba(36,87,255,.06),rgba(13,21,48,.42));border-color:#4c5b7d;box-shadow:inset 0 0 0 1px rgba(36,87,255,.12)}
.signal-node:hover:after,.signal-node:focus-visible:after,.signal-node.is-active:after{opacity:1}
.signal-node:focus-visible{outline:1px solid var(--blue);outline-offset:-1px}
.signal-node .node-number{position:absolute;top:1rem;left:1.1rem;font:8px 'DM Mono';color:#7890ee;letter-spacing:.08em}
.node-icon{width:42px;height:42px;border:1px solid #45526e;display:grid;place-items:center;color:#7893ff;margin-top:1.65rem;margin-bottom:0;transition:transform .35s,border-color .35s,background .35s,color .35s}
.signal-node:hover .node-icon,.signal-node:focus-visible .node-icon,.signal-node.is-active .node-icon{transform:translateY(-4px);border-color:var(--blue);background:rgba(36,87,255,.12);color:#fff}
.node-copy{margin-top:auto;padding-top:1.1rem;position:relative;z-index:2}
.signal-node strong{font-size:1.15rem;letter-spacing:-.045em;color:#f1f3f7;display:block}
.signal-node small{font:8px 'DM Mono';letter-spacing:.08em;color:#7890ee;margin-top:.28rem;text-transform:uppercase;display:block}
.signal-node p{font-size:.72rem;line-height:1.5;color:#8d96a8;max-width:190px;margin:.45rem 0 0;transition:color .3s}
.signal-node:hover p,.signal-node:focus-visible p,.signal-node.is-active p{color:#b4bdce}
.signal-node>b{font:7px 'DM Mono';letter-spacing:.08em;color:#65718a;position:absolute;right:1.1rem;bottom:1.1rem;transition:color .3s,transform .3s}
.signal-node:hover>b,.signal-node:focus-visible>b,.signal-node.is-active>b{color:#8ea5ff;transform:translateX(3px)}
@media(max-width:1000px){
  .approach-v6{min-height:auto;padding:9vw 5vw 6vw}
  .approach-head-v6{grid-template-columns:1fr;gap:1.5rem}
  .approach-head-v6>p{max-width:680px}
  .approach-principle{grid-template-columns:100px 1fr;gap:.8rem 1.1rem}
  .approach-principle i{display:none}.approach-principle p{grid-column:2}
  .signal-system-v6{grid-template-columns:repeat(5,190px);overflow:auto;margin-top:2rem}
  .signal-node{min-height:270px}
}
@media(max-width:620px){
  .approach-v6{padding:16vw 6vw 12vw}
  .approach-v6 .section-meta{margin-bottom:2rem}
  .approach-head-v6 h2{font-size:clamp(4rem,17vw,6.3rem)}
  .approach-head-v6>p{font-size:.84rem}
  .approach-principle{grid-template-columns:1fr;gap:.55rem;margin-top:2rem;padding:1rem 0}
  .approach-principle p{grid-column:auto}
  .signal-system-v6{margin-top:2rem;grid-template-columns:repeat(5,175px)}
  .signal-node{min-height:255px;padding:1rem}
}
@media(prefers-reduced-motion:reduce){
  .path-beam{animation:none}
  .signal-node,.node-icon,.signal-node>b{transition:none}
}

/* SECTION 03 — final readability + atmospheric interaction pass */
.approach-v6{
  min-height:80svh;
  padding-top:4.4vw;
  padding-bottom:3vw;
  background:
    radial-gradient(circle at 68% 42%,rgba(36,87,255,.15),transparent 20%),
    radial-gradient(circle at 86% 78%,rgba(74,104,190,.08),transparent 24%),
    radial-gradient(circle at 20% 8%,rgba(255,255,255,.025),transparent 24%),
    linear-gradient(135deg,#0b1330 0%,#0e1838 56%,#0a122b 100%);
}
.approach-v6:before{
  opacity:.20;
  background-image:
    linear-gradient(rgba(255,255,255,.075) 1px,transparent 1px),
    linear-gradient(90deg,rgba(255,255,255,.075) 1px,transparent 1px),
    radial-gradient(circle at 1px 1px,rgba(117,144,255,.13) 1px,transparent 1px);
  background-size:112px 112px,112px 112px,28px 28px;
  animation:approachGridDrift 18s linear infinite;
}
.approach-v6:after{
  height:2px;
  background:linear-gradient(90deg,transparent 0%,rgba(36,87,255,.85) 20%,rgba(117,144,255,.2) 52%,rgba(36,87,255,.08) 78%,transparent 100%);
}
.approach-v6 .section-meta{
  margin-bottom:1.35rem;
  color:#98a4bd;
  font-size:9.5px;
  letter-spacing:.105em;
}
.approach-v6 .section-meta span:last-child{color:#8792ab}
.approach-v6 .blue-label{
  font-size:10.5px;
  letter-spacing:.11em;
}
.approach-head-v6 h2{
  margin-top:.8rem;
}
.approach-head-v6>p{
  font-size:.93rem;
  line-height:1.72;
  color:#b1b9c9;
  max-width:490px;
}
.approach-principle{
  margin-top:1.75rem;
  padding:1rem 0 .95rem;
}
.approach-principle>span{
  font-size:9px;
  color:#7892f4;
}
.approach-principle strong{
  font-size:1.08rem;
}
.approach-principle p{
  font-size:.79rem;
  line-height:1.6;
  color:#8e99ae;
}
.signal-system-v6{
  margin-top:2rem;
  background:
    linear-gradient(180deg,rgba(255,255,255,.012),rgba(5,10,25,.20)),
    rgba(5,10,25,.24);
  box-shadow:0 20px 70px rgba(0,0,0,.20),inset 0 1px 0 rgba(255,255,255,.025);
}
.signal-system-v6:after{
  content:'';
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(90deg,transparent 0%,rgba(36,87,255,.045) 48%,transparent 100%);
  transform:translateX(-100%);
  animation:systemSweep 7s ease-in-out infinite;
}
.signal-path{top:43%}
.path-beam{
  width:14%;
  transition:transform .65s cubic-bezier(.22,1,.36,1),width .45s ease;
}
.signal-node{
  min-height:248px;
  padding:1rem 1.1rem 1rem;
  background:linear-gradient(180deg,rgba(13,21,48,.025),rgba(13,21,48,.24));
}
.signal-node .node-number{
  top:1rem;
  left:1.1rem;
  font-size:9px;
}
.node-icon{
  width:44px;
  height:44px;
}
.signal-node strong{font-size:1.22rem}
.signal-node small{
  font-size:9px;
  margin-top:.3rem;
}
.signal-node p{
  font-size:.76rem;
  line-height:1.52;
  color:#98a2b5;
  margin-top:.42rem;
}
.signal-node>b{
  font-size:8px;
  right:1.1rem;
  bottom:1rem;
}
.signal-node:hover,
.signal-node:focus-visible,
.signal-node.is-active{
  transform:translateY(-2px);
}
.signal-node:hover .node-number,
.signal-node:focus-visible .node-number,
.signal-node.is-active .node-number,
.signal-node:hover strong,
.signal-node:focus-visible strong,
.signal-node.is-active strong{
  color:#f8f9fc;
}

@keyframes approachGridDrift{
  0%{background-position:0 0,0 0,0 0}
  100%{background-position:112px 56px,56px 112px,28px 28px}
}
@keyframes systemSweep{
  0%,58%{transform:translateX(-110%);opacity:0}
  68%{opacity:1}
  82%,100%{transform:translateX(110%);opacity:0}
}

@media(max-width:1000px){
  .approach-v6{min-height:auto;padding-top:7vw;padding-bottom:6vw}
  .approach-v6 .section-meta{font-size:9px}
  .approach-v6 .blue-label{font-size:10px}
  .approach-head-v6>p{font-size:.9rem}
  .signal-node{min-height:265px}
}
@media(max-width:620px){
  .approach-v6{padding-top:14vw;padding-bottom:11vw}
  .approach-v6 .section-meta{font-size:8.5px;margin-bottom:1.6rem}
  .approach-v6 .blue-label{font-size:9.5px}
  .approach-head-v6>p{font-size:.86rem;line-height:1.65}
  .approach-principle{margin-top:1.7rem}
  .approach-principle>span{font-size:8.5px}
  .approach-principle strong{font-size:1rem}
  .approach-principle p{font-size:.76rem}
  .signal-node{min-height:255px}
  .signal-node .node-number{font-size:8.5px}
  .signal-node strong{font-size:1.16rem}
  .signal-node small{font-size:8.5px}
  .signal-node p{font-size:.74rem}
}
@media(prefers-reduced-motion:reduce){
  .approach-v6:before,.signal-system-v6:after{animation:none}
  .path-beam{transition:none}
}

/* Signal beam follows the stage being explored. */
.signal-system-v6.is-interacting .path-beam{
  animation:none;
  transform:translateX(calc(var(--active-signal,0) * 615%));
  width:14%;
}
@media(prefers-reduced-motion:reduce){.signal-system-v6.is-interacting .path-beam{transform:none}}


/* Section 04 — selected work refinements */
.work-v6{padding-top:6.2vw;padding-bottom:6.2vw}
.work-head-v6{gap:6vw}
.work-head-v6 h2{max-width:720px}
.work-intro p{font-size:.88rem;line-height:1.75;max-width:430px}
.work-count{font-size:4.6rem}
.work-count span{font-size:9px}
.projects-v6{margin-top:4.5rem}
.project-card-v6{min-height:600px;border:1px solid transparent}
.project-card-v6.is-hovered{box-shadow:0 20px 55px rgba(16,17,19,.09)}
.project-image-v6{display:block;width:100%;height:100%;object-fit:cover;object-position:center;filter:grayscale(.55) saturate(.62);transition:transform .8s ease,filter .8s ease}
.project-card-v6.is-hovered .project-image-v6{transform:scale(1.045);filter:grayscale(.04) saturate(1)}
.project-smartmove2uk .project-image-v6{object-fit:contain;padding:12%;background:#f4f0e8;filter:none}
.project-smartmove2uk.is-hovered .project-image-v6{filter:none;transform:scale(1.02)}
.project-eduguide .project-image-v6{object-position:center 42%}
.project-keystone .project-image-v6{object-position:center}
.project-student-housing .project-image-v6{object-position:center 50%}
.project-lucero-panama-homes{grid-column:1/-1;grid-template-columns:1.15fr .85fr;grid-template-rows:none;min-height:500px}
.project-lucero-panama-homes .project-copy-v6{order:-1}
.project-copy-v6{padding:1.65rem}
.project-copy-v6 h3{font-size:clamp(2.8rem,4vw,4.5rem);line-height:.84;margin:1.35rem 0 .9rem}
.project-copy-v6 p{font-size:.84rem;line-height:1.65;max-width:500px}
.project-topline-v6,.project-open-v6{font-size:9px}
.tag-row-v6 span{font-size:8px}
.project-open-v6{padding-top:1.05rem}
.work-note-v6{margin-top:3.2rem}
@media(max-width:1000px){.work-v6{padding-top:11vw}.projects-v6{margin-top:4rem}.project-lucero-panama-homes{grid-column:auto;grid-template-columns:1fr;grid-template-rows:1.05fr .95fr}.project-lucero-panama-homes .project-copy-v6{order:initial}}
@media(max-width:620px){.work-v6{padding-top:17vw}.work-head-v6{gap:2.5rem}.work-intro p{font-size:.82rem}.work-count{font-size:3.5rem}.projects-v6{margin-top:3.2rem}.project-card-v6{min-height:560px}.project-lucero-panama-homes{min-height:560px}.project-copy-v6 h3{font-size:3.2rem}}


/* SECTION 04 — final hierarchy, readability and tighter vertical rhythm */
@media (min-width:621px){
  .work-v6{padding-top:3.9vw;padding-bottom:4.4vw}
  .work-head-v6{gap:3.6vw}
  .work-head-v6 h2{font-size:clamp(3.8rem,5.8vw,6.5rem);margin-top:1.15rem}
  .work-intro{gap:1.25rem}
  .work-count{font-size:4.1rem}
  .work-intro p{font-size:.88rem;line-height:1.62;max-width:390px}
  .projects-v6{margin-top:2.8rem}
}

.work-head-v6 .blue-label{font-size:10px}
.project-browser-v6{position:absolute;z-index:3;left:0;right:0;top:0;height:29px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.6rem;padding:0 .75rem;background:rgba(13,21,48,.72);backdrop-filter:blur(8px);color:#eef1f6;font:7px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase}
.project-browser-v6 i{width:5px;height:5px;border-radius:50%;background:#7f91c8;box-shadow:10px 0 0 #59698f,20px 0 0 #414f70}
.project-browser-v6 b{font-weight:400;color:#aab4cb;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.project-image-v6{padding-top:0!important}
.project-smartmove2uk .project-image-v6{object-fit:contain;padding:10% 13% 9%!important;background:#f4f0e8}
.project-smartmove2uk .project-visual-v6{background:#f4f0e8}
.project-smartmove2uk .project-browser-v6{background:rgba(16,17,19,.9)}
.project-copy-v6{padding:1.8rem 1.7rem 1.55rem}
.project-copy-v6 h3{margin:1.05rem 0 .8rem}
.project-detail-label{font-size:8.5px}
.project-copy-v6 p{font-size:.87rem;line-height:1.62;max-width:520px}
.project-topline-v6{font-size:9.5px}
.tag-row-v6 span{font-size:8.5px;padding:.38rem .55rem}
.project-open-v6{font-size:8.5px;padding-top:1rem}
.work-note-v6{margin-top:2.5rem!important;padding:1.25rem 1.45rem!important;grid-template-columns:44px 1.15fr .85fr!important;gap:1.25rem!important;background:#11141b!important;color:#f7f5ee;border:1px solid #11141b;border-top:2px solid var(--blue);box-shadow:0 14px 35px rgba(16,17,19,.12)}
.work-note-v6 .note-icon{border-color:rgba(255,255,255,.35);color:#fff}
.work-note-v6 span{color:#8ea5ff!important;opacity:1!important;font-size:8.5px}
.work-note-v6 strong{color:#fff;font-size:1.35rem;line-height:1.15}
.work-note-v6 p{color:#c8cdd6;font-size:.8rem;line-height:1.58}
@media(max-width:1000px){
  .work-v6{padding-top:8vw}
  .work-head-v6 h2{margin-top:1rem}
  .projects-v6{margin-top:2.8rem}
  .project-browser-v6{height:27px}
}
@media(max-width:620px){
  .work-v6{padding-top:12vw;padding-bottom:12vw}
  .work-head-v6{gap:1.5rem}
  .work-head-v6 h2{margin-top:1rem}
  .projects-v6{margin-top:2.5rem}
  .project-card-v6{min-height:560px}
  .project-copy-v6{padding:1.45rem 1.3rem}
  .project-copy-v6 p{font-size:.84rem}
  .project-browser-v6{height:26px;font-size:6.5px}
  .work-note-v6{margin-top:2rem!important;padding:1.15rem 1.1rem!important;grid-template-columns:34px 1fr!important}
  .work-note-v6 p{grid-column:2;font-size:.76rem}
  .work-note-v6 strong{font-size:1.15rem}
}

/* CAREER / final compact pass */
@media (min-width:621px){
  .journey-v6{padding-top:4vw;padding-bottom:4vw;}
  .journey-head-v6 h2{margin-top:1.2rem;}
  .career-landscape-v6{margin-top:2.2rem;}
  .career-card-v6{min-height:300px;padding:1.05rem 1.15rem 1.1rem;}
  .career-card-node{margin:1rem 0 1.55rem;}
  .career-card-v6 h3{margin:.6rem 0 .45rem;}
  .career-card-v6 p{font-size:.72rem;line-height:1.55;margin-top:.7rem;}
  .career-card-v6>em{padding-top:.8rem;}
}
@media (max-width:1000px) and (min-width:621px){
  .career-card-v6{min-height:310px;}
}
@media (max-width:620px){
  .journey-v6{padding-top:13vw;padding-bottom:13vw;}
  .career-landscape-v6{margin-top:2.5rem;}
  .career-card-v6{min-height:280px;}
}

/* Career readability pass — preserve compact height while improving scanability. */
@media (min-width:621px){
  .journey-v6{padding-top:3.2vw;padding-bottom:3.2vw;}
  .career-landscape-v6{margin-top:1.8rem;}
  .career-card-v6{min-height:285px;padding:1rem 1.15rem 1rem;}
  .career-card-top{font-size:9px;}
  .career-card-node{margin:1rem 0 1.7rem;}
  .career-stage{font-size:9px;}
  .career-card-v6 h3{margin:.58rem 0 .5rem;}
  .career-card-v6 strong{font-size:10px;}
  .career-card-v6 p{font-size:.82rem;line-height:1.58;margin-top:.7rem;max-width:290px;}
  .career-card-v6>em{font-size:8px;padding-top:.7rem;}
}
@media (max-width:1000px) and (min-width:621px){
  .career-card-v6{min-height:295px;}
}
@media (max-width:620px){
  .journey-v6{padding-top:11vw;padding-bottom:11vw;}
  .career-landscape-v6{margin-top:2.2rem;}
  .career-card-v6{min-height:295px;}
  .career-card-top{font-size:9px;}
  .career-stage{font-size:9px;}
  .career-card-v6 strong{font-size:10px;}
  .career-card-v6 p{font-size:.82rem;line-height:1.6;}
  .career-card-v6>em{font-size:8px;}
}


/* Section 06 — Search Evolution */
.evolution-v6{
  position:relative;
  background:
    radial-gradient(circle at 78% 18%,rgba(36,87,255,.08),transparent 24%),
    linear-gradient(90deg,transparent 0 49.95%,rgba(16,17,19,.035) 50%,transparent 50.05%),
    var(--paper2);
  color:var(--ink);
  padding:4.4vw 6vw 4.8vw;
  overflow:hidden;
  isolation:isolate;
}
.evolution-v6:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  z-index:-1;
  background:radial-gradient(circle at 26% 76%,rgba(36,87,255,.055),transparent 22%);
}
.evolution-meta{color:var(--blue);position:relative;z-index:2;font-size:9px;letter-spacing:.08em}
.evolution-head-v6{position:relative;z-index:2;display:grid;grid-template-columns:1fr .45fr;gap:8vw;align-items:end}
.evolution-head-v6 h2{margin:2rem 0 0;font-size:clamp(4.1rem,6.8vw,7.5rem);line-height:.8;color:var(--ink)}
.evolution-head-v6 h2 em{color:var(--ink)}
.evolution-head-v6 p{font-size:.94rem;line-height:1.7;color:#5f625f;max-width:500px;margin:0}

.evolution-track-v6{
  position:relative;
  z-index:2;
  margin-top:3.6rem;
  display:grid;
  grid-template-columns:repeat(4,1fr);
}
.evo-connection{
  position:absolute;
  left:8%;
  right:8%;
  top:67%;
  height:1px;
  background:rgba(16,17,19,.18);
  pointer-events:none;
}
.evo-connection span{
  position:absolute;
  left:0;
  top:-1px;
  width:18%;
  height:2px;
  background:var(--blue);
  box-shadow:0 0 14px rgba(36,87,255,.3);
  animation:evoSignal 4.8s cubic-bezier(.4,0,.2,1) infinite;
}
@keyframes evoSignal{
  0%{left:0;opacity:0}
  10%{opacity:1}
  78%{opacity:1}
  100%{left:82%;opacity:0}
}

.evo-step-v6{
  position:relative;
  min-height:255px;
  padding:1.1rem 1.35rem 1.2rem;
  display:flex;
  flex-direction:column;
  background:transparent;
  color:var(--ink);
  cursor:default;
  outline:none;
  transition:transform .4s cubic-bezier(.2,.7,.2,1);
}
.evo-icon{
  width:50px;
  height:50px;
  border:1px solid rgba(16,17,19,.35);
  border-radius:50%;
  display:grid;
  place-items:center;
  margin-bottom:auto;
  position:relative;
  z-index:2;
  background:rgba(238,235,227,.45);
  transition:transform .45s cubic-bezier(.2,.7,.2,1),border-color .3s ease,color .3s ease;
}
.evo-step-v6>span{
  font:9px 'DM Mono';
  letter-spacing:.08em;
  color:#666a63;
  position:relative;
  z-index:2;
  transition:color .3s ease;
}
.evo-step-v6>b{
  position:relative;
  z-index:2;
  font-size:clamp(3.8rem,5.4vw,6.2rem);
  line-height:.76;
  letter-spacing:-.12em;
  margin-top:.7rem;
  transition:color .3s ease,transform .4s cubic-bezier(.2,.7,.2,1),letter-spacing .4s ease;
}
.evo-step-v6>small{
  position:relative;
  z-index:2;
  font:9px 'DM Mono';
  letter-spacing:.08em;
  margin-top:.9rem;
  color:#555952;
  transition:color .3s ease;
}
.evo-step-v6>p{
  position:relative;
  z-index:2;
  max-width:240px;
  font-size:.78rem;
  line-height:1.55;
  color:#6b6e67;
  margin:.65rem 0 0;
  opacity:.72;
  transform:translateY(4px);
  transition:color .3s ease,opacity .35s ease,transform .35s ease;
}
.evo-step-v6>i{
  position:absolute;
  right:-.6rem;
  top:67%;
  font-style:normal;
  font-size:1.1rem;
  color:var(--blue);
  z-index:6;
  transition:transform .3s ease,color .3s ease;
}
.evo-step-v6>em{
  position:relative;
  z-index:2;
  font:8px 'DM Mono';
  font-style:normal;
  letter-spacing:.08em;
  margin-top:.45rem;
  color:#777b74;
  transition:color .3s ease;
}
.evo-progress{
  position:absolute;
  left:1.35rem;
  right:1.35rem;
  bottom:0;
  width:auto;
  height:2px;
  background:var(--blue);
  transform:scaleX(0);
  transform-origin:left;
  transition:transform .5s cubic-bezier(.2,.7,.2,1);
}

/* Hover = color emphasis only. No cards, panels or background fills. */
.evo-step-v6:hover,
.evo-step-v6:focus-visible{
  transform:translateY(-4px);
}
.evo-step-v6:hover .evo-icon,
.evo-step-v6:focus-visible .evo-icon{
  color:var(--blue);
  border-color:var(--blue);
  transform:scale(1.08);
}
.evo-step-v6:hover .evo-icon svg,
.evo-step-v6:focus-visible .evo-icon svg{
  stroke:var(--blue);
}
.evo-step-v6:hover>span,
.evo-step-v6:focus-visible>span,
.evo-step-v6:hover>b,
.evo-step-v6:focus-visible>b,
.evo-step-v6:hover>small,
.evo-step-v6:focus-visible>small,
.evo-step-v6:hover>em,
.evo-step-v6:focus-visible>em{
  color:var(--blue);
}
.evo-step-v6:hover>b,
.evo-step-v6:focus-visible>b{
  transform:translateX(4px);
  letter-spacing:-.1em;
}
.evo-step-v6:hover>p,
.evo-step-v6:focus-visible>p{
  color:var(--ink);
  opacity:1;
  transform:translateY(0);
}
.evo-step-v6:hover>i,
.evo-step-v6:focus-visible>i{
  color:var(--blue);
  transform:translateX(5px);
}
.evo-step-v6:hover .evo-progress,
.evo-step-v6:focus-visible .evo-progress{
  transform:scaleX(1);
}

@media(max-width:1000px){
  .evolution-v6{padding:7vw 6vw}
  .evolution-head-v6{grid-template-columns:1fr;gap:2rem}
  .evolution-head-v6 p{max-width:620px}
  .evolution-track-v6{grid-template-columns:1fr 1fr;margin-top:3rem}
  .evo-connection{display:none}
}
@media(max-width:620px){
  .evolution-v6{padding:11vw 6vw}
  .evolution-head-v6 h2{font-size:clamp(3.7rem,15vw,5.7rem)}
  .evolution-head-v6 p{font-size:.88rem}
  .evolution-track-v6{grid-template-columns:1fr;margin-top:2.6rem}
  .evo-step-v6{min-height:205px}
  .evo-step-v6>b{font-size:clamp(3.8rem,16vw,5.5rem)}
  .evo-step-v6>p{opacity:.82;transform:none}
  .evo-connection{display:none}
}
@media(prefers-reduced-motion:reduce){
  .evo-connection span{animation:none}
  .evo-step-v6,.evo-icon,.evo-progress,.evo-step-v6>b,.evo-step-v6>p{transition:none!important}
}

/* Toolkit v19 — reference-matched, readable, compact, and interaction-safe. */
.toolkit-v18{position:relative;padding:3vw 5.5vw 1.4vw;background:var(--paper);overflow:hidden}
.toolkit-v18-head{display:grid;grid-template-columns:120px minmax(0,1fr) 270px;gap:3vw;align-items:start;padding-bottom:1.4vw}
.toolkit-v18-index,.toolkit-v18-note,.toolkit-v18-node-top,.toolkit-v18-node-content>em,.toolkit-v18-tools small,.toolkit-v18-foot{font-family:'DM Mono',monospace}
.toolkit-v18-index{font-size:10px;color:#686c65;padding-top:.34rem;text-transform:uppercase;letter-spacing:.06em}
.toolkit-v18-title p{margin:0 0 .55rem;font:10px 'DM Mono',monospace;color:var(--blue);letter-spacing:.11em;text-transform:uppercase}
.toolkit-v18-title h2{margin:0;font-size:clamp(4rem,5.8vw,6.35rem);line-height:.82;letter-spacing:-.095em;font-weight:700}
.toolkit-v18-title h2 em{font-weight:400}
.toolkit-v18-note{padding-top:.15rem;font-size:10px;line-height:1.55;color:#565b54;letter-spacing:.01em}
.toolkit-v18-note span{display:block;margin-bottom:.55rem;font-size:9px;color:var(--blue);text-transform:uppercase;letter-spacing:.1em}
.toolkit-v18-note p{margin:0;max-width:31ch}

.toolkit-v18-stage{position:relative;height:410px;border-top:1px solid rgba(16,17,19,.14);border-bottom:1px solid rgba(16,17,19,.14);overflow:visible}
.toolkit-v18-stage:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(36,87,255,.045),transparent 25%);pointer-events:none}
.toolkit-v18-axis{position:absolute;background:rgba(16,17,19,.075);pointer-events:none;z-index:0}
.toolkit-v18-axis.axis-x{height:1px;left:7%;right:7%;top:50%}
.toolkit-v18-axis.axis-y{width:1px;top:4%;bottom:4%;left:50%}
.toolkit-v18-orbit{position:absolute;left:50%;top:50%;border:1px solid rgba(16,17,19,.11);border-radius:50%;transform:translate(-50%,-50%);pointer-events:none}
.toolkit-v18-orbit.orbit-outer{width:350px;height:350px;border-style:dashed;opacity:.6;animation:toolkit18Spin 38s linear infinite}
.toolkit-v18-orbit.orbit-mid{width:252px;height:252px}
.toolkit-v18-orbit.orbit-inner{width:154px;height:154px;opacity:.78}
.toolkit-v18-points{position:absolute;left:50%;top:50%;width:350px;height:350px;transform:translate(-50%,-50%);z-index:1;pointer-events:none}
.toolkit-v18-points i{position:absolute;width:5px;height:5px;border-radius:50%;background:var(--blue);animation:toolkit18Pulse 2.8s ease-in-out infinite}
.toolkit-v18-points i:nth-child(1){left:50%;top:-2px;transform:translateX(-50%)}
.toolkit-v18-points i:nth-child(2){right:-2px;top:50%;transform:translateY(-50%);animation-delay:.7s}
.toolkit-v18-points i:nth-child(3){left:50%;bottom:-2px;transform:translateX(-50%);animation-delay:1.4s}
.toolkit-v18-points i:nth-child(4){left:-2px;top:50%;transform:translateY(-50%);animation-delay:2.1s}
.toolkit-v18-connectors{position:absolute;inset:0;pointer-events:none;z-index:2}
.toolkit-v18-connectors i{position:absolute;height:1px;width:58px;background:rgba(16,17,19,.14);transform-origin:left center;transition:width .4s ease,background .3s}
.toolkit-v18-connectors i:nth-child(1){left:calc(6.5% + 320px);top:31%}
.toolkit-v18-connectors i:nth-child(2){right:calc(6.5% + 320px);top:31%;transform:rotate(180deg)}
.toolkit-v18-connectors i:nth-child(3){left:calc(6.5% + 320px);top:69%}
.toolkit-v18-connectors i:nth-child(4){right:calc(6.5% + 320px);top:69%;transform:rotate(180deg)}

.toolkit-v18-core{position:absolute;left:50%;top:50%;width:92px;height:92px;transform:translate(-50%,-50%);border:1px solid rgba(16,17,19,.25);border-radius:50%;background:var(--paper);box-shadow:0 0 0 9px var(--paper),0 0 28px rgba(36,87,255,.025);z-index:3;display:grid;place-items:center;text-align:center;transition:box-shadow .4s,transform .4s}
.toolkit-v18-core:before,.toolkit-v18-core:after{content:"";position:absolute;border:1px solid rgba(16,17,19,.1);border-radius:50%}
.toolkit-v18-core:before{inset:-12px}.toolkit-v18-core:after{inset:-21px;opacity:.65}
.toolkit-v18-core strong{font:700 21px Arial,sans-serif;letter-spacing:-.08em;transform:translateY(-2px)}
.toolkit-v18-core small{position:absolute;top:16px;max-width:74px;font:6px 'DM Mono',monospace;line-height:1.25;letter-spacing:.05em;color:#777c74;text-transform:uppercase}
.toolkit-v18-core span{position:absolute;bottom:16px;font:7px 'DM Mono',monospace;letter-spacing:.08em;color:#5f635d;text-transform:uppercase;transition:color .25s}
.toolkit-v18-core i{position:absolute;bottom:7px;width:12px;height:2px;background:var(--blue)}
.toolkit-v18-core.is-active{box-shadow:0 0 0 9px var(--paper),0 0 38px rgba(36,87,255,.08)}
.toolkit-v18-core.is-active span{color:var(--blue)}

.toolkit-v18-node{position:absolute;width:390px;height:174px;padding:.78rem 1rem;text-align:left;border:1px solid rgba(16,17,19,.17);border-radius:2px;background:rgba(250,249,245,.96);color:var(--ink);font:inherit;cursor:pointer;z-index:4;outline:none;backdrop-filter:blur(3px);overflow:hidden;transition:transform .35s cubic-bezier(.2,.7,.2,1),border-color .25s,background .25s,box-shadow .25s}
.toolkit-v18-node.node-1{left:6.5%;top:4%}.toolkit-v18-node.node-2{right:6.5%;top:4%}.toolkit-v18-node.node-3{left:6.5%;bottom:4%}.toolkit-v18-node.node-4{right:6.5%;bottom:4%}
.toolkit-v18-node:after{content:"";position:absolute;top:50%;width:58px;height:1px;background:rgba(16,17,19,.14);transition:width .4s,background .3s}
.toolkit-v18-node.node-1:after,.toolkit-v18-node.node-3:after{right:-58px}.toolkit-v18-node.node-2:after,.toolkit-v18-node.node-4:after{left:-58px}
.toolkit-v18-node-top{display:flex;align-items:center;justify-content:space-between;font-size:9px;color:var(--blue);text-transform:uppercase;letter-spacing:.06em}
.toolkit-v18-node-top i{font:400 16px Arial,sans-serif;color:#7c8079;transition:transform .3s,color .25s}
.toolkit-v18-node-content{display:block;margin-top:.45rem}
.toolkit-v18-node-icon{display:block;width:24px;height:22px;color:#555a53;margin-bottom:.2rem}.toolkit-v18-node-icon svg{width:20px;height:20px}
.toolkit-v18-node-content>strong{display:block;margin:0 0 .18rem;font-size:2.15rem;line-height:.92;letter-spacing:-.07em;font-weight:650;transition:color .25s,transform .3s}
.toolkit-v18-node-content>em{display:block;margin:0 0 .55rem;font-size:9px;line-height:1.2;color:#62665f;font-style:normal;text-transform:uppercase;letter-spacing:.06em}
.toolkit-v18-tools{display:flex;flex-wrap:wrap;align-items:flex-start;gap:.3rem;max-width:100%}
.toolkit-v18-tools small{display:inline-flex;align-items:center;min-height:22px;padding:.27rem .45rem;border:1px solid rgba(16,17,19,.15);color:#4f544d;background:rgba(255,255,255,.2);font-size:9.5px;line-height:1.15;letter-spacing:0;white-space:nowrap;transition:color .25s,border-color .25s,background .25s,transform .25s}
.toolkit-v18-node:hover,.toolkit-v18-node:focus-visible,.toolkit-v18-node.is-active{transform:translateY(-3px);border-color:rgba(36,87,255,.48);background:#fff;box-shadow:0 12px 25px rgba(16,17,19,.055)}
.toolkit-v18-node:hover:after,.toolkit-v18-node:focus-visible:after,.toolkit-v18-node.is-active:after{width:78px;background:rgba(36,87,255,.48)}
.toolkit-v18-node:hover .toolkit-v18-node-top i,.toolkit-v18-node:focus-visible .toolkit-v18-node-top i,.toolkit-v18-node.is-active .toolkit-v18-node-top i{color:var(--blue);transform:translate(2px,-2px)}
.toolkit-v18-node:hover .toolkit-v18-node-content>strong,.toolkit-v18-node:focus-visible .toolkit-v18-node-content>strong,.toolkit-v18-node.is-active .toolkit-v18-node-content>strong{color:var(--blue);transform:translateX(2px)}
.toolkit-v18-node:hover .toolkit-v18-tools small,.toolkit-v18-node:focus-visible .toolkit-v18-tools small,.toolkit-v18-node.is-active .toolkit-v18-tools small{color:#30457f;border-color:rgba(36,87,255,.3);background:rgba(36,87,255,.035);transform:translateY(-1px)}
.toolkit-v18-foot{display:flex;align-items:center;justify-content:space-between;margin-top:.58vw;font-size:9px;color:#686c65;text-transform:uppercase;letter-spacing:.06em}.toolkit-v18-foot div{display:flex;align-items:center;gap:.58rem}.toolkit-v18-foot i{font-style:normal;color:var(--blue)}.toolkit-v18-foot strong{font-size:9px;color:var(--ink);font-weight:600;line-height:1.5;text-align:right;letter-spacing:.035em}.toolkit-v18-foot strong span{color:#70746d}

@keyframes toolkit18Spin{to{transform:translate(-50%,-50%) rotate(360deg)}}
@keyframes toolkit18Pulse{0%,100%{box-shadow:0 0 0 0 rgba(36,87,255,.18);opacity:.72}50%{box-shadow:0 0 0 7px rgba(36,87,255,0);opacity:1}}

@media(max-width:1100px){
 .toolkit-v18{padding:5vw 6vw 3vw}.toolkit-v18-head{grid-template-columns:90px minmax(0,1fr) 220px}.toolkit-v18-stage{height:405px}.toolkit-v18-node{width:31vw;max-width:350px;height:174px}.toolkit-v18-node.node-1,.toolkit-v18-node.node-3{left:1.5%}.toolkit-v18-node.node-2,.toolkit-v18-node.node-4{right:1.5%}.toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:340px;height:340px}.toolkit-v18-connectors i:nth-child(1),.toolkit-v18-connectors i:nth-child(3){left:calc(1.5% + 31vw)}.toolkit-v18-connectors i:nth-child(2),.toolkit-v18-connectors i:nth-child(4){right:calc(1.5% + 31vw)}}
@media(max-width:820px){
 .toolkit-v18-head{grid-template-columns:80px minmax(0,1fr)}.toolkit-v18-note{grid-column:2;margin-top:.9rem}.toolkit-v18-stage{height:450px}.toolkit-v18-node{width:30vw;max-width:none;height:184px}.toolkit-v18-node-content>strong{font-size:2rem}.toolkit-v18-tools small{font-size:9px;min-height:20px}.toolkit-v18-connectors{display:none}}
@media(max-width:620px){
 .toolkit-v18{padding:10vw 6vw 7vw}.toolkit-v18-head{display:block;padding-bottom:5vw}.toolkit-v18-index{margin-bottom:1.25rem}.toolkit-v18-title h2{font-size:clamp(3.45rem,14.5vw,5.1rem)}.toolkit-v18-note{margin-top:1.4rem;font-size:9px}.toolkit-v18-stage{height:660px;overflow:visible}.toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:250px;height:250px}.toolkit-v18-orbit.orbit-mid{width:188px;height:188px}.toolkit-v18-orbit.orbit-inner{width:128px;height:128px}.toolkit-v18-core{width:88px;height:88px}.toolkit-v18-node{width:calc(50% - 6px);height:212px;padding:.65rem}.toolkit-v18-node.node-1,.toolkit-v18-node.node-2{top:3%}.toolkit-v18-node.node-3,.toolkit-v18-node.node-4{bottom:3%}.toolkit-v18-node:after{display:none}.toolkit-v18-node-content{margin-top:.48rem}.toolkit-v18-node-content>strong{font-size:1.62rem}.toolkit-v18-node-content>em{font-size:7px;line-height:1.35;margin-bottom:.42rem}.toolkit-v18-tools{gap:.18rem}.toolkit-v18-tools small{font-size:7.5px;padding:.24rem .3rem;min-height:18px;white-space:normal}.toolkit-v18-foot{display:block;font-size:8px;line-height:1.8}.toolkit-v18-foot strong{display:block;margin-top:.65rem;font-size:8.5px;text-align:left}}
@media(prefers-reduced-motion:reduce){.toolkit-v18 *{animation:none!important;transition:none!important}}

/* =========================================================
   NOW — compact editorial redesign
   Scoped only to .now-v7
   ========================================================= */
.now-v7{
  position:relative;
  padding:5.6vw 6vw 4.2vw;
  background:
    radial-gradient(circle at 76% 46%,rgba(36,87,255,.045),transparent 28%),
    var(--paper);
  overflow:hidden;
}
.now-v7-top{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  align-items:center;
  padding-bottom:1.5rem;
  border-bottom:1px solid rgba(16,17,19,.14);
  font:9px 'DM Mono',monospace;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.now-v7-top span{display:block}
.now-v7-index{color:#676962}
.now-v7-kicker{color:var(--blue);text-align:center}
.now-v7-side{text-align:right;color:#676962}
.now-v7-main{
  min-height:390px;
  display:grid;
  grid-template-columns:1.08fr .92fr;
  gap:8vw;
  align-items:center;
  padding:4.6vw 3.2vw 3.8vw;
}
.now-v7-statement{max-width:690px}
.now-v7-label{
  display:block;
  margin-bottom:1.3rem;
  color:#777971;
  font:9px 'DM Mono',monospace;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.now-v7-statement h2{
  margin:0;
  font-size:clamp(4.8rem,7.3vw,8.8rem);
  line-height:.78;
  letter-spacing:-.075em;
  font-weight:800;
}
.now-v7-statement h2 em{
  display:block;
  font-family:Georgia,'Times New Roman',serif;
  font-style:italic;
  font-weight:400;
  letter-spacing:-.075em;
}
.now-v7-statement p{
  max-width:500px;
  margin:2rem 0 0;
  color:#5e605a;
  font-size:.92rem;
  line-height:1.7;
}
.now-v7-focus{
  position:relative;
  padding-left:2.4vw;
  border-left:1px solid rgba(16,17,19,.14);
}
.now-v7-focus-head{
  display:flex;
  justify-content:space-between;
  margin-bottom:.55rem;
  color:#74766e;
  font:9px 'DM Mono',monospace;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.now-v7-focus-head b{font-weight:400;color:var(--blue)}
.now-v7-focus-list{border-top:1px solid rgba(16,17,19,.14)}
.now-focus-item{
  width:100%;
  display:grid;
  grid-template-columns:38px 1fr 24px;
  align-items:center;
  gap:1rem;
  padding:1rem .25rem;
  border:0;
  border-bottom:1px solid rgba(16,17,19,.14);
  background:transparent;
  color:var(--ink);
  text-align:left;
  cursor:pointer;
  font:inherit;
  transition:padding .35s cubic-bezier(.2,.7,.2,1),color .25s,background .25s;
}
.now-focus-item span{color:#7a7c75;font:9px 'DM Mono',monospace}
.now-focus-item strong{font-size:1.02rem;font-weight:600;letter-spacing:-.025em}
.now-focus-item i{font-style:normal;text-align:right;color:#777971;transition:transform .3s,color .25s}
.now-focus-item:hover,.now-focus-item:focus-visible,.now-focus-item.is-active{color:var(--blue);padding-left:.75rem;outline:none;background:rgba(36,87,255,.025)}
.now-focus-item:hover i,.now-focus-item:focus-visible i,.now-focus-item.is-active i{transform:translate(3px,-3px);color:var(--blue)}
.now-focus-item.is-active span{color:var(--blue)}
.now-v7-signal{
  display:grid;
  grid-template-columns:10px 1fr auto;
  align-items:center;
  gap:.65rem;
  margin-top:1.3rem;
  color:#777971;
  font:8px 'DM Mono',monospace;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.now-signal-dot{width:6px;height:6px;border-radius:50%;background:var(--blue);box-shadow:0 0 0 0 rgba(36,87,255,.25);animation:nowSignalPulse 2s infinite}
.now-signal-line{height:1px;background:linear-gradient(90deg,var(--blue),rgba(36,87,255,.08));transform-origin:left;animation:nowSignalLine 2.6s infinite ease-in-out}
.now-v7-signal b{font-weight:400;color:var(--ink);min-width:105px;text-align:right}
.now-v7-footer{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding-top:1.2rem;
  border-top:1px solid rgba(16,17,19,.14);
  color:#73756e;
  font:9px 'DM Mono',monospace;
  letter-spacing:.08em;
  text-transform:uppercase;
}
.now-v7-footer i{display:inline-block;width:4px;height:4px;margin:0 .5rem;border-radius:50%;background:var(--blue);vertical-align:middle}
.now-v7-footer strong{font-weight:600;color:var(--ink)}
@keyframes nowSignalPulse{0%,100%{box-shadow:0 0 0 0 rgba(36,87,255,.2)}50%{box-shadow:0 0 0 7px rgba(36,87,255,0)}}
@keyframes nowSignalLine{0%,100%{transform:scaleX(.35);opacity:.45}50%{transform:scaleX(1);opacity:1}}
@media(max-width:900px){
  .now-v7{padding:9vw 6vw 6vw}
  .now-v7-main{grid-template-columns:1fr;gap:3rem;padding:4rem 0 3rem}
  .now-v7-focus{padding-left:0;border-left:0}
  .now-v7-statement h2{font-size:clamp(4rem,12vw,7rem)}
}
@media(max-width:620px){
  .now-v7{padding:14vw 6vw 10vw}
  .now-v7-top{grid-template-columns:1fr 1fr;padding-bottom:1rem}
  .now-v7-kicker{text-align:right}
  .now-v7-side{display:none}
  .now-v7-main{min-height:0;padding:3rem 0 2.5rem;gap:2.8rem}
  .now-v7-statement h2{font-size:clamp(3.7rem,16vw,5.8rem);line-height:.82}
  .now-v7-statement p{font-size:.86rem;margin-top:1.5rem}
  .now-focus-item{grid-template-columns:30px 1fr 20px;padding:.9rem 0}
  .now-focus-item strong{font-size:.94rem}
  .now-v7-footer{align-items:flex-start;flex-direction:column;gap:1rem}
  .now-v7-footer strong{font-size:8px}
}
@media(prefers-reduced-motion:reduce){
  .now-signal-dot,.now-signal-line{animation:none!important}
  .now-focus-item,.now-focus-item i{transition:none!important}
}

/* CONTACT V2 / refined form spacing + phone field */
.contact-form-v6 label + label{margin-top:.85rem}
.contact-form-v6 input[name="phone"]{letter-spacing:.01em}
.contact-form-v6 input[type="tel"]:focus{border-bottom-color:var(--blue)}
@media(max-width:620px){
  .contact-form-v6 label{margin-top:.9rem}
  .contact-form-v6 label + label{margin-top:.75rem}
}

/* CONTACT V3 — readability and breathing-room refinement */
.contact-v6 .contact-form-v6 .form-heading span,
.contact-v6 .contact-form-v6 .form-heading b,
.contact-v6 .contact-form-v6 label,
.contact-v6 .contact-form-v6 .form-note{
  font-size:9px;
}
.contact-v6 .contact-form-v6 label{
  gap:.55rem;
  margin-top:1rem;
  line-height:1.35;
}
.contact-v6 .contact-form-v6 label + label{margin-top:.9rem}
.contact-v6 .contact-form-v6 input,
.contact-v6 .contact-form-v6 select,
.contact-v6 .contact-form-v6 textarea{
  font-size:15px;
  line-height:1.45;
}
.contact-v6 .contact-form-v6 input,
.contact-v6 .contact-form-v6 select{
  padding:.72rem 0 .78rem;
}
.contact-v6 .contact-form-v6 textarea{
  padding:.72rem 0 .65rem;
  min-height:112px;
}
.contact-v6 .contact-form-v6 button{
  margin-top:1.45rem;
}
.contact-v6 .contact-form-v6 .form-note{
  margin-top:.85rem;
  line-height:1.55;
}
@media(max-width:620px){
  .contact-v6 .contact-form-v6 .form-heading span,
  .contact-v6 .contact-form-v6 .form-heading b,
  .contact-v6 .contact-form-v6 label,
  .contact-v6 .contact-form-v6 .form-note{font-size:8.5px}
  .contact-v6 .contact-form-v6 input,
  .contact-v6 .contact-form-v6 select,
  .contact-v6 .contact-form-v6 textarea{font-size:14px}
  .contact-v6 .contact-form-v6 label{margin-top:.95rem}
  .contact-v6 .contact-form-v6 label + label{margin-top:.8rem}
}


/* CONTACT V4 — prevent left-side heading line collision */
.contact-v6 .contact-copy-v6 h2{
  line-height:.84;
  margin:0 0 1.65rem;
  padding-bottom:.08em;
}
.contact-v6 .contact-copy-v6 p{
  margin:0 0 1.55rem;
}
.contact-v6 .contact-copy-v6 .contact-link-v6{
  margin-top:0;
}
@media(max-width:1000px){
  .contact-v6 .contact-copy-v6 h2{line-height:.86;margin:0 0 1.5rem}
}
@media(max-width:620px){
  .contact-v6 .contact-copy-v6 h2{line-height:.88;margin:0 0 1.35rem}
}

/* CONTACT V5 — separate kicker from display heading */
.contact-v6 .contact-copy-v6 .contact-kicker{
  display:block;
  margin:0 0 1.9rem;
  line-height:1.4;
  white-space:nowrap;
}
.contact-v6 .contact-copy-v6 h2{
  line-height:.9;
  margin:0 0 1.75rem;
}
@media(max-width:1000px){
  .contact-v6 .contact-copy-v6 .contact-kicker{margin-bottom:1.6rem}
  .contact-v6 .contact-copy-v6 h2{line-height:.9}
}
@media(max-width:620px){
  .contact-v6 .contact-copy-v6 .contact-kicker{margin-bottom:1.25rem;white-space:normal}
  .contact-v6 .contact-copy-v6 h2{line-height:.92;margin-bottom:1.35rem}
}

/* PREMIUM POLISH PASS — restrained, authored, accessibility-first */
:root{
  --ink:#111318;
  --muted:#666b73;
  --paper:#f4f0e8;
  --navy:#101a2c;
  --blue:#2457ff;
  --hair:rgba(17,19,24,.14);
  --hair-light:rgba(255,255,255,.16);
}
html{scroll-behavior:smooth;text-rendering:optimizeLegibility}
body{-webkit-font-smoothing:antialiased;overflow-x:hidden}
::selection{background:var(--blue);color:#fff}
:focus-visible{outline:2px solid var(--blue);outline-offset:4px}
img{max-width:100%;height:auto}
button,input,select,textarea{font:inherit}

/* Keep the visual language quiet: motion is information, not decoration. */
.hero-v7-float{opacity:.92}
.hero-v7-grid-bg,.about-grid-bg,.work-page-grid,.contact-page-grid{opacity:.72}
.hero-signal-node,.toolkit-v18-points i{will-change:transform,opacity}

/* More deliberate display typography at large widths. */
.hero-name{letter-spacing:-.075em}
.about-hero h1,.work-page-title-wrap h1,.contact-page-copy h2{letter-spacing:-.065em}
.hero-role,.hero-meta-line,.contact-kicker,.blue-label,.work-page-kicker{letter-spacing:.12em}

/* Editorial rhythm: avoid the repeated 'label + giant heading' feeling becoming cramped. */
.about-statement-grid,.work-page-section-head,.contact-layout-v6{isolation:isolate}
.work-page-section-head>p,.about-cap-head>p{max-width:38rem;line-height:1.7}

/* Project imagery feels photographic rather than like a UI screenshot. */
.project-image-v6{transition:transform .8s cubic-bezier(.2,.7,.2,1),filter .5s ease}
.project-card-v6:hover .project-image-v6{transform:scale(1.018)}
.project-card-v6 .project-browser-v6{opacity:.78}

/* Quiet links: less button-like, more editorial. */
a{transition:color .25s ease,opacity .25s ease}
.nav-links a:hover,.linkedin-link:hover,.contact-link-v6:hover,.contact-page-email:hover,.contact-page-linkedin:hover{color:var(--blue)}

/* Form usability */
.contact-form-v6 input,.contact-form-v6 select,.contact-form-v6 textarea,
.contact-page-form input,.contact-page-form select,.contact-page-form textarea{min-width:0}
.contact-form-v6 input::placeholder,.contact-page-form input::placeholder,.contact-page-form textarea::placeholder{opacity:.58}
.contact-form-v6 label,.contact-page-form label{cursor:text}
.contact-form-v6 button,.contact-page-form button{cursor:pointer}

/* Responsive safeguards for long labels and authored layouts. */
@media(max-width:1000px){
  .hero-name{letter-spacing:-.06em}
  .work-page-title-wrap h1,.about-hero h1,.contact-page-copy h1,.contact-page-copy h2{letter-spacing:-.055em}
}
@media(max-width:620px){
  html{scroll-behavior:auto}
  .hero-name{letter-spacing:-.045em}
  .work-page-title-wrap h1,.about-hero h1,.contact-page-copy h1,.contact-page-copy h2{letter-spacing:-.045em}
  .work-page-section-head>p,.about-cap-head>p{line-height:1.6}
}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
}


/* FINAL QA — layout resilience and accessible interaction. */
*,*::before,*::after{box-sizing:border-box}
main,section,header,footer,nav,article,form{min-width:0}
button,a,input,select,textarea{ -webkit-tap-highlight-color:transparent }
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--blue);outline-offset:4px}
input,select,textarea{max-width:100%}
textarea{resize:vertical}
img,svg{max-width:100%}

/* Prevent authored display type from forcing horizontal overflow at narrow widths. */
@media(max-width:1000px){
  .hero-name,.about-hero h1,.work-page-title-wrap h1,.contact-page-copy h1,.contact-page-copy h2,.now-v7-statement h2,.toolkit-v18-title h2{overflow-wrap:normal;word-break:normal}
  .work-page-hero-grid,.work-page-section-head,.work-page-evidence-grid,.about-hero-grid,.about-statement-grid,.about-now-grid,.contact-page-layout{min-width:0}
}
@media(max-width:620px){
  .nav-center{max-width:45vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .work-page-title-wrap h1,.about-hero h1,.contact-page-copy h1,.contact-page-copy h2,.now-v7-statement h2,.toolkit-v18-title h2{max-width:100%;overflow-wrap:break-word}
  .contact-page-form,.contact-form-v6{width:100%;min-width:0}
  .toolkit-v18-node{max-width:calc(50% - 5px)}
}

/* TOOLKIT FINAL COMPOSITION PASS — scoped to Toolkit only */
.toolkit-v18-head{padding-bottom:.85vw}
.toolkit-v18-stage{height:405px}
.toolkit-v18-note{font-size:11px;line-height:1.58}
.toolkit-v18-note span{font-size:9.5px}

/* Wider cards, stronger hierarchy, and enough vertical room for two chip rows. */
.toolkit-v18-node{width:420px;height:190px;padding:.95rem 1.1rem}
.toolkit-v18-node-content{margin-top:.48rem}
.toolkit-v18-node-content>strong{font-size:2.32rem;line-height:.94}
.toolkit-v18-node-content>em{font-size:10px;line-height:1.3;margin-bottom:.56rem}
.toolkit-v18-tools{gap:.34rem}
.toolkit-v18-tools small{min-height:23px;padding:.3rem .5rem;font-size:10.5px;line-height:1.15}

/* Keep the radial system readable without letting it dominate the composition. */
.toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:330px;height:330px}
.toolkit-v18-orbit.orbit-mid{width:238px;height:238px}
.toolkit-v18-orbit.orbit-inner{width:148px;height:148px}
.toolkit-v18-axis{background:rgba(16,17,19,.095)}
.toolkit-v18-orbit{border-color:rgba(16,17,19,.145)}

.toolkit-v18-foot{font-size:10px;margin-top:.5vw}
.toolkit-v18-foot strong{font-size:10px}

@media(max-width:1100px){
  .toolkit-v18-stage{height:410px}
  .toolkit-v18-node{width:31vw;max-width:380px;height:190px}
  .toolkit-v18-node-content>strong{font-size:2.18rem}
  .toolkit-v18-tools small{font-size:10px}
  .toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:330px;height:330px}
}
@media(max-width:820px){
  .toolkit-v18-stage{height:445px}
  .toolkit-v18-node{width:30vw;max-width:none;height:194px}
  .toolkit-v18-node-content>strong{font-size:2rem}
  .toolkit-v18-node-content>em{font-size:9.5px}
  .toolkit-v18-tools small{font-size:9.5px;min-height:21px}
  .toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:300px;height:300px}
  .toolkit-v18-orbit.orbit-mid{width:218px;height:218px}
  .toolkit-v18-orbit.orbit-inner{width:138px;height:138px}
}
@media(max-width:620px){
  .toolkit-v18-head{padding-bottom:5vw}
  .toolkit-v18-stage{height:650px}
  .toolkit-v18-node{width:calc(50% - 6px);height:208px;padding:.68rem}
  .toolkit-v18-node-content>strong{font-size:1.62rem}
  .toolkit-v18-node-content>em{font-size:7.8px}
  .toolkit-v18-tools{gap:.2rem}
  .toolkit-v18-tools small{font-size:7.8px;min-height:18px;padding:.24rem .3rem;white-space:normal}
  .toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:250px;height:250px}
  .toolkit-v18-orbit.orbit-mid{width:188px;height:188px}
  .toolkit-v18-orbit.orbit-inner{width:128px;height:128px}
  .toolkit-v18-foot{font-size:8.5px}
  .toolkit-v18-foot strong{font-size:8.5px}
}


/* TOOLKIT FINAL ALIGNMENT — match the approved composition without touching other sections */
.toolkit-v18{
  padding:4.6vw 3.1vw 2.1vw;
}
.toolkit-v18-head{
  grid-template-columns:140px minmax(0,1fr) 280px;
  gap:3.2vw;
  padding-bottom:1.45vw;
}
.toolkit-v18-index{padding-top:.42rem}
.toolkit-v18-title h2{
  font-size:clamp(4.2rem,5.75vw,6.3rem);
  line-height:.82;
}
.toolkit-v18-note{
  padding-top:.35rem;
  font-size:11px;
  line-height:1.55;
}
.toolkit-v18-note p{max-width:30ch}
.toolkit-v18-stage{
  height:455px;
}
.toolkit-v18-node{
  width:420px;
  height:210px;
  padding:1rem 1.1rem;
}
.toolkit-v18-node.node-1,.toolkit-v18-node.node-3{left:1%}
.toolkit-v18-node.node-2,.toolkit-v18-node.node-4{right:4.5%}
.toolkit-v18-node-content{margin-top:.52rem}
.toolkit-v18-node-content>strong{
  font-size:2.38rem;
  line-height:.92;
}
.toolkit-v18-node-content>em{
  font-size:10px;
  margin-bottom:.62rem;
}
.toolkit-v18-tools{gap:.36rem}
.toolkit-v18-tools small{
  min-height:23px;
  padding:.3rem .52rem;
  font-size:10px;
}
.toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{
  width:390px;height:390px;
}
.toolkit-v18-orbit.orbit-mid{width:282px;height:282px}
.toolkit-v18-orbit.orbit-inner{width:166px;height:166px}
.toolkit-v18-connectors i:nth-child(1),
.toolkit-v18-connectors i:nth-child(3){left:calc(1% + 420px)}
.toolkit-v18-connectors i:nth-child(2),
.toolkit-v18-connectors i:nth-child(4){right:calc(4.5% + 420px)}
.toolkit-v18-foot{margin-top:.7vw;font-size:10px}
.toolkit-v18-foot strong{font-size:10px}

@media(max-width:1100px){
  .toolkit-v18{padding:5vw 4vw 3vw}
  .toolkit-v18-head{grid-template-columns:100px minmax(0,1fr) 230px;gap:2.5vw}
  .toolkit-v18-stage{height:455px}
  .toolkit-v18-node{width:32vw;max-width:390px;height:210px}
  .toolkit-v18-node.node-1,.toolkit-v18-node.node-3{left:1.5%}
  .toolkit-v18-node.node-2,.toolkit-v18-node.node-4{right:1.5%}
  .toolkit-v18-connectors i:nth-child(1),.toolkit-v18-connectors i:nth-child(3){left:calc(1.5% + 32vw)}
  .toolkit-v18-connectors i:nth-child(2),.toolkit-v18-connectors i:nth-child(4){right:calc(1.5% + 32vw)}
}
@media(max-width:820px){
  .toolkit-v18-head{grid-template-columns:80px minmax(0,1fr)}
  .toolkit-v18-note{grid-column:2;margin-top:.9rem}
  .toolkit-v18-stage{height:470px}
  .toolkit-v18-node{width:30vw;max-width:none;height:210px}
  .toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:310px;height:310px}
  .toolkit-v18-orbit.orbit-mid{width:226px;height:226px}
  .toolkit-v18-orbit.orbit-inner{width:140px;height:140px}
  .toolkit-v18-connectors{display:none}
}
@media(max-width:620px){
  .toolkit-v18{padding:10vw 6vw 7vw}
  .toolkit-v18-stage{height:660px}
  .toolkit-v18-node{width:calc(50% - 6px);height:212px;padding:.65rem}
  .toolkit-v18-orbit.orbit-outer,.toolkit-v18-points{width:250px;height:250px}
  .toolkit-v18-orbit.orbit-mid{width:188px;height:188px}
  .toolkit-v18-orbit.orbit-inner{width:128px;height:128px}
}

/* PREMIUM INTERACTION LAYER — global, lightweight, and motion-aware. */
:root{--cursor-blue:#2457ff}
.site-progress{position:fixed;left:0;top:0;width:100%;height:2px;background:var(--blue);transform:scaleX(0);transform-origin:left center;z-index:10000;pointer-events:none;box-shadow:0 0 12px rgba(36,87,255,.45)}
.site-cursor,.site-cursor-ring{position:fixed;left:0;top:0;width:10px;height:10px;border-radius:50%;pointer-events:none;z-index:10001;mix-blend-mode:difference;transition:opacity .2s ease}
.site-cursor{background:#fff;margin:-5px 0 0 -5px}
.site-cursor-ring{width:44px;height:44px;margin:-22px 0 0 -22px;border:1px solid rgba(255,255,255,.72);display:grid;place-items:center;transition:width .28s ease,height .28s ease,margin .28s ease,opacity .2s ease,border-color .28s ease}
.site-cursor-ring.is-hovering{width:70px;height:70px;margin:-35px 0 0 -35px;border-color:var(--cursor-blue)}
.site-cursor-label{font:7px/1 'DM Mono',monospace;letter-spacing:.08em;color:#fff;opacity:0;transition:opacity .2s ease}
.site-cursor-ring.is-hovering .site-cursor-label{opacity:1}
.site-cursor.is-hidden,.site-cursor-ring.is-hidden{opacity:0}
.site-system-mark{position:fixed;left:16px;bottom:16px;width:34px;height:34px;border:1px solid rgba(16,17,19,.35);border-radius:50%;display:grid;place-items:center;background:rgba(238,235,227,.78);backdrop-filter:blur(10px);z-index:9000;font:9px 'DM Mono';color:#111;box-shadow:0 8px 25px rgba(16,17,19,.08)}
.site-system-mark img{width:22px;height:19px;display:block}
.site-system-mark i{position:absolute;width:4px;height:4px;border-radius:50%;background:var(--blue);right:7px;top:7px;box-shadow:0 0 8px rgba(36,87,255,.7)}
body{overflow-x:hidden}
body.is-route-leaving main{animation:routeExit .24s ease both}
@keyframes routeExit{to{opacity:0;transform:translateY(8px)}}

/* More authored-feeling motion: depth follows the pointer only where it helps. */
.hero-v7,.manifesto-v8,.approach-v6,.work-v6,.journey-v6,.evolution-v6,.beyond-v6,.now-v7,.contact-v6{isolation:isolate}
.project-card-v6{transform-style:preserve-3d;will-change:transform}
.project-card-v6 .project-copy-v6,.project-card-v6 .project-visual-v6{transform:translateZ(0)}
.project-card-v6:hover .project-copy-v6{transform:translateZ(10px)}
.signal-node,.evo-step-v6,.career-card-v6{will-change:transform}
.nav a,.hero-actions a,.contact-link-v6,.project-open-v6 b{transition:color .25s ease,opacity .25s ease}
.nav a:hover,.hero-actions a:hover,.contact-link-v6:hover,.project-open-v6 b:hover{color:var(--blue)}

@media(pointer:coarse),(prefers-reduced-motion:reduce){
  .site-cursor,.site-cursor-ring{display:none}
}
@media(max-width:620px){
  .site-system-mark{left:12px;bottom:12px;width:30px;height:30px;font-size:8px}
}

/* FINAL REFINED PALETTE — restore contrast, keep premium editorial neutrality */

/* FINAL REFINED PALETTE — restore contrast, keep premium editorial neutrality */
:root{
  --paper:#F5F2EA;
  --paper2:#EAE6DD;
  --soft:#D8D3C9;
  --line:#CDC8BE;
  --ink:#101113;
  --blue:#2457FF;
  --blue2:#7B95FF;
  --navy:#0D1530;
  --white:#F7F5EE;
}
body{background:var(--paper);color:var(--ink)}
/* Keep the light surfaces clean: no grain/noise overlay. */
.hero-v6:before,.work-v6:before,.journey-v6:before,.toolkit-v6:before,.now-v6:before{display:none!important}
.hero-v7{background:var(--paper)!important}
.nav{background:rgba(245,242,234,.88);border-bottom-color:rgba(16,17,19,.10)}
/* Dark sections must remain high-contrast and cool, not brown. */
.manifesto-v6{background:var(--ink)!important;color:var(--white)}
.approach-v6{background:var(--navy)!important;color:#f4f5f8}
.evolution-v6{background:var(--ink)!important}
.contact-v6{background:var(--navy)!important}
/* Blue is a signal, not a fill: reserve stronger blue for active states. */
::selection{background:var(--blue);color:#fff}

/* FINAL VISUAL CLEANUP — restore the approved editorial hierarchy */
.evolution-v6{
  background:var(--paper2) !important;
  color:var(--ink) !important;
  padding:5.2vw 6vw 5.4vw;
}
.evolution-v6:before{
  background:
    radial-gradient(circle at 78% 18%,rgba(36,87,255,.055),transparent 24%),
    linear-gradient(90deg,transparent 0 49.95%,rgba(16,17,19,.035) 50%,transparent 50.05%);
}
.evolution-head-v6 h2,
.evolution-head-v6 h2 em{color:var(--ink) !important}
.evolution-head-v6 p{color:#5d605a}
.evo-connection{background:rgba(16,17,19,.16)}
.evo-step-v6{color:var(--ink);min-height:270px}
.evo-step-v6>span{color:#62655f}
.evo-step-v6>b{color:#18191b}
.evo-step-v6>small{color:#555952}
.evo-step-v6>p{color:#666960;opacity:.9}
.evo-icon{background:rgba(245,242,234,.7);border-color:#b8b4aa}
.evo-step-v6:hover,.evo-step-v6:focus-visible{transform:translateY(-5px)}
.evo-step-v6:hover .evo-icon,.evo-step-v6:focus-visible .evo-icon{border-color:var(--blue);color:var(--blue);transform:translateY(-2px)}
.evo-step-v6:hover>b,.evo-step-v6:focus-visible>b{color:var(--blue)}
.evo-step-v6:hover>p,.evo-step-v6:focus-visible>p{opacity:1;transform:translateY(0)}

/* Toolkit — clearer structure without turning it into a card-heavy dashboard */
.toolkit-v6{background:var(--paper) !important}
.toolkit-orbit{border-color:#c5c0b6}
.toolkit-orbit div{border-color:#d0cbc1}
.toolkit-orbit span{color:var(--blue)}
.toolkit-list-v6{border-top-color:#c7c2b8}
.toolkit-list-v6>div{border-bottom-color:#c7c2b8}
.toolkit-list-v6>div:hover{background:rgba(36,87,255,.035)}
.tool-icon{border-color:#c2bdb3;background:rgba(255,255,255,.28)}
.toolkit-list-v6 p{color:#5e615b}

/* Keep dark sections intentional: one system section + contact, not muddy transitions. */
.approach-v6{background:var(--navy) !important}
.contact-v6{background:var(--navy) !important}

/* Paper sections stay visually connected. */
.hero-v7,.work-v6,.journey-v6,.toolkit-v6,.now-v6{background-color:var(--paper) !important}

/* Reduce the decorative blue glow so blue reads as an interaction signal. */
.hero-v7{background-image:none !important}
.work-v6{background-image:none !important}
.journey-v6{background-image:none !important}
.toolkit-v6{background-image:none !important}

@media(max-width:1000px){
  .evolution-v6{padding:9vw 6vw}
}
@media(max-width:620px){
  .evolution-v6{padding:15vw 6vw}
  .evo-step-v6{min-height:230px}
}

/* BRAND IDENTITY — Option 02 / editorial serif TK monogram */
.brand-logo-link{display:inline-flex;align-items:center;width:max-content;height:42px}
.brand-mark-only{position:relative;display:inline-flex;width:38px;height:32px;align-items:center;justify-content:center;color:var(--ink);transition:color .25s ease,transform .35s cubic-bezier(.22,1,.36,1)}
.brand-mark-only svg{width:100%;height:100%;display:block;overflow:visible}
.brand-logo-link:hover .brand-mark-only{transform:translateY(-1px)}
.brand-lockup{display:inline-flex;align-items:center;gap:13px;color:var(--ink)}
.brand-lockup-mark{width:45px;height:38px;display:block;flex:0 0 auto}
.brand-lockup-copy{display:flex;flex-direction:column;gap:4px}
.brand-lockup-copy strong{font:600 16px/1 Georgia,'Times New Roman',serif;letter-spacing:.105em}
.brand-lockup-copy small{font:7px/1.2 'DM Mono',monospace;letter-spacing:.105em;white-space:nowrap}
.dark .brand-mark-only,.approach-v6 .brand-mark-only,.contact-v6 .brand-mark-only{color:var(--white)}
@media(max-width:900px){
  .brand-lockup-copy{display:none}
  .brand-lockup{gap:0}
  .brand-lockup-mark{width:38px;height:32px}
}
@media(max-width:620px){
  .brand-mark-only{width:34px;height:29px}
}
/* Keep the selected Option 02 wordmark monochrome; the site blue remains an interaction accent. */
.brand-logo-link .brand-mark-only,
.brand-logo-link .brand-lockup{color:var(--ink);font-size:inherit;letter-spacing:normal;margin-left:0}
.brand-logo-link .brand-lockup-copy strong{color:var(--ink);font-size:16px;margin-left:0}
.brand-logo-link .brand-lockup-copy small{color:var(--ink);font-size:7px;margin-left:0}

/* CONTACT PAGE — FINAL POLISH */
.contact-page .nav{
  background:rgba(13,21,48,.88);
  border-bottom-color:rgba(247,245,238,.12);
  color:var(--white);
}
.contact-page .nav-center{color:#8e97a8}
.contact-page .nav-links a{color:var(--white)}
.contact-page .nav-links a:after{background:var(--blue)}
.contact-page .brand-lockup,
.contact-page .brand-mark-only{color:var(--white)!important}
.contact-page .brand-lockup-copy strong{color:var(--white)!important}
.contact-page .brand-lockup-copy small{color:#aab1bf}

.contact-page-copy h1{
  font-size:clamp(5rem,8.3vw,9.4rem);
  line-height:.78;
  letter-spacing:-.105em;
  margin:1.8rem 0 2.2rem;
  max-width:720px;
}
.contact-page-copy h1 em{
  letter-spacing:-.08em;
}
.contact-page-orbit{opacity:.32}
.contact-page-orbit span{opacity:.72;box-shadow:0 0 18px rgba(36,87,255,.45)}

@media(max-width:1000px){
  .contact-page-copy h1{font-size:clamp(4.8rem,12vw,8rem);max-width:760px}
}
@media(max-width:620px){
  .contact-page-copy h1{font-size:clamp(4.2rem,15vw,6.5rem);line-height:.8;max-width:100%}
  .contact-page-orbit{opacity:.22}
}




/* FINAL HERO METADATA — single source of truth.
   All hero metadata shares one bounded coordinate system. */
.hero-v7 .hero-meta-band{
  position:absolute !important;
  top:76px !important;
  left:var(--hero-gutter, 6vw) !important;
  right:var(--hero-gutter, 6vw) !important;
  width:auto !important;
  height:58px !important;
  margin:0 !important;
  padding:0 !important;
  z-index:20 !important;
  pointer-events:none;
}
.hero-v7 .hero-meta-band .hero-index{
  position:absolute !important;
  left:0 !important;
  top:0 !important;
  margin:0 !important;
  color:var(--blue) !important;
  font:8px 'DM Mono',monospace !important;
  letter-spacing:.1em !important;
  text-transform:uppercase !important;
}
.hero-v7 .hero-meta-band .hero-v7-location{
  position:absolute !important;
  left:0 !important;
  right:auto !important;
  top:30px !important;
  margin:0 !important;
  max-width:none !important;
  color:#64675f !important;
  font:8px 'DM Mono',monospace !important;
  letter-spacing:.08em !important;
  text-transform:uppercase !important;
  text-align:left !important;
  white-space:nowrap !important;
}
.hero-v7 .hero-meta-band .hero-v7-status{
  position:absolute !important;
  left:auto !important;
  right:0 !important;
  top:0 !important;
  bottom:auto !important;
  margin:0 !important;
  width:auto !important;
  max-width:100% !important;
  display:flex !important;
  align-items:center !important;
  justify-content:flex-end !important;
  gap:.65rem !important;
  color:#64675f !important;
  font:8px 'DM Mono',monospace !important;
  letter-spacing:.08em !important;
  text-transform:uppercase !important;
  text-align:right !important;
  white-space:nowrap !important;
  overflow:hidden !important;
  text-overflow:ellipsis !important;
}
.hero-v7 .hero-meta-band .hero-v7-status i{
  flex:0 0 5px !important;
  width:5px !important;
  height:5px !important;
  border-radius:50% !important;
  background:var(--blue) !important;
  box-shadow:0 0 0 4px rgba(36,87,255,.09) !important;
}
.hero-v7 .hero-query-rail{
  left:calc(var(--hero-gutter, 6vw) + 72px) !important;
  right:var(--hero-gutter, 6vw) !important;
  width:auto !important;
  max-width:none !important;
}

@media (max-width:1000px){
  .hero-v7{--hero-gutter:5vw}
  .hero-v7 .hero-meta-band{
    left:5vw !important;
    right:5vw !important;
  }
  .hero-v7 .hero-meta-band .hero-v7-status{
    right:0 !important;
    left:auto !important;
    max-width:55vw !important;
  }
  .hero-v7 .hero-query-rail{
    left:5vw !important;
    right:5vw !important;
  }
}
@media (max-width:620px){
  .hero-v7{--hero-gutter:6vw}
  .hero-v7 .hero-meta-band{
    top:75px !important;
    left:6vw !important;
    right:6vw !important;
    height:54px !important;
  }
  .hero-v7 .hero-meta-band .hero-index{top:0 !important}
  .hero-v7 .hero-meta-band .hero-v7-location{
    top:27px !important;
    left:0 !important;
    right:auto !important;
    font-size:7px !important;
  }
  .hero-v7 .hero-meta-band .hero-v7-status{
    top:0 !important;
    right:0 !important;
    left:auto !important;
    max-width:58vw !important;
    font-size:7px !important;
  }
  .hero-v7 .hero-query-rail{
    left:6vw !important;
    right:6vw !important;
  }
}

/* V20 interaction layer — motion is used to explain systems, not decorate them. */
.site-preloader{position:fixed;inset:0;z-index:9999;background:var(--paper);color:var(--ink);display:flex;flex-direction:column;justify-content:space-between;padding:28px 3.5vw 24px;clip-path:inset(0 0 0 0);overflow:hidden}
.preloader-top,.preloader-bottom{display:flex;justify-content:space-between;font:9px 'DM Mono',monospace;letter-spacing:.09em;text-transform:uppercase;color:#6c6e68}
.preloader-core{width:min(980px,86vw);margin:auto;display:grid;grid-template-columns:minmax(170px,.6fr) 1fr;gap:clamp(2rem,7vw,7rem);align-items:center}
.preloader-word{font:400 clamp(7rem,16vw,15rem)/.7 Georgia,serif;letter-spacing:-.12em;font-style:italic}
.preloader-question{font:700 clamp(1.5rem,3vw,3rem)/.95 Manrope,sans-serif;letter-spacing:-.06em;max-width:10ch;text-transform:uppercase}
.preloader-queries{grid-column:2;display:flex;gap:.45rem;flex-wrap:wrap;margin-top:-2.5rem;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase;color:#666a63}
.preloader-queries span{border-bottom:1px solid var(--line);padding-bottom:.35rem}
.preloader-signal{grid-column:2;height:28px;display:flex;align-items:center;gap:0;overflow:hidden}
.preloader-signal i{display:block;height:1px;background:var(--blue);width:20%;transform-origin:left;animation:preSignal 1.1s ease-in-out infinite alternate}
.preloader-signal i:nth-child(2){animation-delay:.1s}.preloader-signal i:nth-child(3){animation-delay:.2s}.preloader-signal i:nth-child(4){animation-delay:.3s}.preloader-signal i:nth-child(5){animation-delay:.4s}
.preloader-system{grid-column:2;display:flex;align-items:center;gap:.55rem;flex-wrap:wrap;font:8px 'DM Mono';letter-spacing:.08em;color:#62665f}.preloader-system i{color:var(--blue);font-style:normal}
@keyframes preSignal{from{opacity:.25;transform:scaleX(.35)}to{opacity:1;transform:scaleX(1)}}
body:not(.site-ready){overflow:hidden}
.site-progress{height:2px!important;background:var(--blue)!important;z-index:1000!important;opacity:.75}
.scroll-indicator{position:fixed;z-index:48;right:2.5vw;bottom:28px;display:flex;align-items:center;gap:.7rem;transform:rotate(-90deg) translateX(100%);transform-origin:right bottom;font:8px 'DM Mono';letter-spacing:.12em;color:#70736c;text-transform:uppercase;pointer-events:none;mix-blend-mode:multiply}
.scroll-indicator i{display:block;width:62px;height:1px;background:var(--line);position:relative;overflow:hidden}.scroll-indicator b{position:absolute;inset:0;transform:scaleX(0);transform-origin:left;background:var(--blue)}
.site-cursor{width:7px;height:7px;background:var(--blue);border-radius:50%;position:fixed;left:-3px;top:-3px;z-index:1001;pointer-events:none;transition:opacity .2s}.site-cursor-ring{width:48px;height:48px;border:1px solid rgba(36,87,255,.55);border-radius:50%;position:fixed;left:-24px;top:-24px;z-index:1000;pointer-events:none;display:grid;place-items:center;transition:width .35s,height .35s,left .35s,top .35s,border-color .35s,background .35s}.site-cursor-ring .site-cursor-label{font:7px 'DM Mono';letter-spacing:.08em;color:var(--ink);opacity:0;transition:opacity .25s}.site-cursor-ring.is-hovering{width:74px;height:74px;left:-37px;top:-37px;border-color:var(--blue);background:rgba(247,245,239,.84);backdrop-filter:blur(5px)}.site-cursor-ring.is-hovering .site-cursor-label{opacity:1}.site-cursor.is-hidden,.site-cursor-ring.is-hidden{opacity:0}
[data-cursor-zone],.project-card-v6,.evo-step-v6,.toolkit-v18-node{cursor:none}
.project-card-v6{position:relative;overflow:hidden;transition:transform .6s cubic-bezier(.22,1,.36,1),box-shadow .6s,border-color .35s}.project-card-v6.is-hovered{transform:translateY(-8px);box-shadow:0 28px 70px rgba(16,17,19,.11);border-color:rgba(36,87,255,.25)}
.project-visual-v6{overflow:hidden}.project-card-v6 .project-browser-v6{transition:transform .45s ease,opacity .3s}.project-card-v6.is-hovered .project-browser-v6{transform:translateY(-3px)}
.project-hover-system{position:absolute;left:1.25rem;bottom:3.7rem;z-index:4;display:flex;align-items:center;gap:.45rem;opacity:0;transform:translateY(8px);transition:opacity .4s,transform .5s}.project-hover-system span,.project-hover-system i{font:7px 'DM Mono';letter-spacing:.08em;color:#fff;font-style:normal}.project-hover-system i{width:22px;height:1px;background:rgba(255,255,255,.7)}.project-card-v6.is-hovered .project-hover-system{opacity:1;transform:translateY(0)}
.project-hover-detail{display:grid;grid-template-columns:auto 1fr;column-gap:.75rem;row-gap:.15rem;max-height:0;opacity:0;overflow:hidden;transform:translateY(8px);transition:max-height .5s ease,opacity .35s ease,transform .45s ease;margin-top:0}.project-hover-detail span{grid-row:span 2;font:7px 'DM Mono';letter-spacing:.08em;color:var(--blue);padding-top:.15rem}.project-hover-detail strong{font-size:.72rem;font-weight:700}.project-hover-detail small{font:8px 'DM Mono';color:#777a73}.project-card-v6.is-hovered .project-hover-detail{max-height:54px;opacity:1;transform:translateY(0);margin-top:.8rem}
.signal-path,.evo-connection,.toolkit-v18-connectors{transform-origin:left center}
.signal-path:after{content:'';position:absolute;left:0;top:0;width:100%;height:1px;background:var(--blue);transform:scaleX(var(--node-progress,0));transform-origin:left;opacity:.75}
.evo-step-v6{will-change:transform,opacity}.evo-step-v6:hover .evo-progress,.evo-step-v6:focus-visible .evo-progress{transform:scaleX(1)}
/* Designed section handoffs */
.manifesto-v8,.approach-v6,.work-v6,.journey-v6,.evolution-v6,.toolkit-v18,.beyond-v6,.now-v7,.contact-v6{position:relative}
.manifesto-v8:after,.work-v6:after,.journey-v6:after,.toolkit-v18:after,.beyond-v6:after{content:'';position:absolute;left:5.5vw;right:5.5vw;bottom:0;height:1px;background:linear-gradient(90deg,transparent,var(--line),transparent);transform:scaleX(.35);transform-origin:center;transition:transform 1s ease}.manifesto-v8:hover:after,.work-v6:hover:after,.journey-v6:hover:after,.toolkit-v18:hover:after,.beyond-v6:hover:after{transform:scaleX(1)}
@media(max-width:800px){.preloader-core{grid-template-columns:1fr;gap:1.4rem}.preloader-word{font-size:7rem}.preloader-question,.preloader-queries,.preloader-signal,.preloader-system{grid-column:1}.preloader-queries{margin-top:0}.preloader-system{line-height:1.8}.scroll-indicator{display:none}.site-cursor,.site-cursor-ring{display:none}.project-card-v6{cursor:pointer}.project-hover-system{display:none}}
@media(prefers-reduced-motion:reduce){.site-preloader{clip-path:none!important}.preloader-signal i{animation:none}.project-card-v6,.project-hover-system,.project-hover-detail{transition:none!important;transform:none!important}.manifesto-v8:after,.work-v6:after,.journey-v6:after,.toolkit-v18:after,.beyond-v6:after{transition:none}.scroll-indicator{display:none}}

/* Section transitions activate from scroll position rather than hover. */
.manifesto-v8:after,.work-v6:after,.journey-v6:after,.toolkit-v18:after,.beyond-v6:after{transform:scaleX(.12);opacity:.45}
.manifesto-v8.is-in-view:after,.work-v6.is-in-view:after,.journey-v6.is-in-view:after,.toolkit-v18.is-in-view:after,.beyond-v6.is-in-view:after{transform:scaleX(1);opacity:1}


/* CAREER V7 / horizontal editorial timeline */
.career-timeline-v7{position:relative;margin-top:3.5rem;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;min-height:270px}
.career-track-v7{position:absolute;left:0;right:0;top:51px;height:1px;background:transparent;z-index:0;pointer-events:none;overflow:visible}
.career-track-v7:before,.career-track-v7:after,.career-track-v7 i,.career-track-v7 b,.career-track-v7 em{content:'';position:absolute;top:0;height:1px;background:#bdb8ae}
/* Each segment stops at the edge of the next circle; the circles remain visually clear. */
.career-track-v7:before{left:37px;width:calc(25% - 18.6px)}
.career-track-v7 i{left:calc(25% + 18.4px + 37px);width:calc(25% - 37px)}
.career-track-v7 b{left:calc(50% + 18.4px + 37px);width:calc(25% - 37px)}
.career-track-v7 em{left:calc(75% + 18.4px + 37px);right:0}
.career-track-v7 .career-segment-signal{display:block;position:absolute;left:37px;top:-.5px;width:15%;height:2px;background:var(--blue);box-shadow:0 0 14px rgba(36,87,255,.3);animation:careerSignalV7 5.5s ease-in-out infinite}
@keyframes careerSignalV7{0%{transform:translateX(-120%);opacity:0}12%{opacity:1}50%{opacity:1}88%{opacity:.45}100%{transform:translateX(760%);opacity:0}}
.career-step-v7{position:relative;min-width:0;padding:0 1.15rem 0 0;z-index:1}
.career-step-v7:not(:first-of-type){padding-left:1.15rem;border-left:1px solid transparent}
.career-step-head{display:flex;justify-content:space-between;align-items:center;height:25px;font:9px 'DM Mono',monospace;letter-spacing:.06em;color:#74766f;text-transform:uppercase}
.career-step-head b{font-weight:400;color:var(--blue)}
.career-step-node{appearance:none;border:1px solid #aaa69c;background:var(--paper);width:37px;height:37px;border-radius:50%;display:grid;place-items:center;padding:0;margin:.5rem 0 1.35rem;position:relative;cursor:pointer;z-index:3;transition:transform .35s,border-color .35s,box-shadow .35s;background-clip:padding-box}
.career-step-node:before{content:'';position:absolute;inset:-5px;border:1px solid rgba(36,87,255,.08);border-radius:50%;transition:inset .35s,opacity .35s}
.career-step-node i{display:block;width:8px;height:8px;border-radius:50%;background:var(--blue);opacity:.55;transition:transform .35s,opacity .35s}
.career-step-v7:hover .career-step-node,.career-step-v7:focus-within .career-step-node{transform:scale(1.13);border-color:var(--blue);box-shadow:0 0 0 6px rgba(36,87,255,.055)}
.career-step-v7:hover .career-step-node:before,.career-step-v7:focus-within .career-step-node:before{inset:-9px;opacity:.8}
.career-step-v7:hover .career-step-node i,.career-step-v7:focus-within .career-step-node i{transform:scale(1.35);opacity:1}
.career-step-copy{padding-right:1rem;transition:transform .35s}
.career-step-v7:hover .career-step-copy,.career-step-v7:focus-within .career-step-copy{transform:translateY(-3px)}
.career-step-copy .career-stage{display:block;font:9px 'DM Mono',monospace;text-transform:uppercase;letter-spacing:.08em;color:var(--blue);min-height:2.4em;max-width:240px}
.career-step-copy h3{font-size:clamp(2rem,2.7vw,3.25rem);line-height:.9;letter-spacing:-.09em;margin:.55rem 0 .6rem;max-width:330px}
.career-step-copy strong{font:9px 'DM Mono',monospace;text-transform:uppercase;color:#666960}
.career-step-copy p{font-size:.9rem;line-height:1.58;color:#686a63;max-width:310px;margin:.75rem 0 0}
.career-step-copy em{display:block;margin-top:1.15rem;font:8px 'DM Mono',monospace;font-style:normal;color:#96968f;letter-spacing:.08em}
.career-progression-v7{margin-top:2.1rem;border-top:1px solid var(--line);display:grid;grid-template-columns:150px 1fr;gap:1rem;align-items:center;padding-top:1rem}
.career-progression-v7>span{font:9px 'DM Mono',monospace;color:#74766f;letter-spacing:.08em;text-transform:uppercase}
.career-progression-v7>strong{font:10px 'DM Mono',monospace;font-weight:400;letter-spacing:.12em;color:#5f625b}
.career-progression-v7 i{font-style:normal;color:var(--blue);padding:0 .55rem}
@media(max-width:1000px) and (min-width:621px){
  .career-timeline-v7{min-height:295px}.career-step-copy h3{font-size:clamp(1.8rem,2.9vw,2.7rem)}.career-step-copy p{font-size:.8rem}.career-step-v7{padding-right:.8rem}.career-step-v7:not(:first-of-type){padding-left:.8rem}
}
@media(max-width:620px){
  .career-timeline-v7{display:flex;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x proximity;margin-top:2.7rem;padding-bottom:.8rem;margin-right:-6vw;padding-left:0;scrollbar-width:none;min-height:0}
  .career-timeline-v7::-webkit-scrollbar{display:none}
  .career-track-v7{left:0;right:6vw;top:51px}
  .career-step-v7{flex:0 0 76vw;padding:0 1rem 0 0;scroll-snap-align:start}
  .career-step-v7:not(:first-of-type){padding-left:1rem}
  .career-step-copy h3{font-size:2.4rem}.career-step-copy p{font-size:.84rem;max-width:300px}.career-step-copy .career-stage{min-height:0;max-width:280px}.career-progression-v7{grid-template-columns:1fr;gap:.55rem;margin-top:1.3rem}.career-progression-v7>strong{font-size:8px;line-height:1.8}.career-progression-v7 i{padding:0 .25rem}
}

/* CAREER V11 — hover-only timeline signal */
.career-track-v7 .career-segment-signal{display:none!important;animation:none!important}
.career-track-v7:before,.career-track-v7:after,.career-track-v7 i,.career-track-v7 b,.career-track-v7 em{transition:background-color .28s ease,box-shadow .28s ease}
.career-timeline-v7:has(.career-step-v7:nth-of-type(1):hover) .career-track-v7:before,
.career-timeline-v7:has(.career-step-v7:nth-of-type(1):focus-within) .career-track-v7:before,
.career-timeline-v7:has(.career-step-v7:nth-of-type(2):hover) .career-track-v7 i,
.career-timeline-v7:has(.career-step-v7:nth-of-type(2):focus-within) .career-track-v7 i,
.career-timeline-v7:has(.career-step-v7:nth-of-type(3):hover) .career-track-v7 b,
.career-timeline-v7:has(.career-step-v7:nth-of-type(3):focus-within) .career-track-v7 b,
.career-timeline-v7:has(.career-step-v7:nth-of-type(4):hover) .career-track-v7 em,
.career-timeline-v7:has(.career-step-v7:nth-of-type(4):focus-within) .career-track-v7 em{background:var(--blue);box-shadow:0 0 10px rgba(36,87,255,.16)}

/* CONTACT TYPOGRAPHY POLISH — selective hierarchy pass */
.contact-v6 h2{font-size:clamp(4.3rem,6.9vw,7.8rem);line-height:.78}
.contact-v6>p{font-size:1rem;line-height:1.72;max-width:500px}
.contact-link-v6{font-size:1.08rem}
.contact-form-v6{border-color:rgba(255,255,255,.16);background:rgba(16,22,34,.5);padding:1.3rem;box-shadow:0 18px 45px rgba(0,0,0,.08)}
.contact-form-v6 label{font-size:8.5px}
.contact-form-v6 input,.contact-form-v6 select,.contact-form-v6 textarea{font-size:15px;padding:.7rem 0}
.contact-form-v6 button{font-size:9px;padding:.9rem 1rem}
.form-note{font-size:7.5px}
@media(max-width:620px){
 .contact-v6 h2{font-size:clamp(4rem,15vw,6.3rem)}
 .contact-v6>p{font-size:.95rem}
 .contact-link-v6{font-size:1rem}
 .contact-form-v6 input,.contact-form-v6 select,.contact-form-v6 textarea{font-size:14px}
}

/* CASE STUDY — EDITORIAL EVIDENCE SYSTEM */
.case-page{background:var(--paper);color:var(--ink);overflow:hidden}.case-nav{background:rgba(243,240,232,.9)}
.case-hero{position:relative;min-height:92svh;padding:112px 6vw 24px;display:flex;flex-direction:column;justify-content:space-between;overflow:hidden}.case-grid-bg{position:absolute;inset:0;pointer-events:none;opacity:.38;background-image:linear-gradient(rgba(16,17,19,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(16,17,19,.055) 1px,transparent 1px);background-size:72px 72px;mask-image:linear-gradient(to bottom,black 0%,transparent 82%)}.case-meta,.case-hero-foot,.case-section-label{position:relative;z-index:1;display:flex;justify-content:space-between;gap:2rem;font:8px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:#73756f}.case-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:.16fr 1fr .3fr;gap:4vw;align-items:end;margin:7vh 0}.case-index{font:9px 'DM Mono',monospace;line-height:1.5;letter-spacing:.08em;color:#7a7c75}.case-index b{display:block;font:500 3.2rem/1 Manrope;letter-spacing:-.08em;color:var(--blue);margin-top:.35rem}.case-title-wrap{max-width:960px}.case-title-wrap h1{font-size:clamp(5rem,8.5vw,10rem);line-height:.77;letter-spacing:-.12em;margin:1.25rem 0 2.1rem;max-width:1000px}.case-title-wrap p{font-size:.98rem;line-height:1.8;color:#5e615b;max-width:700px;margin:0}.case-side{border-left:1px solid var(--line);padding-left:1.2rem;display:grid;gap:1.8rem;margin-bottom:.4rem}.case-side div{display:grid;gap:.4rem}.case-side span{font:7px 'DM Mono';letter-spacing:.08em;color:#878981}.case-side strong{font-size:.72rem;line-height:1.45;max-width:210px}.case-hero-foot{border-top:1px solid var(--line);padding-top:10px}
.case-context{padding:8vw 6vw;background:var(--paper2)}.case-two-col{display:grid;grid-template-columns:1.15fr .65fr;gap:9vw;margin-top:4.8rem;align-items:start}.case-two-col h2,.case-system-head h2,.case-work-grid h2,.case-evidence-head h2,.case-next-grid h2,.case-close h2{font-size:clamp(4rem,6.7vw,7.6rem);line-height:.78;letter-spacing:-.12em;margin:0}.case-two-col p{font-size:.88rem;line-height:1.9;color:#666961;max-width:480px;margin:0}.case-section-label{border-top:1px solid #bbb8b0;padding-top:10px}.case-system{padding:8vw 6vw;background:#0d1530;color:#f4f5f8;position:relative;overflow:hidden}.case-system:after{content:'';position:absolute;width:60vw;height:60vw;border:1px solid rgba(123,149,255,.12);border-radius:50%;right:-30vw;top:-12vw;box-shadow:0 0 0 10vw rgba(36,87,255,.018),0 0 0 20vw rgba(36,87,255,.012)}.case-system .case-section-label{color:#7e879b;border-color:#30394e}.case-system-head{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr .55fr;gap:8vw;align-items:end;margin-top:4.8rem}.case-system-head h2 em,.case-work-grid h2 em,.case-evidence-head h2 em,.case-next-grid h2 em,.case-close h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.09em}.case-system-head p{font-size:.85rem;line-height:1.85;color:#a5adbd;max-width:460px}.case-flow{position:relative;z-index:1;margin-top:5.5rem;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#3a4357}.case-flow-node{position:relative;min-height:260px;background:#0d1530;padding:1.4rem;display:flex;flex-direction:column}.case-flow-node small{font:8px 'DM Mono';color:#6f7b92}.case-flow-node strong{font-size:2rem;letter-spacing:-.08em;margin-top:4rem}.case-flow-node span{font-size:.72rem;line-height:1.7;color:#9ba4b5;margin-top:.8rem;max-width:220px}.case-flow-node i{position:absolute;right:-13px;top:50%;z-index:3;width:26px;height:26px;border:1px solid #536078;border-radius:50%;background:#0d1530;display:grid;place-items:center;color:#7890ff;font-style:normal}.case-architecture{position:relative;z-index:1;margin-top:4rem;border-top:1px solid #343d51;padding-top:1rem}.case-architecture-label{font:8px 'DM Mono';color:#758198;letter-spacing:.08em}.case-architecture-line{display:grid;grid-template-columns:repeat(6,1fr);margin-top:2rem}.case-architecture-line div{padding-right:1rem;border-right:1px solid #343d51;min-height:90px}.case-architecture-line div+div{padding-left:1rem}.case-architecture-line b{font:8px 'DM Mono';color:#7890ff}.case-architecture-line span{display:block;font-size:.75rem;line-height:1.45;color:#d8dce5;margin-top:.7rem}
.case-work{padding:8vw 6vw;background:#f1eee6}.case-work-grid{display:grid;grid-template-columns:1fr .85fr;gap:9vw;margin-top:5rem}.case-work-grid ol,.case-next-grid ol{list-style:none;padding:0;margin:0}.case-work-grid li,.case-next-grid li{display:grid;grid-template-columns:34px 1fr;gap:1rem;padding:1rem 0;border-top:1px solid #c7c3ba}.case-work-grid li:last-child,.case-next-grid li:last-child{border-bottom:1px solid #c7c3ba}.case-work-grid li span,.case-next-grid li span{font:8px 'DM Mono';color:var(--blue);padding-top:.2rem}.case-work-grid li p,.case-next-grid li p{font-size:.84rem;line-height:1.65;color:#555850;margin:0}
.case-evidence{padding:8vw 6vw;background:#0f1219;color:#f5f5f0}.case-evidence .case-section-label{color:#7d879a;border-color:#313742}.case-evidence-head{display:grid;grid-template-columns:1.05fr .55fr;gap:8vw;align-items:end;margin-top:4.8rem}.case-evidence-head p{font-size:.84rem;line-height:1.85;color:#9ca5b4;max-width:450px}.case-evidence-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#353b46;margin-top:5rem}.case-evidence-grid article{background:#0f1219;padding:1.35rem;min-height:230px;display:flex;flex-direction:column}.case-evidence-grid article>span{font:7px 'DM Mono';color:#7c8799;letter-spacing:.08em}.case-evidence-grid strong{font-size:1.55rem;letter-spacing:-.06em;margin-top:3.5rem;color:#f4f5f0}.case-evidence-grid p{font-size:.7rem;line-height:1.65;color:#8e97a5;margin-top:auto}.case-next{padding:8vw 6vw;background:var(--paper2)}.case-next-grid{display:grid;grid-template-columns:1fr .75fr;gap:9vw;margin-top:5rem}.case-close{padding:10vw 6vw 7vw;background:#f3f0e8;min-height:70svh;display:flex;flex-direction:column;justify-content:center}.case-close>span{font:8px 'DM Mono';color:var(--blue);letter-spacing:.08em}.case-close h2{margin:2rem 0 1.5rem;max-width:900px}.case-close p{font-size:.9rem;line-height:1.75;color:#62655e;max-width:480px}.case-close-links{display:flex;gap:2rem;flex-wrap:wrap;margin-top:2.4rem}.case-close-links a{border-bottom:1px solid #aaa79e;padding-bottom:.8rem;font:8px 'DM Mono';letter-spacing:.08em;text-transform:uppercase}.case-close-links a:last-child{color:var(--blue)}
@media(max-width:1000px){.case-hero-grid{grid-template-columns:1fr;gap:3rem}.case-index{display:none}.case-side{border-left:0;border-top:1px solid var(--line);padding:1rem 0 0;display:flex;gap:2rem;flex-wrap:wrap}.case-two-col,.case-system-head,.case-work-grid,.case-evidence-head,.case-next-grid{grid-template-columns:1fr;gap:3rem}.case-flow{grid-template-columns:repeat(2,1fr)}.case-flow-node i{display:none}.case-architecture-line{grid-template-columns:repeat(3,1fr);gap:1rem}.case-evidence-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.case-nav{height:62px;padding:0 5vw;grid-template-columns:1fr auto}.case-nav .nav-center,.case-nav .nav-links{display:none}.case-hero{padding:88px 6vw 20px;min-height:88svh}.case-title-wrap h1{font-size:clamp(4.3rem,15.5vw,6.7rem)}.case-title-wrap p{font-size:.84rem}.case-context,.case-system,.case-work,.case-evidence,.case-next{padding:15vw 6vw}.case-two-col h2,.case-system-head h2,.case-work-grid h2,.case-evidence-head h2,.case-next-grid h2,.case-close h2{font-size:clamp(4rem,15.5vw,6.3rem)}.case-flow{grid-template-columns:1fr;margin-top:3rem}.case-flow-node{min-height:210px}.case-architecture-line{grid-template-columns:1fr 1fr}.case-evidence-grid{grid-template-columns:1fr}.case-evidence-grid article{min-height:200px}.case-close{padding:17vw 6vw;min-height:68svh}.case-close-links{display:grid;gap:1.2rem}}
.work-project{color:inherit;text-decoration:none}

/* CASE STUDY V2.1 — editorial evidence-led system */
.case2-page{--c-paper:#f5f2ea;--c-paper2:#ebe7dc;--c-ink:#111214;--c-muted:#666960;--c-line:#c9c5bb;--c-navy:#0d1530;--c-blue:#2457ff;background:var(--c-paper);color:var(--c-ink);overflow:hidden}
.case2-nav{background:rgba(245,242,234,.94);border-bottom:1px solid rgba(17,18,20,.07)}
.case2-hero{min-height:86svh;padding:116px 6vw 28px;display:flex;flex-direction:column;justify-content:space-between;position:relative;background:var(--c-paper)}
.case2-hero:before{content:"";position:absolute;inset:0;pointer-events:none;opacity:.38;background-image:linear-gradient(rgba(17,18,20,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(17,18,20,.045) 1px,transparent 1px);background-size:80px 80px;mask-image:linear-gradient(to bottom,#000 0%,transparent 78%)}
.case2-hero-top,.case2-scroll,.case2-label{position:relative;z-index:1;display:flex;justify-content:space-between;gap:2rem;font:8px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:#777a72}
.case2-hero-main{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:8vw;align-items:end;margin:8vh 0 6vh}
.case2-hero-copy{max-width:980px}.case2-kicker{font:8px 'DM Mono',monospace;letter-spacing:.11em;text-transform:uppercase;color:var(--c-blue)}
.case2-hero h1{font-size:clamp(4.5rem,7.1vw,8.5rem);line-height:.86;letter-spacing:-.105em;margin:1.35rem 0 2rem;max-width:1000px;font-weight:650}
.case2-hero-copy p{max-width:650px;font-size:1rem;line-height:1.8;color:#5e615a;margin:0}
.case2-hero-aside{border-left:1px solid var(--c-line);padding-left:1.25rem;margin-bottom:.3rem}.case2-hero-aside span{display:block;font:7px 'DM Mono';letter-spacing:.1em;color:#85877f;margin-bottom:.8rem}.case2-hero-aside strong{font-size:.85rem;line-height:1.55;font-weight:500;display:block}
.case2-scroll{border-top:1px solid var(--c-line);padding-top:10px}.case2-scroll i{font-style:normal;color:var(--c-blue);font-size:12px}
.case2-facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--c-line);border-bottom:1px solid var(--c-line);background:#efebe2}.case2-facts div{padding:1.3rem 2rem;border-right:1px solid var(--c-line);min-height:92px;display:flex;flex-direction:column;justify-content:space-between}.case2-facts div:last-child{border-right:0}.case2-facts span{font:7px 'DM Mono';letter-spacing:.1em;color:#81837c}.case2-facts strong{font-size:.82rem;line-height:1.3;font-weight:600}
.case2-context,.case2-interventions,.case2-next{padding:8vw 6vw}.case2-context{background:#f0ece3}.case2-label{border-top:1px solid var(--c-line);padding-top:10px}.case2-context-grid{display:grid;grid-template-columns:1.1fr .65fr;gap:9vw;margin-top:4.5rem}.case2-context h2,.case2-system-head h2,.case2-intervention-head h2,.case2-evidence-intro h2,.case2-next-head h2,.case2-close h2{font-size:clamp(3.2rem,5.3vw,6.3rem);line-height:.9;letter-spacing:-.095em;margin:0;font-weight:600}.case2-context-grid p{font-size:.98rem;line-height:1.85;color:#5f625b;margin:0}.case2-note{display:block;border-top:1px solid #c9c5bb;margin-top:2.2rem;padding-top:1rem;font:8px/1.7 'DM Mono';text-transform:uppercase;letter-spacing:.05em;color:#7c7e77}.case2-system{padding:7vw 6vw;background:var(--c-navy);color:#f4f5f7;position:relative;overflow:hidden}.case2-system:after{content:"";position:absolute;width:65vw;height:65vw;border:1px solid rgba(123,149,255,.13);border-radius:50%;right:-36vw;top:-18vw}.case2-system .case2-label{color:#7e879b;border-color:#30394e}.case2-system-head{position:relative;z-index:1;display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem}.case2-system-head h2 em,.case2-intervention-head h2 em,.case2-evidence-intro h2 em,.case2-next-head h2 em,.case2-close h2 em{font-family:Georgia,serif;font-weight:400;font-style:italic;letter-spacing:-.06em}.case2-system-head p{font-size:.88rem;line-height:1.85;color:#aab1bf;max-width:460px}.case2-system-map{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,1fr);margin-top:4.5rem;border-top:1px solid #343d51;border-bottom:1px solid #343d51}.case2-node{min-height:220px;padding:1.3rem 1.4rem;position:relative;border-right:1px solid #343d51;display:flex;flex-direction:column}.case2-node:last-child{border-right:0}.case2-node small{font:8px 'DM Mono';color:#7887a3}.case2-node b{font-size:1.7rem;letter-spacing:-.07em;margin-top:3.4rem}.case2-node span{font-size:.75rem;color:#9da6b6;margin-top:.55rem}.case2-node i{position:absolute;right:-14px;top:50%;width:28px;height:28px;border:1px solid #59657b;background:var(--c-navy);border-radius:50%;display:grid;place-items:center;color:#7d95ff;font-style:normal;z-index:2}.case2-architecture{position:relative;z-index:1;margin-top:4rem;border-top:1px solid #343d51;padding-top:1rem}.case2-architecture-head{display:flex;justify-content:space-between;gap:2rem;font:8px 'DM Mono';letter-spacing:.09em;text-transform:uppercase;color:#7d879b}.case2-architecture-head em{font-style:normal}.case2-architecture-track{display:grid;grid-template-columns:repeat(6,1fr);margin-top:1.6rem}.case2-architecture-track div{padding:0 1rem;border-left:1px solid #343d51;min-height:78px}.case2-architecture-track div:first-child{border-left:0;padding-left:0}.case2-architecture-track small{font:8px 'DM Mono';color:#7890ff}.case2-architecture-track b{display:block;font-size:.72rem;line-height:1.5;color:#d9dde5;margin-top:.55rem;font-weight:500}
.case2-interventions{background:var(--c-paper)}.case2-intervention-head{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem}.case2-intervention-head p{font-size:.9rem;line-height:1.85;color:#64675f;max-width:460px}.case2-intervention-list{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--c-line);margin-top:4.5rem}.case2-intervention-list article{padding:1.2rem 1.1rem 1.4rem;border-right:1px solid var(--c-line);min-height:250px;transition:background .25s ease,transform .25s ease}.case2-intervention-list article:first-child{border-left:1px solid var(--c-line)}.case2-intervention-list article:hover{background:#ebe7dc;transform:translateY(-4px)}.case2-intervention-list span{font:8px 'DM Mono';color:var(--c-blue)}.case2-intervention-list h3{font-size:1rem;letter-spacing:-.03em;margin:3.5rem 0 .8rem}.case2-intervention-list p{font-size:.73rem;line-height:1.7;color:#656860;margin:0}
.case2-evidence{padding:7vw 6vw;background:#11151d;color:#f3f4f3}.case2-evidence .case2-label{color:#7d8799;border-color:#303641}.case2-evidence-intro{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem}.case2-evidence-intro p{font-size:.86rem;line-height:1.85;color:#9ca5b4;max-width:460px}.case2-evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.2rem;margin-top:4.5rem}.case2-evidence-grid figure{margin:0}.case2-evidence-grid figure.is-wide{grid-column:1/-1}.case2-evidence-image{background:#e9e6de;padding:1.1rem;border:1px solid #303641;overflow:hidden}.case2-evidence-grid img{display:block;width:100%;height:auto;transition:transform .5s ease}.case2-evidence-grid figure:hover img{transform:scale(1.015)}.case2-evidence-grid figcaption{display:grid;grid-template-columns:34px 1fr;gap:1rem;padding-top:.9rem}.case2-evidence-grid figcaption>span{font:8px 'DM Mono';color:#7890ff}.case2-evidence-grid figcaption b{font-size:.82rem;font-weight:600}.case2-evidence-grid figcaption p{font-size:.7rem;line-height:1.6;color:#8e97a5;margin:.35rem 0 0}
.case2-next{background:#eeeadf}.case2-next-head{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem}.case2-next-head p{font-size:.88rem;line-height:1.85;color:#666960;max-width:450px}.case2-next>ol{list-style:none;margin:4rem 0 0;padding:0;border-top:1px solid var(--c-line)}.case2-next li{display:grid;grid-template-columns:50px 1fr;gap:1rem;border-bottom:1px solid var(--c-line);padding:1.2rem 0}.case2-next li span{font:8px 'DM Mono';color:var(--c-blue)}.case2-next li p{margin:0;font-size:.82rem;line-height:1.7;color:#565950;max-width:760px}
.case2-close{min-height:70svh;padding:9vw 6vw;background:#f5f2ea;display:flex;flex-direction:column;justify-content:center}.case2-close>span{font:8px 'DM Mono';letter-spacing:.1em;color:var(--c-blue)}.case2-close h2{margin:1.8rem 0 2.4rem;max-width:900px}.case2-close-links{display:flex;gap:2rem}.case2-close-links a{font:8px 'DM Mono';letter-spacing:.1em;text-transform:uppercase;padding-bottom:.7rem;border-bottom:1px solid #aaa79e}.case2-close-links a:last-child{color:var(--c-blue)}
@media(max-width:1000px){.case2-hero-main,.case2-context-grid,.case2-system-head,.case2-intervention-head,.case2-evidence-intro,.case2-next-head{grid-template-columns:1fr;gap:2.5rem}.case2-system-map{grid-template-columns:repeat(2,1fr)}.case2-node:nth-child(2){border-right:0}.case2-node i{display:none}.case2-architecture-track{grid-template-columns:repeat(3,1fr);gap:1rem}.case2-intervention-list{grid-template-columns:repeat(2,1fr)}.case2-intervention-list article:nth-child(3){border-left:1px solid var(--c-line)}.case2-facts{grid-template-columns:repeat(2,1fr)}.case2-facts div:nth-child(2){border-right:0}.case2-facts div:nth-child(-n+2){border-bottom:1px solid var(--c-line)}}
@media(max-width:620px){.case2-hero{padding:90px 6vw 22px;min-height:82svh}.case2-hero h1{font-size:clamp(3.5rem,14vw,5.3rem);line-height:.9}.case2-hero-main{margin:6vh 0}.case2-hero-top,.case2-scroll,.case2-label{font-size:7px}.case2-facts{grid-template-columns:1fr}.case2-facts div{border-right:0!important;border-bottom:1px solid var(--c-line)}.case2-facts div:last-child{border-bottom:0}.case2-context,.case2-interventions,.case2-next{padding:16vw 6vw}.case2-system,.case2-evidence{padding:14vw 6vw}.case2-system-map{grid-template-columns:1fr}.case2-node{border-right:0;border-bottom:1px solid #343d51;min-height:180px}.case2-node:last-child{border-bottom:0}.case2-node b{margin-top:2.5rem}.case2-architecture-track{grid-template-columns:1fr 1fr}.case2-intervention-list{grid-template-columns:1fr}.case2-intervention-list article{border-left:1px solid var(--c-line);border-bottom:1px solid var(--c-line);min-height:190px}.case2-intervention-list article:nth-child(3){border-left:1px solid var(--c-line)}.case2-evidence-grid{grid-template-columns:1fr}.case2-evidence-grid figure.is-wide{grid-column:auto}.case2-close{padding:18vw 6vw;min-height:65svh}.case2-close h2{font-size:clamp(3.4rem,14vw,5.3rem)}.case2-close-links{display:grid;gap:1.2rem}}

/* EDUGUIDE CASE STUDY V3.1 — evidence rebuilt as native portfolio visuals */
.case3-page{background:var(--c-paper);color:var(--c-ink);overflow:hidden}
.case3-nav{position:absolute!important;top:0;left:0;right:0;z-index:20;background:transparent}
.case3-hero{min-height:92svh;padding:10.5rem 6vw 2rem;display:flex;flex-direction:column;justify-content:space-between;background:#f7f5ef;position:relative}
.case3-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(17,18,20,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(17,18,20,.035) 1px,transparent 1px);background-size:90px 90px;mask-image:linear-gradient(to bottom,#000 0%,transparent 85%);pointer-events:none}
.case3-meta,.case3-section-top,.case3-hero-signal{font:8px 'DM Mono',monospace;letter-spacing:.1em;text-transform:uppercase;color:#777a72;display:flex;justify-content:space-between;gap:2rem;position:relative;z-index:1}
.case3-hero-grid{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:8vw;align-items:end;position:relative;z-index:1;margin:7vh 0 5vh}
.case3-kicker{font:8px 'DM Mono',monospace;letter-spacing:.11em;text-transform:uppercase;color:var(--c-blue)}
.case3-hero h1{font-size:clamp(4rem,6.4vw,7.5rem);line-height:.89;letter-spacing:-.09em;max-width:950px;margin:1.2rem 0 2rem;font-weight:620}
.case3-hero p{font-size:.98rem;line-height:1.8;color:#5f625b;max-width:650px;margin:0}
.case3-hero aside{border-left:1px solid #cbc8bf;padding-left:1.2rem;margin-bottom:.2rem}.case3-hero aside span{display:block;font:7px 'DM Mono';letter-spacing:.1em;color:#85877f;margin-bottom:.75rem}.case3-hero aside strong{display:block;font-size:.86rem;line-height:1.55;font-weight:500}
.case3-hero-signal{border-top:1px solid #cbc8bf;padding-top:10px}.case3-hero-signal i{width:7px;height:7px;border-radius:50%;background:var(--c-blue);display:block;box-shadow:0 0 0 4px rgba(36,87,255,.08)}
.case3-facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #d2cfc6;border-bottom:1px solid #d2cfc6;background:#efebe2}.case3-facts div{padding:1.25rem 2rem;min-height:92px;border-right:1px solid #d2cfc6;display:flex;flex-direction:column;justify-content:space-between}.case3-facts div:last-child{border-right:0}.case3-facts span,.case3-facts b{font-family:'DM Mono',monospace}.case3-facts span{font-size:7px;letter-spacing:.1em;color:#85877f}.case3-facts b{font-size:8px;letter-spacing:.04em;font-weight:500}
.case3-context,.case3-interventions,.case3-scale,.case3-next{padding:8vw 6vw}.case3-section-top{border-top:1px solid #cfccc3;padding-top:10px}.case3-context{background:#f0ece3}.case3-context-grid{display:grid;grid-template-columns:1.1fr .65fr;gap:9vw;margin-top:4.5rem}.case3-context h2,.case3-system h2,.case3-intervention-head h2,.case3-evidence-head h2,.case3-scale h2,.case3-next-head h2,.case3-close h2{font-size:clamp(3rem,5vw,5.9rem);line-height:.92;letter-spacing:-.085em;margin:0;font-weight:600}.case3-context-grid>div>p{font-size:.96rem;line-height:1.85;color:#5f625b;margin:0}.case3-context-note{margin-top:2.3rem;padding:1rem 0;border-top:1px solid #c8c4ba;display:grid;gap:.5rem}.case3-context-note span{font:7px 'DM Mono';letter-spacing:.1em;color:var(--c-blue)}.case3-context-note b{font-size:.8rem;line-height:1.5;font-weight:500}
.case3-system{padding:7vw 6vw;background:#0e1632;color:#f4f5f7;position:relative;overflow:hidden}.case3-system:after{content:"";position:absolute;width:65vw;height:65vw;border:1px solid rgba(123,149,255,.12);border-radius:50%;right:-36vw;top:-20vw}.case3-system .case3-section-top{color:#7e879b;border-color:#30394e}.case3-system-head{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem;position:relative;z-index:1}.case3-system h2 em,.case3-intervention-head h2 em,.case3-evidence-head h2 em,.case3-scale h2 em,.case3-next-head h2 em,.case3-close h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.055em}.case3-system-head p{font-size:.88rem;line-height:1.85;color:#aab1bf;max-width:450px}.case3-system-map{display:grid;grid-template-columns:repeat(4,1fr);margin-top:4.5rem;border-top:1px solid #343d51;border-bottom:1px solid #343d51;position:relative;z-index:1}.case3-node{min-height:185px;padding:1.25rem 1.2rem;position:relative;border-right:1px solid #343d51;display:flex;gap:1rem}.case3-node:last-child{border-right:0}.case3-node-index{font:8px 'DM Mono';color:#7890ff}.case3-node-main{display:flex;flex-direction:column;padding-top:3rem}.case3-node-main strong{font-size:1.25rem;letter-spacing:-.05em}.case3-node-main small{font-size:.72rem;line-height:1.55;color:#9da6b6;margin-top:.5rem;max-width:150px}.case3-node-arrow{position:absolute;right:-14px;top:50%;width:28px;height:28px;border:1px solid #59657b;background:#0e1632;border-radius:50%;display:grid;place-items:center;color:#7d95ff;z-index:2}.case3-node:hover{background:rgba(123,149,255,.04)}.case3-architecture{margin-top:4rem;position:relative;z-index:1;border-top:1px solid #343d51;padding-top:1rem}.case3-architecture-head{display:flex;justify-content:space-between;font:8px 'DM Mono';letter-spacing:.09em;text-transform:uppercase;color:#7d879b}.case3-architecture-track{display:grid;grid-template-columns:repeat(6,1fr);margin-top:1.6rem}.case3-architecture-track div{min-height:75px;padding:0 1rem;border-left:1px solid #343d51}.case3-architecture-track div:first-child{border-left:0;padding-left:0}.case3-architecture-track small{font:8px 'DM Mono';color:#7890ff}.case3-architecture-track b{display:block;font-size:.68rem;line-height:1.45;color:#d9dde5;margin-top:.55rem;font-weight:500}
.case3-interventions{background:#f7f5ef}.case3-intervention-head{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem}.case3-intervention-head p,.case3-evidence-head p,.case3-next-head p{font-size:.88rem;line-height:1.85;color:#64675f;max-width:450px}.case3-intervention-grid{margin-top:4rem;border-top:1px solid #d0cdc4;display:grid;grid-template-columns:repeat(5,1fr)}.case3-intervention-grid article{padding:1.3rem 1.15rem 1.5rem;min-height:245px;border-right:1px solid #d0cdc4;display:flex;flex-direction:column;justify-content:space-between;transition:background .25s ease,transform .25s ease}.case3-intervention-grid article:first-child{border-left:1px solid #d0cdc4}.case3-intervention-grid article:hover{background:#eeeadf;transform:translateY(-3px)}.case3-intervention-grid article>span{font:8px 'DM Mono';color:var(--c-blue)}.case3-intervention-grid h3{font-size:1rem;letter-spacing:-.03em;margin:0 0 .65rem}.case3-intervention-grid p{font-size:.72rem;line-height:1.7;color:#656860;margin:0}
.case3-evidence{padding:7vw 6vw;background:#11151d;color:#f3f4f3}.case3-evidence .case3-section-top{color:#7d8799;border-color:#303641}.case3-evidence-head{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem}.case3-evidence-head p{color:#9ca5b4}.case3-evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:4.2rem}.case3-evidence-grid figure{margin:0}.case3-evidence-feature{grid-column:1/-1}.case3-evidence-wide{grid-column:1/-1}.case3-art{background:#f0ede5;color:#12161f;border:1px solid #343a46;min-height:330px;padding:1.4rem;position:relative;overflow:hidden}.case3-art-caption{font:8px 'DM Mono';letter-spacing:.1em;color:#737870;position:absolute;top:1.1rem;left:1.2rem}.case3-art-architecture{display:flex;flex-direction:column;align-items:center;justify-content:center}.case3-arch-root{margin-top:2rem;padding:.8rem 1.5rem;border:1px solid #151a24;font:700 1.2rem 'DM Mono';letter-spacing:.05em}.case3-arch-line{height:45px;width:1px;background:#151a24}.case3-arch-row{display:grid;grid-template-columns:repeat(3,1fr);width:min(720px,90%);border-top:1px solid #151a24;border-bottom:1px solid #151a24}.case3-arch-row span{padding:1rem;text-align:center;font:700 .78rem 'DM Mono';border-right:1px solid #151a24}.case3-arch-row span:last-child{border-right:0}.case3-arch-subrow{display:grid;grid-template-columns:repeat(3,1fr);width:min(720px,90%)}.case3-arch-subrow span{text-align:center;padding:.65rem;font:7px 'DM Mono';color:#777c75}.case3-arch-foot{margin-top:2rem;display:flex;align-items:center;gap:1rem;font:8px 'DM Mono';color:#3d4350}.case3-arch-foot i{color:var(--c-blue);font-style:normal}.case3-course-top{margin-top:2.8rem;display:grid;grid-template-columns:1fr 2fr auto;align-items:end;border-bottom:1px solid #bfc0b9;padding-bottom:1rem}.case3-course-top span,.case3-course-top em{font:8px 'DM Mono';color:#737870;font-style:normal}.case3-course-top b{font-size:2.2rem;letter-spacing:-.07em}.case3-course-grid{display:grid;grid-template-columns:1fr 1fr;margin-top:1rem}.case3-course-grid span{padding:.8rem 0;border-bottom:1px solid #d2d0c8;font-size:.75rem}.case3-course-grid i{font:7px 'DM Mono';color:var(--c-blue);margin-right:.7rem;font-style:normal}.case3-course-path{position:absolute;bottom:1.3rem;left:1.3rem;right:1.3rem;display:flex;gap:.8rem;align-items:center;font:7px 'DM Mono';color:#737870}.case3-course-path b{color:var(--c-blue)}.case3-art-tech{background:#0e1632;color:#eef1f6}.case3-art-tech .case3-art-caption{color:#8e98aa}.case3-tech-status{margin-top:2.8rem;font:8px 'DM Mono';color:#a8b0be;display:flex;gap:.55rem;align-items:center}.case3-status-dot{width:7px;height:7px;background:#7890ff;border-radius:50%;box-shadow:0 0 0 5px rgba(120,144,255,.08)}.case3-tech-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:#343d51;margin-top:1.6rem}.case3-tech-grid div{background:#0e1632;padding:1rem;min-height:85px;display:flex;flex-direction:column;justify-content:space-between}.case3-tech-grid span{font:7px 'DM Mono';color:#7890ff}.case3-tech-grid b{font:8px 'DM Mono';letter-spacing:.04em}.case3-tech-grid small{font:6px 'DM Mono';color:#7f899a}.case3-art-content{min-height:240px;display:flex;align-items:center;justify-content:center}.case3-content-orbit{width:190px;height:190px;border:1px solid #a9aaa3;border-radius:50%;display:grid;place-items:center;position:relative}.case3-content-orbit b{font-size:1.5rem;letter-spacing:-.06em}.case3-content-orbit span{position:absolute;font:7px 'DM Mono';letter-spacing:.06em}.case3-content-orbit span:first-child{top:18px}.case3-content-orbit span:last-child{bottom:18px}.case3-content-list{position:absolute;right:1.3rem;top:50%;transform:translateY(-50%);display:grid;gap:.45rem}.case3-content-list span{font:7px 'DM Mono';color:#555a55;border-left:2px solid #7890ff;padding-left:.45rem}.case3-evidence-grid figcaption{display:grid;grid-template-columns:30px 1fr;gap:.9rem;padding-top:.9rem}.case3-evidence-grid figcaption>span{font:8px 'DM Mono';color:#7890ff}.case3-evidence-grid figcaption b{font-size:.82rem}.case3-evidence-grid figcaption p{font-size:.7rem;line-height:1.6;color:#8e97a5;margin:.3rem 0 0;max-width:560px}
.case3-scale{background:#efebe2}.case3-scale-grid{display:grid;grid-template-columns:1fr .75fr;gap:9vw;margin-top:4.5rem}.case3-scale-rail{border-top:1px solid #cfccc3}.case3-scale-rail div{display:grid;grid-template-columns:34px 1fr;column-gap:1rem;border-bottom:1px solid #cfccc3;padding:1.1rem 0}.case3-scale-rail span{font:8px 'DM Mono';color:var(--c-blue)}.case3-scale-rail b{font:8px 'DM Mono';letter-spacing:.08em}.case3-scale-rail small{grid-column:2;font-size:.7rem;color:#696d66;margin-top:.35rem}
.case3-next{background:#f7f5ef}.case3-next-head{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:4.5rem}.case3-next>ol{list-style:none;margin:4rem 0 0;padding:0;border-top:1px solid #d0cdc4}.case3-next li{display:grid;grid-template-columns:50px 1fr;gap:1rem;padding:1.2rem 0;border-bottom:1px solid #d0cdc4}.case3-next li span{font:8px 'DM Mono';color:var(--c-blue)}.case3-next li p{margin:0;font-size:.82rem;line-height:1.7;color:#565950;max-width:760px}
.case3-close{min-height:68svh;padding:9vw 6vw;background:#0e1632;color:#f4f5f7;display:flex;flex-direction:column;justify-content:center}.case3-close>span{font:8px 'DM Mono';letter-spacing:.1em;color:#7890ff}.case3-close h2{max-width:900px;margin:1.6rem 0 1.5rem}.case3-close>p{font-size:.9rem;line-height:1.8;color:#aab1bf;max-width:520px;margin:0}.case3-close-links{display:flex;gap:2rem;margin-top:2.2rem}.case3-close-links a{font:8px 'DM Mono';letter-spacing:.1em;text-transform:uppercase;padding-bottom:.7rem;border-bottom:1px solid #59657b}.case3-close-links a:last-child{color:#7890ff}.case3-close-links b{font-size:12px}
@media(max-width:1000px){.case3-hero-grid,.case3-context-grid,.case3-system-head,.case3-intervention-head,.case3-evidence-head,.case3-scale-grid,.case3-next-head{grid-template-columns:1fr;gap:2.5rem}.case3-system-map{grid-template-columns:repeat(2,1fr)}.case3-node:nth-child(2){border-right:0}.case3-node-arrow{display:none}.case3-architecture-track{grid-template-columns:repeat(3,1fr);gap:1rem}.case3-intervention-grid{grid-template-columns:repeat(2,1fr)}.case3-intervention-grid article:nth-child(3){border-left:1px solid #d0cdc4}.case3-facts{grid-template-columns:repeat(2,1fr)}.case3-facts div:nth-child(2){border-right:0}.case3-facts div:nth-child(-n+2){border-bottom:1px solid #d2cfc6}}
@media(max-width:620px){.case3-hero{min-height:86svh;padding:88px 6vw 1.5rem}.case3-meta{font-size:7px}.case3-meta span:nth-child(2){display:none}.case3-hero h1{font-size:clamp(3.3rem,14vw,5rem);line-height:.91}.case3-hero-grid{margin:6vh 0 4vh}.case3-hero aside{margin-top:1rem}.case3-facts{grid-template-columns:1fr}.case3-facts div{border-right:0!important;border-bottom:1px solid #d2cfc6}.case3-facts div:last-child{border-bottom:0}.case3-context,.case3-interventions,.case3-scale,.case3-next{padding:15vw 6vw}.case3-system,.case3-evidence{padding:14vw 6vw}.case3-system-map{grid-template-columns:1fr}.case3-node{border-right:0;border-bottom:1px solid #343d51;min-height:150px}.case3-node:last-child{border-bottom:0}.case3-node-main{padding-top:2rem}.case3-architecture-track{grid-template-columns:1fr 1fr}.case3-intervention-grid{grid-template-columns:1fr}.case3-intervention-grid article{border-left:1px solid #d0cdc4;border-bottom:1px solid #d0cdc4;min-height:190px}.case3-evidence-grid{grid-template-columns:1fr}.case3-evidence-feature,.case3-evidence-wide{grid-column:auto}.case3-art{min-height:300px}.case3-arch-row,.case3-arch-subrow{width:100%}.case3-arch-row span{font-size:7px;padding:.75rem .3rem}.case3-arch-subrow span{font-size:6px;padding:.5rem .2rem}.case3-tech-grid{grid-template-columns:1fr 1fr}.case3-content-list{position:static;transform:none;margin-left:1rem}.case3-art-content{justify-content:space-between}.case3-close{padding:16vw 6vw;min-height:65svh}.case3-close h2{font-size:clamp(3.2rem,13vw,5rem)}.case3-close-links{display:grid;gap:1.2rem}}

/* EDU GUIDE CASE STUDY V5 — editorial + interactive polish */
.case3-page{font-size:16px}
.case3-page .case3-section-top{font-size:10px;letter-spacing:.13em}
.case3-page .case3-kicker,.case3-page .case3-meta,.case3-page .case3-hero-signal{font-size:10px}
.case3-page p{font-size:clamp(.96rem,1.05vw,1.08rem)}
.case3-hero{min-height:auto;padding:8.5rem 5.5vw 2.5rem}
.case3-hero-grid{grid-template-columns:minmax(0,1.05fr) minmax(260px,.42fr);gap:6vw;margin:5.5vh 0 3rem;align-items:start}
.case3-hero h1{font-size:clamp(4rem,6vw,6.8rem);max-width:900px;line-height:.9}
.case3-hero p{font-size:1.05rem;max-width:680px;line-height:1.75}
.case3-hero aside strong{font-size:1rem;line-height:1.6}
.case3-live-preview{position:relative;z-index:2;margin:0 0 2rem;perspective:1400px}
.case3-browserbar{height:38px;border:1px solid #c9c6bd;border-bottom:0;background:#ebe7de;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 14px;font:9px 'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;color:#73776f}
.case3-browserbar>span:last-child{text-align:right}
.browser-dots{display:flex;gap:5px}.browser-dots i{width:6px;height:6px;border-radius:50%;background:#b8b6ae;display:block}
.case3-browserstage{position:relative;border:1px solid #c9c6bd;background:#e5e1d8;min-height:420px;overflow:hidden;transform:rotateX(1deg);box-shadow:0 25px 70px rgba(13,21,48,.12);transition:transform .6s cubic-bezier(.2,.8,.2,1),box-shadow .6s ease}
.case3-live-preview:hover .case3-browserstage{transform:rotateX(0) rotateY(-1deg) translateY(-5px);box-shadow:0 32px 80px rgba(13,21,48,.17)}
.case3-site-preview{position:absolute;inset:0 0 0 0;background:linear-gradient(180deg,#fbfaf6 0%,#f1eee7 100%);overflow:hidden;color:#111827}
.preview-nav{height:48px;display:flex;align-items:center;gap:24px;padding:0 24px;border-bottom:1px solid #ddd9d0;font:9px 'DM Mono',monospace;color:#62665e}.preview-nav b{margin-right:auto;letter-spacing:.08em;color:#10152a}.preview-nav strong{padding:8px 12px;border:1px solid #1b2340;font-weight:500;color:#1b2340}
.preview-hero-copy{padding:54px 7% 44px;max-width:700px}.preview-hero-copy small{font:9px 'DM Mono';letter-spacing:.12em;color:#2457ff}.preview-hero-copy h3{font-size:clamp(2.6rem,5vw,5.6rem);line-height:.88;letter-spacing:-.075em;margin:16px 0 12px;font-weight:650}.preview-hero-copy p{font-family:Georgia,serif;font-style:italic;font-size:1.25rem;color:#62665e;margin:0 0 22px}.preview-hero-copy button{border:1px solid #171c2b;background:#171c2b;color:#fff;padding:11px 15px;font:9px 'DM Mono';letter-spacing:.04em}.preview-hero-copy button span{color:#7b95ff;margin-left:8px}
.preview-stat-row{display:grid;grid-template-columns:repeat(3,1fr);margin:0 7%;border-top:1px solid #c9c6bd}.preview-stat-row div{padding:15px 14px;border-right:1px solid #c9c6bd}.preview-stat-row div:last-child{border-right:0}.preview-stat-row b,.preview-stat-row span{display:block}.preview-stat-row b{font:14px 'DM Mono';color:#111827}.preview-stat-row span{font-size:10px;color:#777b73;margin-top:4px}
.case3-preview-note{position:absolute;right:18px;bottom:18px;width:220px;padding:14px;background:rgba(14,22,50,.96);color:#fff;border:1px solid rgba(123,149,255,.3);box-shadow:0 15px 35px rgba(0,0,0,.18)}.case3-preview-note span{font:8px 'DM Mono';color:#7890ff}.case3-preview-note b{display:block;font-size:13px;line-height:1.25;margin:8px 0}.case3-preview-note small{display:block;color:#aeb6c4;font-size:10px;line-height:1.5}
.case3-facts{grid-template-columns:repeat(4,1fr)}.case3-facts div{min-height:105px;padding:1.35rem 1.8rem}.case3-facts span{font-size:9px}.case3-facts b{font-size:10px}
.case3-context,.case3-interventions,.case3-scale,.case3-next{padding:8vw 5.5vw}.case3-system,.case3-evidence{padding:7.5vw 5.5vw}.case3-context h2,.case3-system h2,.case3-intervention-head h2,.case3-evidence-head h2,.case3-scale h2,.case3-next-head h2,.case3-close h2{font-size:clamp(3.4rem,5vw,6rem);line-height:.91}
.case3-context-grid>div>p,.case3-intervention-head p,.case3-evidence-head p,.case3-next-head p{font-size:1rem;line-height:1.8}
.case3-context-note b{font-size:.95rem}.case3-node-main strong{font-size:1.4rem}.case3-node-main small{font-size:.86rem;line-height:1.6}.case3-node{min-height:205px;padding:1.35rem}.case3-architecture-track b{font-size:.78rem}.case3-architecture-track small{font-size:9px}
.case3-intervention-grid{grid-template-columns:repeat(5,1fr)}.case3-intervention-grid article{min-height:270px;padding:1.5rem 1.2rem}.case3-intervention-grid h3{font-size:1.08rem}.case3-intervention-grid p{font-size:.82rem;line-height:1.7}
.case3-evidence-grid{gap:1.5rem}.case3-art{min-height:370px;border-radius:2px}.case3-evidence-grid figcaption b{font-size:.95rem}.case3-evidence-grid figcaption p{font-size:.82rem;line-height:1.65}
.case3-scale-rail small{font-size:.8rem}.case3-next li p{font-size:.92rem}.case3-close{padding:9vw 5.5vw}.case3-close>p{font-size:1rem}

/* Scroll-driven reveal language */
.case3-reveal-section .case3-section-top,.case3-reveal-section h2,.case3-reveal-section p,.case3-reveal-section .case3-intervention-grid,.case3-reveal-section .case3-evidence-grid,.case3-reveal-section .case3-scale-rail,.case3-reveal-section ol{transition:opacity .8s ease,transform .8s cubic-bezier(.2,.8,.2,1)}
.case3-reveal-section:not(.is-in-view) .case3-section-top{opacity:0;transform:translateY(12px)}
.case3-reveal-section:not(.is-in-view) h2{opacity:0;transform:translateY(26px)}
.case3-reveal-section:not(.is-in-view) p,.case3-reveal-section:not(.is-in-view) .case3-intervention-grid,.case3-reveal-section:not(.is-in-view) .case3-evidence-grid,.case3-reveal-section:not(.is-in-view) .case3-scale-rail,.case3-reveal-section:not(.is-in-view) ol{opacity:0;transform:translateY(22px)}
.case3-system-map .case3-node{transition:background .35s ease,transform .45s cubic-bezier(.2,.8,.2,1),border-color .35s ease}.case3-system-map:hover .case3-node{opacity:.42}.case3-system-map .case3-node:hover{opacity:1;transform:translateY(-8px);background:rgba(123,149,255,.07);border-color:#5d6b88}.case3-system-map .case3-node:hover .case3-node-index{color:#fff}
.case3-architecture-track div{transition:transform .35s ease,color .35s ease,border-color .35s ease}.case3-architecture-track div:hover{transform:translateY(-5px);border-color:#7890ff}.case3-intervention-grid article{transition:background .35s ease,transform .35s ease,box-shadow .35s ease}.case3-intervention-grid article:hover{box-shadow:0 15px 30px rgba(13,21,48,.08)}
.case3-art{transition:transform .5s cubic-bezier(.2,.8,.2,1),box-shadow .5s ease}.case3-evidence-grid figure:hover .case3-art{transform:translateY(-6px);box-shadow:0 18px 40px rgba(0,0,0,.18)}
.case3-close-links a{transition:transform .3s ease,color .3s ease,border-color .3s ease}.case3-close-links a:hover{transform:translateX(5px);color:#fff!important;border-color:#7890ff}

@media(max-width:1000px){.case3-live-preview{margin-top:1rem}.case3-intervention-grid{grid-template-columns:repeat(2,1fr)}.case3-browserstage{min-height:360px}.case3-page .case3-hero h1{font-size:clamp(3.8rem,8vw,6rem)}}
@media(max-width:620px){.case3-hero{padding:88px 6vw 1.5rem}.case3-hero h1{font-size:clamp(3.5rem,15vw,5.4rem)}.case3-hero p{font-size:.98rem}.case3-browserbar{grid-template-columns:auto 1fr}.case3-browserbar>span:nth-child(2){text-align:center}.case3-browserbar>span:last-child{display:none}.case3-browserstage{min-height:390px}.preview-nav{padding:0 12px;gap:10px}.preview-nav span{display:none}.preview-nav strong{padding:6px 8px}.preview-hero-copy{padding:42px 8% 32px}.preview-hero-copy h3{font-size:3rem}.preview-stat-row{margin:0 8%}.preview-stat-row div{padding:10px 8px}.preview-stat-row b{font-size:11px}.preview-stat-row span{font-size:8px}.case3-preview-note{right:10px;bottom:10px;width:180px}.case3-intervention-grid{grid-template-columns:1fr}.case3-art{min-height:310px}.case3-page .case3-context h2,.case3-page .case3-system h2,.case3-page .case3-intervention-head h2,.case3-page .case3-evidence-head h2,.case3-page .case3-scale h2,.case3-page .case3-next-head h2{font-size:clamp(3.1rem,13vw,5rem)}}

/* STUDENT HOUSING CASE STUDY — evidence visual layer */
.case3-art-student{background:#0e1632;color:#f4f5f7;min-height:370px;overflow:hidden}
.case3-art-student .case3-art-caption{color:#7f8ba2}
.case3-student-visual{height:100%;min-height:320px;display:flex;flex-direction:column;justify-content:flex-end;padding-top:3.5rem}
.case3-student-metric{display:flex;align-items:flex-end;gap:.8rem;border-bottom:1px solid #343d51;padding-bottom:1rem;position:relative;z-index:1}
.case3-student-metric b{font:600 clamp(3.5rem,7vw,6.5rem)/.85 'Space Grotesk',sans-serif;letter-spacing:-.08em;color:#f5f7fb}
.case3-student-metric span{font:8px 'DM Mono',monospace;letter-spacing:.12em;color:#7890ff;padding-bottom:.25rem}
.case3-student-bars{height:125px;display:flex;align-items:flex-end;gap:clamp(5px,1vw,12px);padding:1.2rem 0 0;border-bottom:1px solid #343d51}
.case3-student-bars i{display:block;flex:1;min-width:8px;background:linear-gradient(180deg,#7890ff,rgba(120,144,255,.12));opacity:.9;transform-origin:bottom;transition:transform .35s ease,opacity .35s ease}
.case3-art-student:hover .case3-student-bars i{opacity:.55}
.case3-art-student:hover .case3-student-bars i:nth-child(3n){opacity:1;transform:scaleY(1.06)}
.case3-student-source{display:flex;justify-content:space-between;gap:1rem;padding-top:.9rem;font:8px 'DM Mono',monospace;letter-spacing:.06em}
.case3-student-source span{color:#7890ff}.case3-student-source b{font-weight:500;color:#c8ced9;text-align:right;max-width:58%}
.case3-art-student-2{background:#11151d}.case3-art-student-3{background:#f0ede5;color:#111827}.case3-art-student-3 .case3-art-caption{color:#777b73}.case3-art-student-3 .case3-student-metric{border-color:#c9c6bd}.case3-art-student-3 .case3-student-metric b{color:#111827}.case3-art-student-3 .case3-student-metric span{color:#2457ff}.case3-art-student-3 .case3-student-bars{border-color:#c9c6bd}.case3-art-student-3 .case3-student-bars i{background:linear-gradient(180deg,#2457ff,rgba(36,87,255,.08))}.case3-art-student-3 .case3-student-source span{color:#2457ff}.case3-art-student-3 .case3-student-source b{color:#555a55}
.case3-art-student-4{background:#e8e5dc;color:#111827}.case3-art-student-4 .case3-art-caption{color:#777b73}.case3-art-student-4 .case3-student-metric{border-color:#c7c4bb}.case3-art-student-4 .case3-student-metric b{color:#111827}.case3-art-student-4 .case3-student-metric span{color:#2457ff}.case3-art-student-4 .case3-student-bars{border-color:#c7c4bb}.case3-art-student-4 .case3-student-bars i{background:linear-gradient(180deg,#111827,rgba(17,24,39,.12))}.case3-art-student-4 .case3-student-source span{color:#2457ff}.case3-art-student-4 .case3-student-source b{color:#555a55}
.case3-scale-intro{margin-top:1.8rem;max-width:540px;color:#64675f}
@media(max-width:620px){.case3-student-metric b{font-size:3.7rem}.case3-student-bars{height:105px}.case3-student-source{font-size:7px}.case3-student-source b{max-width:52%}}

/* Student Housing case-study refinement — scoped so EduGuide remains unchanged. */
.case3-page[data-case-study="student-housing"] .case3-context h2,
.case3-page[data-case-study="student-housing"] .case3-system h2,
.case3-page[data-case-study="student-housing"] .case3-intervention-head h2,
.case3-page[data-case-study="student-housing"] .case3-evidence-head h2,
.case3-page[data-case-study="student-housing"] .case3-scale h2,
.case3-page[data-case-study="student-housing"] .case3-next-head h2,
.case3-page[data-case-study="student-housing"] .case3-close h2{
  font-size:clamp(3rem,4.35vw,5.35rem);
}
.case3-page[data-case-study="student-housing"] .case3-context-grid,
.case3-page[data-case-study="student-housing"] .case3-system-head,
.case3-page[data-case-study="student-housing"] .case3-intervention-head,
.case3-page[data-case-study="student-housing"] .case3-evidence-head,
.case3-page[data-case-study="student-housing"] .case3-scale-grid{
  margin-top:3.4rem;
}
.case3-page[data-case-study="student-housing"] .case3-evidence-grid{
  margin-top:3.5rem;
}
.case3-page[data-case-study="student-housing"] .case3-evidence-grid figure:first-child .case3-art{
  min-height:350px;
}
.case3-page[data-case-study="student-housing"] .case3-evidence-grid figure:not(:first-child) .case3-art{
  min-height:320px;
}
.case3-page[data-case-study="student-housing"] .case3-intervention-grid article{
  min-height:235px;
}
.case3-source-evidence{
  margin-top:4.5rem;
  border-top:1px solid #303641;
  padding-top:1.25rem;
}
.case3-source-head{
  display:grid;
  grid-template-columns:1fr .55fr;
  gap:8vw;
  align-items:end;
}
.case3-source-head h3{
  margin:.65rem 0 0;
  font-size:clamp(1.8rem,3vw,3.15rem);
  line-height:.98;
  letter-spacing:-.055em;
  font-weight:500;
}
.case3-source-head p{
  margin:0;
  color:#9ca5b4;
  font-size:.82rem;
  line-height:1.8;
  max-width:450px;
}
.case3-source-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:1.25rem;
  margin-top:2rem;
}
.case3-source-card{
  background:#f2efe7;
  color:#151922;
  border:1px solid #343a46;
  overflow:hidden;
}
.case3-source-ga4{background:#f7f7f7}
.case3-source-bar{
  display:flex;
  justify-content:space-between;
  gap:1rem;
  padding:.85rem 1rem;
  background:#11151d;
  color:#aeb6c4;
  font:7px 'DM Mono',monospace;
  letter-spacing:.08em;
}
.case3-source-screen{
  min-height:340px;
  padding:1.25rem;
}
.case3-source-screen-top{
  display:flex;
  justify-content:space-between;
  gap:1rem;
  align-items:center;
  padding-bottom:1rem;
  border-bottom:1px solid #d5d5d0;
  font:8px 'DM Mono',monospace;
  color:#747871;
}
.case3-source-screen-top b{font-size:1rem;font-family:inherit;color:#171b24}
.case3-source-kpis{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#d6d6d0;margin-top:1.1rem}
.case3-source-kpis div{background:#f2efe7;padding:1rem;display:flex;flex-direction:column}
.case3-source-kpis small,.case3-ga4-stats small{font:7px 'DM Mono',monospace;letter-spacing:.08em;color:#777c76}
.case3-source-kpis strong{font:600 2.65rem/.9 'Space Grotesk',sans-serif;letter-spacing:-.07em;margin-top:.45rem}
.case3-source-kpis em{font:7px 'DM Mono',monospace;color:#7890ff;font-style:normal;margin-top:.45rem}
.case3-source-chart{height:75px;display:flex;align-items:flex-end;gap:5px;margin:1.1rem 0;border-bottom:1px solid #cfcfc8;padding:0 .25rem}
.case3-source-chart i{flex:1;background:linear-gradient(180deg,#7890ff,rgba(120,144,255,.12));height:var(--h,60%);display:block}
.case3-source-chart i:nth-child(1){height:25%}.case3-source-chart i:nth-child(2){height:35%}.case3-source-chart i:nth-child(3){height:30%}.case3-source-chart i:nth-child(4){height:44%}.case3-source-chart i:nth-child(5){height:39%}.case3-source-chart i:nth-child(6){height:57%}.case3-source-chart i:nth-child(7){height:52%}.case3-source-chart i:nth-child(8){height:70%}.case3-source-chart i:nth-child(9){height:62%}.case3-source-chart i:nth-child(10){height:78%}
.case3-source-table{display:grid;grid-template-columns:1fr auto;gap:.2rem .8rem;padding:.55rem 0;border-bottom:1px solid #deded8;font:7px 'DM Mono',monospace}
.case3-source-table b{text-align:right;color:#2457ff}.case3-source-table small{grid-column:1/-1;color:#888d86}
.case3-source-foot{display:flex;gap:1rem;justify-content:space-between;padding:.75rem 1rem;border-top:1px solid #c9c9c4;font:7px 'DM Mono',monospace;color:#737871}
.case3-source-foot b{color:#2457ff;white-space:nowrap}
.case3-ga4-chart{display:grid;gap:.75rem;margin:1.5rem 0}
.case3-ga4-chart div{display:grid;grid-template-columns:95px 1fr;gap:.6rem;align-items:center;font:7px 'DM Mono',monospace;color:#6d716d}
.case3-ga4-chart i{display:block;height:15px;background:#2d72dc}
.case3-ga4-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#d8d8d8;margin-top:1.25rem}
.case3-ga4-stats div{background:#fff;padding:.7rem;min-height:70px;display:flex;flex-direction:column;justify-content:space-between}
.case3-ga4-stats b{font:600 1.65rem/.9 'Space Grotesk',sans-serif;letter-spacing:-.06em}
.case3-ga4-note{margin-top:1rem;padding:.7rem;background:#eef2f8;border-left:2px solid #2d72dc;font:7px/1.55 'DM Mono',monospace;color:#6b706c}
.case3-ga4-note b{font-weight:500;color:#252b34}
@media(max-width:1000px){
  .case3-source-head{grid-template-columns:1fr;gap:1.5rem}
  .case3-source-grid{grid-template-columns:1fr}
}
@media(max-width:620px){
  .case3-page[data-case-study="student-housing"] .case3-context h2,
  .case3-page[data-case-study="student-housing"] .case3-system h2,
  .case3-page[data-case-study="student-housing"] .case3-intervention-head h2,
  .case3-page[data-case-study="student-housing"] .case3-evidence-head h2,
  .case3-page[data-case-study="student-housing"] .case3-scale h2,
  .case3-page[data-case-study="student-housing"] .case3-next-head h2,
  .case3-page[data-case-study="student-housing"] .case3-close h2{font-size:clamp(3rem,12vw,4.7rem)}
  .case3-source-screen{min-height:300px;padding:1rem}
  .case3-ga4-stats{grid-template-columns:1fr 1fr}
  .case3-source-foot{display:grid;gap:.35rem}
}

/* Student Housing — real website surface / source imagery */
.case3-site-surface{padding:7vw 6vw;background:#e9e5dc;color:#111827;position:relative;overflow:hidden}
.case3-site-surface .case3-section-top{border-color:#c9c5bb;color:#6e746d}
.case3-site-surface-head{display:grid;grid-template-columns:1fr .55fr;gap:8vw;align-items:end;margin-top:3.4rem}
.case3-site-surface-head h2{font-size:clamp(3rem,4.35vw,5.35rem);line-height:.92;letter-spacing:-.085em;margin:.65rem 0 0;font-weight:600}
.case3-site-surface-head h2 em{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.055em}
.case3-site-surface-head p{font-size:.88rem;line-height:1.85;color:#64675f;max-width:450px;margin:0}
.case3-site-gallery{display:grid;grid-template-columns:1.15fr .85fr;gap:1.25rem;margin-top:3.5rem}
.case3-site-gallery figure{margin:0}
.case3-site-gallery-feature{grid-column:1/-1}
.case3-site-gallery-wide{grid-column:1/-1}
.case3-site-image{background:#fff;border:1px solid #cbc7bd;overflow:hidden;position:relative;box-shadow:0 18px 50px rgba(20,25,32,.08)}
.case3-site-image:before{content:'STUDENTHOUSING.CO.IN';position:absolute;top:0;left:0;right:0;height:26px;padding:8px 12px;background:#111827;color:#9da6b5;font:6px 'DM Mono',monospace;letter-spacing:.1em;z-index:2}
.case3-site-image img{display:block;width:100%;height:auto;margin-top:26px;image-rendering:auto}
.case3-site-gallery-feature .case3-site-image img{max-height:610px;object-fit:cover;object-position:top}
.case3-site-gallery figure:nth-child(2) .case3-site-image img{max-height:440px;object-fit:cover;object-position:top}
.case3-site-gallery figure:nth-child(3) .case3-site-image img{max-height:540px;object-fit:cover;object-position:top}
.case3-site-gallery-wide .case3-site-image img{max-height:610px;object-fit:cover;object-position:top}
.case3-site-gallery figcaption{display:grid;grid-template-columns:30px 1fr;gap:.9rem;padding:.9rem 0 0}
.case3-site-gallery figcaption>span{font:8px 'DM Mono';color:#2457ff}
.case3-site-gallery figcaption b{font-size:.82rem}
.case3-site-gallery figcaption p{font-size:.7rem;line-height:1.6;color:#64675f;margin:.3rem 0 0;max-width:600px}
@media(max-width:1000px){
  .case3-site-surface-head{grid-template-columns:1fr;gap:1.5rem}
  .case3-site-gallery{grid-template-columns:1fr}
  .case3-site-gallery-feature,.case3-site-gallery-wide{grid-column:auto}
}
@media(max-width:620px){
  .case3-site-surface-head h2{font-size:clamp(3rem,12vw,4.7rem)}
  .case3-site-image:before{height:22px;padding:7px 9px}
  .case3-site-image img{margin-top:22px}
}

/* Student Housing — evidence board v2 */
.sh-evidence-board{margin-top:3.8rem;display:grid;gap:1rem}
.sh-evidence-intro{display:flex;justify-content:space-between;gap:2rem;align-items:end;padding:0 0 1.4rem;border-bottom:1px solid #303641}
.sh-evidence-flow{display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;font:8px 'DM Mono',monospace;letter-spacing:.1em;color:#aab1bf}
.sh-evidence-flow span{padding:.5rem .65rem;border:1px solid #39404c;background:#151a22;color:#f1f3f5}
.sh-evidence-flow i{font-style:normal;color:#7890ff}
.sh-evidence-intro>p{max-width:430px;margin:0;color:#8f98a7;font-size:.78rem;line-height:1.7}
.sh-gsc-panel,.sh-ai-panel,.sh-query-panel,.sh-visit-panel,.sh-insight-panel{border:1px solid #303641;background:#151a22;overflow:hidden}
.sh-panel-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;padding:1.25rem 1.35rem;border-bottom:1px solid #303641}
.sh-panel-head span{display:block;font:7px 'DM Mono',monospace;letter-spacing:.1em;color:#7890ff}
.sh-panel-head h3{margin:.45rem 0 0;font-size:clamp(1.45rem,2.3vw,2.45rem);line-height:.98;letter-spacing:-.055em;font-weight:500;color:#f2f4f7}
.sh-panel-head small{font:7px 'DM Mono',monospace;letter-spacing:.08em;color:#7f8999;white-space:nowrap}
.sh-gsc-comparison{display:grid;grid-template-columns:1fr 90px 1fr;gap:1rem;align-items:center;padding:1.5rem 1.35rem 1.15rem}
.sh-gsc-side{padding:1.15rem;background:#10151d;border:1px solid #303641}
.sh-gsc-side small{display:block;font:7px 'DM Mono',monospace;letter-spacing:.1em;color:#7f8999}
.sh-gsc-side strong{display:block;margin:.45rem 0 .2rem;font:600 clamp(3rem,5vw,5rem)/.88 'Space Grotesk',sans-serif;letter-spacing:-.08em;color:#e8ebf0}
.sh-gsc-side span{font:7px 'DM Mono',monospace;color:#818a99}
.sh-gsc-current{background:#f0ede5;color:#151922;border-color:#d8d4ca}
.sh-gsc-current small,.sh-gsc-current span{color:#666b66}
.sh-gsc-current strong{color:#111827}
.sh-gsc-arrow{text-align:center;font:2rem 'Space Grotesk';color:#7890ff}
.sh-gsc-arrow small{display:block;margin-top:.25rem;font:7px 'DM Mono',monospace;letter-spacing:.06em}
.sh-gsc-bar{height:4px;background:#303641;margin-top:1rem;overflow:hidden}
.sh-gsc-current .sh-gsc-bar{background:#d4d1c8}
.sh-gsc-bar i{display:block;height:100%;background:#7890ff}
.sh-gsc-impressions{padding-top:0}
.sh-panel-note{display:flex;gap:1rem;padding:.9rem 1.35rem;border-top:1px solid #303641;font:7px/1.6 'DM Mono',monospace;color:#8992a0}
.sh-panel-note b{color:#7890ff;white-space:nowrap}
.sh-ai-panel{background:#f0ede5;color:#151922}
.sh-ai-panel .sh-panel-head{border-color:#d0cdc4}
.sh-ai-panel .sh-panel-head span{color:#2457ff}
.sh-ai-panel .sh-panel-head h3{color:#151922}
.sh-ai-panel .sh-panel-head small{color:#666b66}
.sh-ai-panel .sh-panel-head>strong{font:600 clamp(2.5rem,4vw,4.6rem)/.85 'Space Grotesk';letter-spacing:-.08em;color:#111827;white-space:nowrap}
.sh-ai-panel .sh-panel-head>strong small{display:block;text-align:right;margin-top:.35rem;color:#666b66}
.sh-ai-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:1px;background:#d0cdc4}
.sh-ai-grid>div{padding:1.15rem;background:#f0ede5;min-height:170px;display:flex;flex-direction:column;justify-content:flex-end}
.sh-ai-grid b{font:600 2.1rem/.9 'Space Grotesk';letter-spacing:-.07em;color:#111827}
.sh-ai-grid span{font:8px/1.45 'DM Mono',monospace;color:#666b66;margin-top:.6rem;max-width:170px}
.sh-ai-grid i{display:block;height:4px;background:#2457ff;margin-top:1.2rem}
.sh-ai-feature{background:#e5e1d7!important}
.sh-ai-feature b{font-size:clamp(3rem,5vw,5rem)}
.sh-ai-panel .sh-panel-note{border-color:#d0cdc4;color:#666b66}
.sh-ai-panel .sh-panel-note b{color:#2457ff}
.sh-query-panel{background:#11151d}
.sh-query-table{padding:0 1.35rem}
.sh-query-row{display:grid;grid-template-columns:1fr 100px 120px;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid #303641;font:8px 'DM Mono',monospace;color:#d7dbe2}
.sh-query-row b{text-align:right;font:600 1rem 'Space Grotesk';color:#f0f2f5}
.sh-query-label{padding-top:1.2rem;color:#6f7989;font-size:7px;letter-spacing:.08em}
.sh-query-label b{font:7px 'DM Mono';color:#6f7989}
.sh-query-row em{font-style:normal;font-size:6px;letter-spacing:.08em;color:#7890ff;border:1px solid #35425e;padding:.25rem .35rem;margin-right:.5rem}
.sh-query-tags{display:flex;gap:.45rem;flex-wrap:wrap;padding:1rem 1.35rem}
.sh-query-tags span{font:7px 'DM Mono';letter-spacing:.08em;color:#7f8999;border:1px solid #343c4b;padding:.4rem .55rem}
.sh-visit-panel{background:#f0ede5;color:#151922}
.sh-visit-panel .sh-panel-head{border-color:#d0cdc4}
.sh-visit-panel .sh-panel-head span{color:#2457ff}
.sh-visit-panel .sh-panel-head h3{color:#151922}
.sh-visit-panel .sh-panel-head small{color:#666b66}
.sh-visit-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:1rem;padding:1.25rem}
.sh-visit-flow{display:grid;align-content:center;gap:.65rem;padding:1.25rem;background:#e6e2d8;border:1px solid #d0cdc4}
.sh-visit-flow div{padding:.8rem;background:#f3f0e9;border:1px solid #d0cdc4}
.sh-visit-flow span{display:block;font:7px 'DM Mono';color:#777c76;letter-spacing:.08em}
.sh-visit-flow b{display:block;margin-top:.3rem;font-size:1rem;letter-spacing:-.03em}
.sh-visit-flow i{text-align:center;font-style:normal;color:#2457ff}
.sh-ga4-slot{border:1px solid #c9c6bd;background:#fff;min-height:330px;display:flex;flex-direction:column}
.sh-slot-browser{display:flex;align-items:center;gap:.7rem;padding:.8rem 1rem;background:#11151d;color:#d9dde5;font:7px 'DM Mono';letter-spacing:.07em}
.sh-slot-browser span{color:#7890ff;letter-spacing:-.15em}
.sh-slot-browser small{margin-left:auto;color:#7e8795}
.sh-slot-body{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:2rem}
.sh-slot-body strong{font-size:1.8rem;letter-spacing:-.05em}
.sh-slot-body span{max-width:330px;margin-top:.6rem;font-size:.78rem;line-height:1.7;color:#686d67}
.sh-slot-body em{margin-top:1.2rem;padding:.55rem .7rem;background:#eef2f8;border-left:2px solid #2d72dc;font:7px 'DM Mono';font-style:normal;color:#555d68}
.sh-visit-panel .sh-panel-note{border-color:#d0cdc4;color:#666b66}
.sh-visit-panel .sh-panel-note b{color:#2457ff}
.sh-insight-panel{background:#0e1632}
.sh-insight-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:#30394e}
.sh-insight-grid article{min-height:210px;padding:1.2rem;background:#0e1632;display:flex;flex-direction:column}
.sh-insight-grid article>span{font:8px 'DM Mono';color:#7890ff}
.sh-insight-grid article>b{margin-top:auto;font:8px 'DM Mono';letter-spacing:.1em;color:#aeb6c4}
.sh-insight-grid article p{font-size:.78rem;line-height:1.65;color:#d4d8df;margin:.5rem 0 0}
@media(max-width:1000px){.sh-ai-grid{grid-template-columns:1fr 1fr}.sh-visit-grid{grid-template-columns:1fr}.sh-insight-grid{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.sh-evidence-intro,.sh-panel-head{display:block}.sh-evidence-intro>p{margin-top:1rem}.sh-gsc-comparison{grid-template-columns:1fr;gap:.6rem}.sh-gsc-arrow{transform:rotate(90deg);font-size:1.4rem}.sh-gsc-impressions{padding-top:0}.sh-ai-grid{grid-template-columns:1fr}.sh-query-row{grid-template-columns:1fr 70px 85px;gap:.5rem;font-size:7px}.sh-query-row em{display:inline-block;margin-bottom:.3rem}.sh-panel-head>small,.sh-panel-head>strong{display:block;margin-top:.8rem}.sh-insight-grid{grid-template-columns:1fr}.sh-panel-note{display:block}.sh-panel-note b{display:block;margin-bottom:.35rem}.sh-evidence-flow{gap:.35rem}.sh-evidence-flow i{display:none}}

/* Student Housing — premium evidence composition v3 */
.case3-page[data-case-study="student-housing"] .case3-evidence{background:#0b0f17;padding-top:8.5vw;padding-bottom:8.5vw}
.case3-page[data-case-study="student-housing"] .case3-evidence-head{margin-top:3.8rem;grid-template-columns:minmax(0,1.05fr) minmax(260px,.42fr);gap:7vw}
.case3-page[data-case-study="student-housing"] .case3-evidence-head h2{font-size:clamp(3.5rem,5.3vw,6.2rem);max-width:760px}
.sh-evidence-premium{margin-top:4.2rem;display:grid;gap:1px;background:#2c3442;border:1px solid #2c3442}
.sh-proof-intro{background:#0f141d;padding:1.5rem 1.6rem;display:grid;grid-template-columns:90px 1fr;gap:2rem;align-items:end}
.sh-proof-index{font:500 clamp(3.2rem,6vw,6rem)/.8 'Space Grotesk',sans-serif;letter-spacing:-.1em;color:#7890ff}
.sh-proof-copy{display:flex;justify-content:space-between;align-items:end;gap:3rem}
.sh-proof-copy>span,.sh-proof-topline{font:8px 'DM Mono',monospace;letter-spacing:.12em;color:#8f99aa;text-transform:uppercase}
.sh-proof-copy p{margin:0;max-width:520px;color:#aab2c0;font-size:.8rem;line-height:1.75}
.sh-proof-gsc{background:#f1eee7;color:#121722;padding:1.45rem 1.6rem 0}
.sh-proof-topline{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-bottom:1rem;border-bottom:1px solid #d2cec4;color:#2457ff}
.sh-proof-topline small{color:#747971;font:7px 'DM Mono',monospace;letter-spacing:.08em}
.sh-proof-gsc-main{display:grid;grid-template-columns:1fr .9fr 1fr;gap:2rem;align-items:end;padding:2.6rem 0 2rem}
.sh-proof-kpi small{font:8px 'DM Mono',monospace;letter-spacing:.1em;color:#6f746e}
.sh-proof-kpi div{display:flex;align-items:baseline;gap:.7rem;margin:.55rem 0 .35rem}
.sh-proof-kpi strong{font:600 clamp(4rem,7vw,7.3rem)/.8 'Space Grotesk',sans-serif;letter-spacing:-.1em}
.sh-proof-kpi em{font:600 .72rem 'DM Mono',monospace;color:#2457ff;font-style:normal}
.sh-proof-kpi>span{font:8px 'DM Mono',monospace;color:#777c75}
.sh-proof-kpi.secondary{text-align:right}.sh-proof-kpi.secondary div{justify-content:flex-end}
.sh-proof-spark{height:100px;display:flex;align-items:flex-end;gap:6px;padding:0 0 1px;border-bottom:1px solid #bfc0ba;position:relative}
.sh-proof-spark:before{content:'';position:absolute;left:0;right:0;bottom:33%;border-top:1px dashed #c9c7c0}
.sh-proof-spark i{display:block;flex:1;background:linear-gradient(to top,#2457ff,rgba(36,87,255,.08));height:var(--h,50%);clip-path:polygon(0 100%,0 55%,100% 25%,100% 100%)}
.sh-proof-spark i:nth-child(1){height:30%}.sh-proof-spark i:nth-child(2){height:35%}.sh-proof-spark i:nth-child(3){height:29%}.sh-proof-spark i:nth-child(4){height:42%}.sh-proof-spark i:nth-child(5){height:47%}.sh-proof-spark i:nth-child(6){height:44%}.sh-proof-spark i:nth-child(7){height:58%}.sh-proof-spark i:nth-child(8){height:62%}.sh-proof-spark i:nth-child(9){height:71%}.sh-proof-spark i:nth-child(10){height:86%}
.sh-proof-spark b{position:absolute;right:-3px;top:10%;width:7px;height:7px;background:#2457ff;border-radius:50%;box-shadow:0 0 0 5px rgba(36,87,255,.08)}
.sh-proof-foot{display:grid;grid-template-columns:130px 1fr;gap:1rem;border-top:1px solid #d2cec4;padding:1rem 0;font:8px/1.6 'DM Mono',monospace;color:#71766f}.sh-proof-foot span{color:#2457ff}.sh-proof-foot p{margin:0;max-width:650px}
.sh-proof-ai{background:#111827;color:#eef1f6;padding:1.45rem 1.6rem 1.6rem}.sh-proof-ai .sh-proof-topline{border-color:#2e394c;color:#8da6ff}.sh-proof-ai .sh-proof-topline small{color:#7f8999}
.sh-proof-ai-head{display:grid;grid-template-columns:.8fr 1fr;gap:3rem;align-items:end;padding:2.5rem 0 2rem}.sh-proof-ai-head>strong{font:600 clamp(5rem,9vw,9rem)/.75 'Space Grotesk',sans-serif;letter-spacing:-.11em;color:#fff}.sh-proof-ai-head div{max-width:430px}.sh-proof-ai-head span{font:8px 'DM Mono',monospace;color:#8da6ff;letter-spacing:.1em}.sh-proof-ai-head p{font-size:.85rem;line-height:1.7;color:#aab3c2;margin:.65rem 0 0}
.sh-proof-ai-list{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;border-top:1px solid #2e394c}.sh-proof-ai-list>div{padding:1.25rem 1rem 0;border-right:1px solid #2e394c;min-height:145px;display:flex;flex-direction:column;justify-content:flex-end}.sh-proof-ai-list>div:last-child{border-right:0}.sh-proof-ai-list b{font:600 2rem 'Space Grotesk';letter-spacing:-.07em}.sh-proof-ai-list .lead b{font-size:clamp(2.8rem,4vw,4.4rem)}.sh-proof-ai-list span{font:8px/1.5 'DM Mono';color:#aab3c2;margin-top:.45rem;max-width:180px}.sh-proof-ai-list i{display:block;height:3px;background:#7890ff;margin-top:1rem}
.sh-proof-queries{background:#f1eee7;color:#151a22;padding:1.45rem 1.6rem 1.6rem}.sh-proof-queries .sh-proof-topline{border-color:#d2cec4}.sh-query-intro{display:grid;grid-template-columns:1fr .5fr;gap:6vw;align-items:end;padding:2.5rem 0 1.7rem}.sh-query-intro h3{font-size:clamp(2.8rem,4vw,4.8rem);line-height:.9;letter-spacing:-.08em;margin:0}.sh-query-intro h3 em{font-family:Georgia,serif;font-weight:400;letter-spacing:-.05em}.sh-query-intro p{font-size:.8rem;line-height:1.75;color:#666b65;margin:0;max-width:360px}
.sh-query-premium-list{border-top:1px solid #c8c5bc}.sh-q-row{display:grid;grid-template-columns:1fr 100px 100px;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid #d2cec4;font:9px 'DM Mono',monospace}.sh-q-row b{text-align:right;font:600 1.15rem 'Space Grotesk';letter-spacing:-.04em}.sh-q-row em{font-style:normal;font-size:6px;letter-spacing:.09em;color:#2457ff;border:1px solid #aebde9;padding:.3rem .4rem;margin-right:.55rem}.sh-q-head{padding:.75rem 0;color:#7b8078;font-size:7px;letter-spacing:.1em}.sh-q-head b{font:7px 'DM Mono';color:#7b8078}
.sh-proof-ga4{background:#0f141d;color:#eef1f6;padding:1.45rem 1.6rem 1.6rem}.sh-proof-ga4 .sh-proof-topline{border-color:#2e394c}.sh-ga4-composition{display:grid;grid-template-columns:.72fr 1.28fr;gap:1.5rem;padding-top:1.5rem}.sh-ga4-copy{padding:1.2rem 0}.sh-ga4-kicker{font:8px 'DM Mono';letter-spacing:.1em;color:#8da6ff}.sh-ga4-copy h3{font-size:clamp(2.2rem,3.6vw,4rem);line-height:.92;letter-spacing:-.075em;margin:1rem 0 1rem}.sh-ga4-copy p{font-size:.82rem;line-height:1.75;color:#aab3c2;max-width:410px}.sh-ga4-statline{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:2rem;border-top:1px solid #2e394c;border-bottom:1px solid #2e394c}.sh-ga4-statline div{padding:.9rem 0}.sh-ga4-statline div+div{border-left:1px solid #2e394c;padding-left:.8rem}.sh-ga4-statline b{display:block;font:600 2rem 'Space Grotesk';letter-spacing:-.07em}.sh-ga4-statline span{font:7px 'DM Mono';color:#7f8999;letter-spacing:.08em}
.sh-ga4-frame{background:#f6f6f3;border:1px solid #394353;min-height:390px;box-shadow:0 24px 60px rgba(0,0,0,.22)}.sh-ga4-chrome{height:34px;display:flex;align-items:center;gap:.7rem;padding:0 .8rem;background:#111827;color:#aeb6c4;font:7px 'DM Mono';letter-spacing:.07em}.sh-ga4-chrome span{color:#7890ff;letter-spacing:-.15em}.sh-ga4-chrome small{margin-left:auto;color:#687385}.sh-ga4-placeholder{height:calc(100% - 34px);min-height:356px;display:grid;place-items:center;align-content:center;text-align:center;padding:2rem;color:#141a23}.sh-ga4-placeholder span{font:7px 'DM Mono';letter-spacing:.12em;color:#2457ff}.sh-ga4-placeholder strong{font:600 2rem 'Space Grotesk';letter-spacing:-.06em;margin-top:.5rem}.sh-ga4-placeholder p{font-size:.75rem;line-height:1.6;color:#70756f;max-width:320px;margin:.65rem auto 0}
.sh-proof-conclusion{background:#0b0f17;padding:2rem 1.6rem;display:grid;grid-template-columns:.9fr 1.1fr;gap:6vw;align-items:start}.sh-proof-conclusion>div:first-child>span{font:8px 'DM Mono';letter-spacing:.1em;color:#7890ff}.sh-proof-conclusion h3{font-size:clamp(2.5rem,4vw,4.6rem);line-height:.9;letter-spacing:-.08em;margin:1rem 0 0}.sh-proof-conclusion h3 em{font-family:Georgia,serif;font-weight:400}.sh-proof-findings{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#2c3442}.sh-proof-findings p{margin:0;padding:1rem;background:#0f141d;color:#aeb6c4;font-size:.76rem;line-height:1.65}.sh-proof-findings b{display:block;font:7px 'DM Mono';color:#7890ff;letter-spacing:.1em;margin-bottom:.45rem}
.case3-page[data-case-study="student-housing"] .case3-intervention-grid{border-top:1px solid #c6c3ba}.case3-page[data-case-study="student-housing"] .case3-intervention-grid article{background:transparent}.case3-page[data-case-study="student-housing"] .case3-intervention-grid article:hover{background:#efebe2}
@media(max-width:1000px){.sh-proof-copy,.sh-proof-gsc-main,.sh-proof-ai-head,.sh-query-intro,.sh-ga4-composition,.sh-proof-conclusion{grid-template-columns:1fr}.sh-proof-copy{display:block}.sh-proof-copy p{margin-top:1rem}.sh-proof-gsc-main{gap:1.5rem}.sh-proof-kpi.secondary{text-align:left}.sh-proof-kpi.secondary div{justify-content:flex-start}.sh-proof-ai-list{grid-template-columns:1fr 1fr}.sh-proof-ai-list>div:nth-child(2){border-right:0}.sh-proof-ai-list>div:nth-child(-n+2){border-bottom:1px solid #2e394c}.sh-proof-findings{margin-top:1rem}}
@media(max-width:620px){.case3-page[data-case-study="student-housing"] .case3-evidence-head h2{font-size:clamp(3rem,12vw,4.8rem)}.sh-proof-intro{grid-template-columns:55px 1fr;padding:1.1rem}.sh-proof-gsc,.sh-proof-ai,.sh-proof-queries,.sh-proof-ga4{padding:1rem}.sh-proof-gsc-main{padding:2rem 0 1.5rem}.sh-proof-kpi strong{font-size:4.4rem}.sh-proof-spark{height:75px}.sh-proof-ai-head>strong{font-size:6rem}.sh-proof-ai-list{grid-template-columns:1fr}.sh-proof-ai-list>div{border-right:0!important;border-bottom:1px solid #2e394c;min-height:115px}.sh-proof-ai-list>div:last-child{border-bottom:0}.sh-q-row{grid-template-columns:1fr 65px 65px;font-size:7px}.sh-q-row em{display:inline-block;margin-bottom:.25rem}.sh-ga4-statline{grid-template-columns:1fr 1fr}.sh-ga4-statline div:nth-child(3){grid-column:1/-1;border-left:0!important;border-top:1px solid #2e394c;padding-left:0}.sh-proof-findings{grid-template-columns:1fr}.sh-proof-conclusion{padding:1.2rem 1rem}}
